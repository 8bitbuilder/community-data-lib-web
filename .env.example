# Environment variables — copy to .env and fill in values for local use.
# .env is git-ignored. Never commit real secrets.
# What each variable does, and where to set it in production:
#   docs/technical/environment-variables.md

# ── Metadata editor (magic-link sign-in) ─────────────────────────────────────
# In production these are set in Netlify, not here. Locally they are only
# needed to test the editor with `netlify dev`.

# Required. Signs sign-in links and session cookies; at least 32 characters.
# Generate with: openssl rand -base64 48 (use a different value than production)
# AUTH_SECRET=

# Required. Comma-separated emails allowed to edit.
# EDITOR_EMAILS=you@example.org

# Required. Exact site origin, no trailing slash.
# SITE_ORIGIN=http://localhost:8888

# Needed to send sign-in emails (resend.com; the MAIL_FROM domain must be verified).
# RESEND_API_KEY=
# MAIL_FROM=CDL Editors <editors@your-domain.org>

# Needed to save edits. Fine-grained token: Contents + Pull requests read/write.
# GITHUB_TOKEN=
# Optional; defaults to community-data-libraries/backend. Use your fork for testing.
# GITHUB_REPO=your-username/backend

# ── Notifications ────────────────────────────────────────────────────────────
# Optional. Slack Incoming Webhook for resource-submission notifications.
# SLACK_WEBHOOK_URL=

# ── Local development ────────────────────────────────────────────────────────
# Path to the canonical backend repo (default: ../backend).
# BACKEND_ROOT=/absolute/path/to/backend
# BACKEND_SOURCES_DIR=/absolute/path/to/backend/data/sources

# Where the site fetches /api/* from. Leave unset to use the dev proxy locally
# and the preview-api function on Netlify. Visible in the browser — no secrets.
# PUBLIC_API_BASE_URL=http://localhost:4323

# Where `npm run dev` proxies /api/sources and /api/health (default below).
# BACKEND_DEV_URL=http://localhost:4323

# Local preview API mirror (npm run backend:dev).
# BACKEND_PORT=4323
# SOURCES_DB_PATH=/absolute/path/to/sources.sqlite
# PREVIEW_ENGINE=node
# PANDAS_TIMEOUT_MS=120000
