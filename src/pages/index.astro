---
import Layout from '@layouts/Layout.astro';
import { Picture } from 'astro:assets';
import { withBasePath } from '@lib/paths';
import heroCityscape from '../assets/home/hero-cityscape.png';

// Pointillist feature illustrations, drawn in the hero cityscape's palette
// (generated with a Python script; the Knox map uses Census TIGER/Line 2025 county outlines).
import artCatalog from '../assets/home/art-catalog.svg?url';
import artCommunity from '../assets/home/art-community.svg?url';
import artDotplot from '../assets/home/art-dotplot.svg?url';
---

<Layout
  title="Home"
  description="Discover curated data science resources and contribute to our growing community library of datasets, tools, guides, and research papers."
>
  <!-- ═══════════════════════════════════════════
       HERO — centered copy, full-bleed illustration below
  ═══════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <br />
      <h1 class="hero-title" id="hero-title">Community Data Libraries</h1>
      <!-- Two stacked copies: the gridded font in yellow underneath, the plain font in teal on top
           (the two fonts share metrics, so the letters land exactly on the grid). -->
      <p class="hero-kicker">
        <span class="hero-kicker-grid" aria-hidden="true">&nbsp;&nbsp;&nbsp;Data about your community, for your community&nbsp;&nbsp;&nbsp;</span>
        <span class="hero-kicker-text">&nbsp;&nbsp;&nbsp;Data about your community, for your community&nbsp;&nbsp;&nbsp;</span>
      </p>
      <p class="hero-body">
        A free, open-source tool to locate and explore data about the U.S. community near you.
      </p>
      <div class="hero-actions">
        <a href={withBasePath('/complete-catalog')} class="btn btn-primary btn-large">
          Explore the data catalog
        </a>
        <a href={withBasePath('/create-community-library')} class="btn btn-secondary btn-large">
          Build a community library
        </a>
      </div>
    </div>
    <br />
    <br />
    <div class="hero-art">
      <div class="hero-art-frame">
        <Picture
          src={heroCityscape}
          formats={['avif', 'webp']}
          widths={[800, 1400, 2172]}
          sizes="100vw"
          alt="Illustration of a town drawn in dots (houses, a school, trees and people walking) linked overhead by a network of data points."
          loading="eager"
          fetchpriority="high"
        />
        <!-- Animated glow laid over the sun in the illustration -->
        <span class="sun-glow" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       FEATURE ROWS — alternating text / visual
  ═══════════════════════════════════════════ -->
  <section class="features" aria-label="What you can do">
    <!-- 1. Complete Catalog -->
    <article class="feature">
      <div class="feature-text">
        <p class="feature-eyebrow">Complete Catalog</p>
        <h2 class="feature-title">View all available datasets.</h2>
        <p>
          The Complete Catalog is the list of all datasets we have in our master library so far (and
          that are used to populate the local community data libraries). Are we missing a great one?
          <a href={withBasePath('/submit')}>Suggest it</a>.
        </p>
        <a class="btn btn-secondary feature-link" href={withBasePath('/complete-catalog')}
          >Browse the complete catalog</a
        >
      </div>
      <div class="feature-visual">
        <img
          class="dot-art"
          src={artCatalog}
          alt="A tall bookshelf full of books, drawn in dots"
          width="480"
          height="370"
          loading="lazy"
          decoding="async"
        />
      </div>
    </article>

    <!-- 2. Community Library -->
    <article class="feature feature-flip">
      <div class="feature-text">
        <p class="feature-eyebrow">Community Data Libraries</p>
        <h2 class="feature-title">Create a data library for your community.</h2>
        <p>
          Use our tools to quickly create a community data library (CDL) for your community. Your
          CDL will show only datasets with data about your community. To build your CDL, simply
          <a href={withBasePath('/create-community-library')}>fill out our form</a>.
        </p>
        <a class="btn btn-secondary feature-link" href={withBasePath('/communities/knox-county/')}
          >See an example library (Knoxville, TN)</a
        >
      </div>
      <div class="feature-visual">
        <img
          class="dot-art"
          src={artCommunity}
          alt="Dot-density map of Knox County, Tennessee, and its eight neighboring counties, linked by a network"
          width="480"
          height="330"
          loading="lazy"
          decoding="async"
        />
      </div>
    </article>

    <!-- 3. Statistical tags for K-12 data science (Data Resources secondary) -->
    <article class="feature">
      <div class="feature-text">
        <p class="feature-eyebrow">K-12 Data Science & Statistics Tags</p>
        <h2 class="feature-title">Find data for the content you're teaching.</h2>
        <p>
          Datasets are tagged with the K-12 statistical and data science content their variables can
          support, from distributional characteristics, to significance testing, and more. We
          provide these in "Teacher View" to make lesson planning easier, but they are still in
          beta.
          <!-- address assembled by the script in Layout.astro on interaction; not in the page source -->
          Please
          <a href="#" class="js-email" data-u="ofni" data-d="gro.seirarbilatadytinummoc"
            >provide suggestions</a
          > for their improvement!
        </p>
        <!-- <p class="feature-note">
          Our team also shares lesson plans and workshop materials in
          <a href={withBasePath('/data-resources')}>Data Resources</a>.
        </p> -->
        <a
          class="btn btn-secondary feature-link"
          href={withBasePath('communities/knox-county/catalog/?audience=teacher')}
          >See K-12 tags in an example CDL</a
        >
      </div>
      <div class="feature-visual">
        <!-- Callouts use real pedagogical tags from the catalog ("has mode", "right skewed
             distribution", "contains outliers", "mean median different"), reworded for display.
             Positions match the leader-line ends drawn in art-dotplot.svg (% of its viewBox). -->
        <figure class="plot-figure">
          <img
            class="dot-art"
            src={artDotplot}
            alt="A dot plot of a right-skewed distribution with a dotted density curve, and markers at the mean and median"
            width="480"
            height="360"
            loading="lazy"
            decoding="async"
          />
          <span class="chip plot-tag tag-left" style="left: 25.3%; top: 9.7%">Has a mode</span>
          <span class="chip plot-tag tag-above" style="left: 75.4%; top: 41.1%"
            >Right-skewed distribution</span
          >
          <span class="chip chip-gold plot-tag tag-above" style="left: 81.9%; top: 55%"
            >Contains outliers</span
          >
          <span class="chip chip-blue plot-tag tag-left" style="left: 31.8%; top: 90%"
            >Mean ≠ median</span
          >
        </figure>
      </div>
    </article>
  </section>

  <!-- ═══════════════════════════════════════════
       CONTRIBUTE CTA BANNER
  ═══════════════════════════════════════════ -->
  <section class="cta-banner" aria-labelledby="cta-heading">
    <div class="cta-text">
      <h2 class="cta-title" id="cta-heading">Know an open dataset containing community data?</h2>
      <p class="cta-body">
        Help expand the catalog by sharing datasets openly available on the web. The datasets should
        include a geographic variable at the state-level or smaller. All submissions are reviewed
        before addition to our catalog.
      </p>
    </div>
    <div class="cta-actions">
      <a href={withBasePath('/submit')} class="btn btn-primary btn-large">Suggest a dataset</a>
    </div>
  </section>
</Layout>

<style>
  /* The hero art bleeds to the window edges; keep that from adding a sideways scrollbar. */
  :global(body) {
    overflow-x: clip;
  }

  /* ══════════════════════════════════════════════
     HERO
  ══════════════════════════════════════════════ */
  .hero {
    padding-top: var(--space-6);
    margin-bottom: var(--space-4);
  }

  /* Big screens (taller and wider than a laptop): stretch the hero to roughly the window
     height and center its content, adding space above and below so the first feature row
     starts just below the fold (only a ~40px sliver of its band peeks up).
     162px ≈ nav (76) + main top padding (32) + hero bottom margin (16) + the 40px peek. */
  @media (min-width: 1280px) and (min-height: 900px) {
    .hero {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: calc(100svh - 162px);
    }
  }

  .hero-copy {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
    /* Sit above the illustration, which slides up underneath the buttons. */
    position: relative;
    z-index: 1;
  }

  .hero-kicker {
    display: grid;
    margin: 0;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 400;
    line-height: 1.3;
    text-wrap: balance;
  }

  /* Both layers fill the same grid cell, so they sit exactly on top of each other. */
  .hero-kicker > span {
    grid-area: 1 / 1;
  }

  .hero-kicker-grid {
    font-family: 'Micro 5 Charted', var(--font-mono);
    color: #D4A017; /* gridlines: brand mustard */
  }

  .hero-kicker-text {
    font-family: 'Micro 5', var(--font-mono);
    color: #25808f; /* darkened from #3EA8BC to meet WCAG AA contrast (4.6:1) */
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    /* vh term keeps the title from eating short laptop screens */
    font-size: clamp(2.6rem, min(6.5vw, 8.5vh), 4.75rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--color-text);
    text-wrap: balance;
  }

  .hero-body {
    margin: 0;
    max-width: 44ch;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: var(--line-height-normal);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  /* Full-bleed: break out of <main>'s 1200px column. */
  .hero-art {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    /* Pull the art up so its empty sky (network lines, sun) tucks behind the buttons
       and the town is visible without scrolling on laptop screens. */
    margin-top: calc(-1 * min(10vw, 217px));
  }

  .hero-art-frame {
    position: relative;
    max-width: 2172px;
    margin: 0 auto;
  }

  .hero-art :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ── Sun animation ──────────────────────────
     Positions are % of the illustration, so they track the sun at any width.
     Sun disc center in the 2172×724 source ≈ (1555, 195). */
  .sun-glow {
    position: absolute;
    pointer-events: none;
    translate: -50% -50%;
    left: 71.6%;
    top: 27%;
    width: 17%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(255, 196, 60, 0.75) 0%,
      rgba(255, 196, 60, 0.35) 38%,
      rgba(255, 196, 60, 0) 70%
    );
    mix-blend-mode: multiply;
    animation: sunPulse 4s ease-in-out infinite;
  }

  @keyframes sunPulse {
    0%,
    100% {
      scale: 0.8;
      opacity: 0.35;
    }
    50% {
      scale: 1.15;
      opacity: 1;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 3.25rem;
    }
    /* Drop the spacer <br>s on phones so the illustration lands above the fold. */
    .hero > br,
    .hero-copy > br {
      display: none;
    }
    .hero-art {
      margin-top: var(--space-4);
    }
    .hero-actions {
      flex-direction: column;
      align-self: stretch;
    }
    /* A 3:1 strip gets tiny on phones; crop to the middle of the town instead. */
    .hero-art :global(img) {
      height: 210px;
      object-fit: cover;
      object-position: 50% 60%;
    }
    /* The phone crop moves the sun, so skip the overlay there. */
    .sun-glow {
      display: none;
    }
  }

  /* ══════════════════════════════════════════════
     BUTTONS
  ══════════════════════════════════════════════ */
  /* Near-square corners, a soft navy offset shadow, solid fills.
     Hover presses the button down into its shadow. */
  .btn {
    --btn-shadow: rgba(35, 53, 75, 0.32); /* soft navy */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    border: 2px solid transparent;
    border-radius: 3px;
    box-shadow: 3px 4px 8px var(--btn-shadow);
    font-size: var(--font-size-sm);
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease,
      background-color 0.18s ease,
      color 0.18s ease;
  }

  .btn:hover {
    text-decoration: none;
    transform: translate(1px, 2px);
    box-shadow: 2px 2px 4px var(--btn-shadow);
  }

  .btn:active {
    transform: translate(2px, 3px);
    box-shadow: 0 0 1px var(--btn-shadow);
  }

  .btn-primary {
    background: var(--color-primary);
    color: #fff;
  }

  .btn-primary:hover {
    background: #0b6358;
    color: #fff;
  }

  .btn-secondary {
    /* faint grid-paper lines (echoing the gridded slogan font) on very light teal */
    background:
      linear-gradient(rgba(62, 168, 188, 0.09) 1px, transparent 1px) border-box,
      linear-gradient(90deg, rgba(62, 168, 188, 0.09) 1px, transparent 1px) border-box,
      #eef8f8 border-box;
    background-size:
      6px 6px,
      6px 6px;
    border: 2px solid transparent;
    color: #23354b;
  }

  .btn-secondary:hover {
    color: var(--color-primary);
  }

  .btn-primary:focus-visible,
  .btn-secondary:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .btn-large {
    padding: var(--space-4) var(--space-8);
    font-size: var(--font-size-base);
  }

  /* ══════════════════════════════════════════════
     FEATURE ROWS
  ══════════════════════════════════════════════ */
  /* Each row is a full-width band (like joinmastodon.org): tinted, white, tinted…
     The band is a pseudo-element that bleeds past <main>'s 1200px column. */
  .features {
    display: grid;
    isolation: isolate;
  }

  .feature {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
    padding-block: var(--space-24);
  }

  .feature::before,
  .cta-banner::before {
    content: '';
    position: absolute;
    inset: 0 calc(50% - 50vw);
    z-index: -1;
    background: var(--band-bg, transparent);
  }

  /* Pastel speckles (the Knoxville map's palette) over the contribute band, faded out
     behind the text so it stays clean. */
  .cta-banner::after {
    content: '';
    position: absolute;
    inset: 0 calc(50% - 50vw);
    z-index: -1;
    background: url('../assets/home/speckle-tile.svg') 0 0 / 260px 260px repeat;
    opacity: 1;
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, transparent 35%, #000 100%);
    mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, transparent 35%, #000 100%);
    pointer-events: none;
  }

  .feature:nth-child(odd) {
    --band-bg: #f4f8f7;
  }

  @media (max-width: 640px) {
    .feature {
      padding-block: var(--space-12);
    }
  }

  @media (min-width: 900px) {
    .feature {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: var(--space-16);
    }
    .feature-flip .feature-text {
      order: 2;
    }
    .feature-flip .feature-visual {
      order: 1;
    }
  }

  .feature-text {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: 48ch;
  }

  /* Same gridded pixel font as the hero tagline. No letter-spacing, so the grid
     drawn inside the glyphs stays continuous; a padding space on each side
     extends the grid past the text, like the tagline's &nbsp;s. */
  .feature-eyebrow,
  .feature-text .feature-eyebrow {
    margin: 0;
    font-family: 'Micro 5 Charted', var(--font-mono);
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-primary); /* dark teal #0E7265 */
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .feature-eyebrow::before,
  .feature-eyebrow::after {
    content: '\00a0';
  }

  .feature-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .feature-text p {
    margin: 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  /* Pill-shaped light-teal button (builds on .btn-secondary, minus the grid paper). */
  .feature-link {
    background: #eef8f8; /* solid light teal, no grid lines */
    border-radius: 999px;
    margin-top: var(--space-2);
    padding: var(--space-3) var(--space-6);
    /* long labels wrap on narrow phones instead of overflowing */
    white-space: normal;
    text-align: center;
  }

  .feature-visual {
    position: relative;
  }

  .dot-art {
    display: block;
    width: 100%;
    max-width: 480px;
    height: auto;
    margin: 0 auto;
  }

  /* Dot plot with tag callouts laid over the leader-line ends */
  .plot-figure {
    position: relative;
    max-width: 480px;
    margin: 0 auto;
  }

  /* Chart labels: soft tinted pills in Barlow Semi Condensed, sentence case, no border or shadow.
     Tint is layered on white so the leader lines don't show through. */
  .plot-figure .plot-tag {
    position: absolute;
    padding: 3px 11px;
    border: 0;
    border-radius: 999px;
    background-color: #fff;
    background-image: linear-gradient(
      var(--tag-tint, var(--color-primary-glow)),
      var(--tag-tint, var(--color-primary-glow))
    );
    font-family: var(--font-tag);
    font-weight: 400;
    font-size: 0.95rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .plot-figure .plot-tag.chip-gold {
    --tag-tint: rgba(212, 160, 23, 0.16);
  }

  .plot-figure .plot-tag.chip-blue {
    --tag-tint: rgba(62, 168, 188, 0.15);
  }

  .tag-left {
    translate: calc(-100% - 2px) -50%;
  }

  .tag-above {
    translate: -50% calc(-100% - 2px);
  }

  /* ── Shared mock card pieces ─────────────── */
  .mock-card {
    background: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 18px 40px -22px rgba(14, 114, 101, 0.35);
    overflow: hidden;
    font-size: 0.8rem;
  }

  .mock-foot {
    border-top: 1px solid var(--color-border);
  }

  .mock-foot,
  .map-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
  }

  /* Plain, readable labels: sentence case in the body font, small corner radius (like the buttons) */
  .chip {
    display: inline-block;
    padding: 3px 9px;
    border-radius: 4px;
    background: var(--color-primary-glow);
    color: var(--color-primary);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.35;
    white-space: nowrap;
  }

  .mock-more {
    margin-left: auto;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    color: var(--color-text-dim);
  }

  /* ── Complete Catalog mock: list of datasets ── */
  .lib-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border-bottom: 1.5px solid var(--color-border);
  }

  .lib-head strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .lib-head span:not(.lib-pin) {
    font-size: 0.72rem;
    color: var(--color-text-dim);
  }

  .lib-pin {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    flex-shrink: 0;
  }

  .lib-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lib-list li {
    display: grid;
    gap: 4px;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .lib-list li:last-child {
    border-bottom: none;
  }

  .lib-title {
    font-weight: 700;
    color: var(--color-text);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .lib-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.72rem;
    color: var(--color-text-dim);
  }

  /* Keep the catalog card compact and centred in its (wider) column. */
  .catalog-card {
    max-width: 440px;
    margin: 0 auto;
  }

  .cat-search {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-3) var(--space-4);
    padding: 7px 12px;
    border: 1.5px solid var(--color-border);
    border-radius: 999px;
    background: #f7faf9;
    color: var(--color-text-dim);
    font-size: 0.74rem;
  }

  .cat-search svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .catalog-card .lib-list {
    border-top: 1px solid var(--color-border);
  }

  /* Topic chips in the site's accent colours */
  .chip-gold {
    background: rgba(212, 160, 23, 0.16);
    color: #8a6a0c;
  }
  .chip-green {
    background: var(--color-accent-glow);
    color: var(--color-accent);
  }
  .chip-blue {
    background: rgba(62, 168, 188, 0.15);
    color: #1f6f80;
  }

  /* ── Community Library mock: map of the selected community ── */
  .map-svg {
    display: block;
    width: 100%;
    height: auto;
    background: #fafcfb;
  }

  .county path {
    fill: #e6efec;
    stroke: #fff;
    stroke-width: 3;
    stroke-linejoin: round;
  }

  .county-active {
    fill: rgba(14, 114, 101, 0.22);
    stroke: var(--color-primary);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }

