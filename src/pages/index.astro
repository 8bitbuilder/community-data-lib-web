---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import submissions from '@data/community-submissions.json';
import { withBasePath } from '@lib/paths';

const catalogResources = await getCollection('master-library');
const datasetCount = catalogResources.filter((entry) => entry.data.category === 'dataset').length;
const communityResourceCount = submissions.length;
const regionCount = new Set(submissions.map((entry) => entry.region)).size;
---

<Layout
  title="Home"
  description="Discover curated data science resources and contribute to our growing community library of datasets, tools, guides, and research papers."
>
  <!-- ═══════════════════════════════════════════
       HERO — asymmetric split, generous breathing room
  ═══════════════════════════════════════════ -->
  <section class="hero" aria-label="Introduction">
    <div class="hero-text">
      <div class="hero-kicker">
        <span class="kicker-dot"></span>
        Open-Source · Community-Focused · Free Forever
      </div>

      <h1 class="hero-title">Community Data Libraries</h1>

      <div class="hero-rule" aria-hidden="true"></div>

      <p class="hero-body">
        Community Data Libraries is an open-source resource to explore and locate
        datasets for a specific region or community near you.
      </p>
    </div>

    <!-- Hero visual — abstract data grid -->
    <div class="hero-visual" aria-hidden="true">
      <div class="viz-glow"></div>
      <div class="viz-card">
        <div class="viz-header">
          <span class="viz-dot r"></span>
          <span class="viz-dot y"></span>
          <span class="viz-dot g"></span>
          <span class="viz-label">census-acs-demographics.csv</span>
        </div>
        <div class="viz-table">
          <div class="vt-head">
            <span>county_fips</span><span>population</span><span>median_income</span><span>category</span>
          </div>
          {[
            ['17031', '5,275,541', '$62,088', 'Cook, IL'],
            ['06037', '9,829,544', '$71,358', 'Los Angeles, CA'],
            ['48201', '4,728,030', '$60,154', 'Harris, TX'],
            ['04013', '4,420,568', '$66,422', 'Maricopa, AZ'],
            ['06073', '3,338,330', '$79,506', 'San Diego, CA'],
            ['06059', '3,175,692', '$83,044', 'Orange, CA'],
          ].map(([fips, pop, income, name]) => (
            <div class="vt-row">
              <span class="mono">{fips}</span>
              <span class="mono">{pop}</span>
              <span class="mono">{income}</span>
              <span>{name}</span>
            </div>
          ))}
        </div>
        <div class="viz-footer">
          <span class="viz-tag">dataset</span>
          <span class="viz-tag">beginner</span>
          <span class="viz-tag">demographics</span>
          <span class="viz-more">+3,142 rows</span>
        </div>
      </div>

      <!-- Floating stat badges -->
      <div class="badge badge-1">
        <strong>{datasetCount}</strong>
        <span>Curated datasets</span>
      </div>
      <div class="badge badge-2">
        <span>Any</span>
        <strong>U.S.</strong>
        <span>Community</span>
      </div>
    </div>
  </section>

  <div class="section-divider" aria-hidden="true"></div>

  <!-- ═══════════════════════════════════════════
       DIRECTORY — numbered editorial cards
  ═══════════════════════════════════════════ -->
  <section class="directory-section" aria-labelledby="directory-heading">
    <header class="section-header">
      <p class="section-eyebrow">Explore the platform</p>
      <h2 class="section-title" id="directory-heading">
        Find the right place to start.
      </h2>
    </header>

    <div class="directory-grid">
      <article class="directory-card dc-1">
        <div class="directory-head">
          <h3 class="directory-title">
            <a href={withBasePath('/complete-catalog')}>Complete Catalog</a>
          </h3>
          <span class="directory-index" aria-hidden="true">01</span>
        </div>
        <p>
          New to the platform? Start with the Complete Catalog. This is the master
          collection of all datasets available across the platform, giving you
          access to the full range of information that has been added to the
          system.
        </p>
      </article>

      <article class="directory-card dc-2">
        <div class="directory-head">
          <h3 class="directory-title">
            <a href={withBasePath('/create-community-library')}>Community Library</a>
          </h3>
          <span class="directory-index" aria-hidden="true">02</span>
        </div>
        <p>
          Need data for a specific area? Create your own Community Library to
          generate a curated collection of datasets tailored to a selected
          community or region. Built from the Complete Catalog, it automatically
          includes only datasets with information relevant to that area, making it
          easier to discover local data and insights without searching through
          the entire collection. You can view an example community library
          <a href={withBasePath('/communities/knox-county/')}>here</a>.
        </p>
      </article>

      <article class="directory-card dc-3">
        <div class="directory-head">
          <h3 class="directory-title">
            <a href={withBasePath('/data-resources')}>Data Resources</a>
          </h3>
          <span class="directory-index" aria-hidden="true">03</span>
        </div>
        <p>
          The Data Resources section contains open-source educational and
          community engagement materials developed by our team. These resources
          are intended to support the use of the Community Data Library (CDL) in
          a variety of settings, including classrooms and community workshops.
          Planned resources include lesson plans, guided activities, and other
          tools designed to help users explore, analyze, and discuss community
          data.
        </p>
      </article>

      <article class="directory-card dc-4">
        <div class="directory-head">
          <h3 class="directory-title">
            <a href={withBasePath('/maps')}>Interactive Map</a>
          </h3>
          <span class="directory-index" aria-hidden="true">04</span>
        </div>
        <p>
          The Interactive Map provides an overview of the data available for
          communities across the region before a user creates a Community Data
          Library. Just place a pin on the map at the location of interest and
          the system will then identify the surrounding community and display a
          filtered catalog containing datasets relevant to that area. By
          exploring the map, you can quickly determine what information is
          currently available for a particular location.
        </p>
      </article>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CONTRIBUTE CTA BANNER
  ═══════════════════════════════════════════ -->
  <section class="cta-banner" aria-label="Contribute">
    <div class="cta-text">
      <p class="cta-eyebrow">Community-Driven Catalog</p>
      <h2 class="cta-title">Know an open dataset containing community data?</h2>
      <p class="cta-body">Help expand the dataset catalog by sharing datasets openly available on the web. All submissions are reviewed before publication.</p>
    </div>
    <div class="cta-actions">
      <a href={withBasePath('/submit')} class="btn-primary btn-large">Submit a Resource →</a>
      <a href="https://github.com/community-data-libraries/web" target="_blank" rel="noopener noreferrer" class="cta-github">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
        View us on GitHub
      </a>
    </div>
  </section>

</Layout>

<style>
  /* ══════════════════════════════════════════════
     HERO
  ══════════════════════════════════════════════ */
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    padding: var(--space-16) 0 var(--space-16);
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: var(--space-16);
      padding: var(--space-16) 0 var(--space-20, var(--space-16));
      min-height: 600px;
    }
  }

  /* ── Text side ───────────────────────────── */
  .hero-text {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
    animation: fadeUp 0.7s ease both;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 500;
    color: var(--color-primary);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .kicker-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-primary);
    flex-shrink: 0;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%  { opacity: 0.5; transform: scale(0.75); }
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 4.5rem);
    font-weight: 900;
    line-height: 1.0;
    letter-spacing: -0.04em;
    color: var(--color-text);
    margin: 0;
    max-width: 14ch;
  }

  .hero-rule {
    width: 96px;
    height: 4px;
    border-radius: 999px;
    background: var(--color-primary);
    opacity: 0.85;
  }

  .hero-body {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    line-height: var(--line-height-relaxed);
    margin: 0;
    max-width: 46ch;
  }

  /* ── Visual side ──────────────────────────── */
  .hero-visual {
    position: relative;
    isolation: isolate;
    animation: fadeUp 0.7s 0.15s ease both;
  }

  /* Soft halo behind the CSV card */
  .viz-glow {
    position: absolute;
    inset: -12% -8%;
    z-index: -1;
    border-radius: 50%;
    background: var(--color-primary-glow);
    filter: blur(44px);
    opacity: 0.75;
    pointer-events: none;
  }

  .viz-card {
    background: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .hero-visual:hover .viz-card {
    transform: translateY(-4px);
    box-shadow: 0 24px 60px -18px rgba(15, 118, 110, 0.25);
  }

  .viz-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface-raised);
    border-bottom: 1.5px solid var(--color-border);
  }

  .viz-dot {
    width: 9px; height: 9px;
    border-radius: 50%;
    display: block;
    flex-shrink: 0;
  }

  .viz-dot.r { background: #E57373; }
  .viz-dot.y { background: #FFB74D; }
  .viz-dot.g { background: #81C784; }

  .viz-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-dim);
    margin-left: var(--space-2);
  }

  .viz-table { padding: 0; }

  .vt-head {
    display: grid;
    grid-template-columns: 80px 100px 120px 1fr;
    gap: 0;
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface-raised);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-primary);
    font-weight: 500;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .vt-row {
    display: grid;
    grid-template-columns: 80px 100px 120px 1fr;
    gap: 0;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.68rem;
    transition: background 0.12s ease;
  }

  .vt-row:last-child { border-bottom: none; }
  .vt-row:hover { background: var(--color-primary-glow); }

  .vt-row .mono { color: var(--color-text); }

  .viz-footer {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface-raised);
    border-top: 1.5px solid var(--color-border);
    flex-wrap: wrap;
  }

  .viz-tag {
    padding: 3px 9px;
    background: var(--color-primary-glow);
    border: 1px solid rgba(15, 118, 110, 0.2);
    border-radius: var(--radius-sm);
    font-size: 0.62rem;
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .viz-more {
    margin-left: auto;
    font-size: 0.65rem;
    color: var(--color-text-dim);
  }

  /* Floating badges */
  .badge {
    position: absolute;
    background: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-3) var(--space-5);
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: 2px;
    animation: float 4s ease-in-out infinite;
  }

  .badge strong {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 900;
    color: var(--color-primary);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .badge span {
    font-size: 0.65rem;
    color: var(--color-text-dim);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .badge-1 {
    bottom: -28px;
    left: -28px;
    animation-delay: 0s;
  }

  .badge-2 {
    top: -28px;
    right: -24px;
    animation-delay: 1.5s;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  @media (max-width: 1100px) {
    .badge-1 { left: -8px; }
    .badge-2 { right: -8px; }
  }

  @media (max-width: 899px) {
    .badge { display: none; }
  }

  /* ══════════════════════════════════════════════
     SECTION DIVIDER
  ══════════════════════════════════════════════ */
  .section-divider {
    height: 1.5px;
    background: var(--color-border);
    border: 0;
    margin: 0 0 var(--space-16);
    opacity: 0.9;
  }

  /* ══════════════════════════════════════════════
     SECTION HEADER
  ══════════════════════════════════════════════ */
  .section-header {
    margin-bottom: var(--space-12);
    max-width: 38ch;
  }

  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 var(--space-3);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(var(--font-size-3xl), 4vw, 3rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin: 0;
  }

  /* ══════════════════════════════════════════════
     DIRECTORY CARDS
  ══════════════════════════════════════════════ */
  .directory-section {
    margin-bottom: var(--space-16);
  }

  .directory-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .directory-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }

  @media (min-width: 1100px) {
    .directory-grid { gap: var(--space-8); }
  }

  .directory-card {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-4);
    padding: var(--space-8);
    background: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  /* Top accent band, revealed on hover */
  .directory-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.28s ease;
  }

  .dc-1::before { background: var(--color-primary); }
  .dc-2::before { background: var(--color-secondary); }
  .dc-3::before { background: var(--color-accent); }
  .dc-4::before { background: var(--color-primary); }

  .directory-card:hover,
  .directory-card:focus-within {
    transform: translateY(-4px);
    box-shadow: 0 16px 44px -14px rgba(15, 118, 110, 0.18);
    border-color: rgba(15, 118, 110, 0.3);
  }

  .directory-card:hover::before,
  .directory-card:focus-within::before {
    transform: scaleX(1);
  }

  /* Title + number share a baseline-aligned row */
  .directory-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .directory-index {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text-dim);
    letter-spacing: 0.1em;
    line-height: 1;
  }

  .directory-card p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    max-width: 60ch;
  }

  .directory-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-size-2xl);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.03em;
  }

  .directory-title a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .directory-title a::after {
    content: "→";
    color: var(--color-primary);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .directory-title a:hover,
  .directory-title a:focus-visible {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .directory-title a:hover::after,
  .directory-title a:focus-visible::after {
    opacity: 1;
    transform: translateX(0);
  }

  .directory-title a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* ══════════════════════════════════════════════
     CTA BANNER
  ══════════════════════════════════════════════ */
  .cta-banner {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: var(--space-10);
    padding: var(--space-12) var(--space-10);
    background: var(--color-surface-raised);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-xl);
    position: relative;
    overflow: hidden;
    margin-bottom: var(--space-16);
  }

  @media (min-width: 900px) {
    .cta-banner {
      grid-template-columns: minmax(0, 1.4fr) auto;
      padding: var(--space-16);
      gap: var(--space-16);
    }
  }

  .cta-text {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-3);
  }

  .cta-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0;
  }

  .cta-title {
    font-family: var(--font-display);
    font-size: var(--font-size-3xl);
    font-weight: 900;
    color: var(--color-text);
    margin: 0;
    line-height: 1.15;
    letter-spacing: -0.03em;
    max-width: 24ch;
  }

  .cta-body {
    margin: 0;
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    line-height: var(--line-height-relaxed);
    max-width: 48ch;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    align-items: stretch;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background: var(--color-secondary);
    color: #F8FAFC;
    border: 1.5px solid var(--color-secondary);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: all 0.18s ease;
    cursor: pointer;
    white-space: nowrap;
  }

  .btn-primary:hover {
    background: #0F4A5E;
    border-color: #0F4A5E;
    box-shadow: var(--shadow-glow-secondary);
    transform: translateY(-1px);
    text-decoration: none;
    color: #F8FAFC;
  }

  .btn-large {
    padding: var(--space-4) var(--space-8);
    font-size: var(--font-size-base);
  }

  .cta-github {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    background: transparent;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: all 0.18s ease;
  }

  .cta-github:hover {
