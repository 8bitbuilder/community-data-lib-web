</Layout>

<style>
  /* The hero art bleeds to the window edges; keep that from adding a sideways scrollbar. */
  :global(body) {
    overflow-x: clip;
  }

  /* ══════════════════════════════════════════════
     HERO
  ══════════════════════════════════════════════ */
  .hero {
    padding-top: var(--space-6);
    margin-bottom: var(--space-4);
  }

  .hero-copy {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
    /* Sit above the illustration, which slides up underneath the buttons. */
    position: relative;
    z-index: 1;
    animation: fadeUp 0.7s ease both;
  }

  .hero-kicker {
    margin: 0;
    font-family: 'Micro 5 Charted', var(--font-mono);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 400;
    line-height: 1.3;
    color: #25808f; /* darkened from #3EA8BC to meet WCAG AA contrast (4.6:1) */
    text-wrap: balance;
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    /* vh term keeps the title from eating short laptop screens */
    font-size: clamp(2.6rem, min(6.5vw, 8.5vh), 4.75rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--color-text);
    text-wrap: balance;
  }

  .hero-body {
    margin: 0;
    max-width: 44ch;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: var(--line-height-normal);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  /* Full-bleed: break out of <main>'s 1200px column. */
  .hero-art {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    /* Pull the art up so its empty sky (network lines, sun) tucks behind the buttons
       and the town is visible without scrolling on laptop screens. */
    margin-top: calc(-1 * min(10vw, 217px));
    animation: fadeUp 0.7s 0.15s ease both;
  }

  .hero-art-frame {
    position: relative;
    max-width: 2172px;
    margin: 0 auto;
  }

  .hero-art :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ── Sun animation ──────────────────────────
     Positions are % of the illustration, so they track the sun at any width.
     Sun disc center in the 2172×724 source ≈ (1555, 195). */
  .sun-glow {
    position: absolute;
    pointer-events: none;
    translate: -50% -50%;
    left: 71.6%;
    top: 27%;
    width: 17%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(255, 196, 60, 0.75) 0%,
      rgba(255, 196, 60, 0.35) 38%,
      rgba(255, 196, 60, 0) 70%
    );
    mix-blend-mode: multiply;
    animation: sunPulse 4s ease-in-out infinite;
  }

  @keyframes sunPulse {
    0%,
    100% {
      scale: 0.8;
      opacity: 0.35;
    }
    50% {
      scale: 1.15;
      opacity: 1;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: var(--space-4);
    }
    .hero-art {
      margin-top: var(--space-6);
    }
    .hero-actions {
      flex-direction: column;
      align-self: stretch;
    }
    /* A 3:1 strip gets tiny on phones; crop to the middle of the town instead. */
    .hero-art :global(img) {
      height: 210px;
      object-fit: cover;
      object-position: 50% 60%;
    }
    /* The phone crop moves the sun, so skip the overlay there. */
    .sun-glow {
      display: none;
    }
  }

  /* ══════════════════════════════════════════════
     BUTTONS
  ══════════════════════════════════════════════ */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    border: 1.5px solid transparent;
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease,
      transform 0.18s ease;
  }

  .btn:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .btn-primary {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
    border-color: var(--color-primary-dark);
    color: #fff;
  }

  .btn-secondary {
    background: var(--color-surface);
    border-color: var(--color-border-highlight);
    color: var(--color-text);
  }

  .btn-secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .btn-large {
    padding: var(--space-4) var(--space-8);
    font-size: var(--font-size-base);
  }

  /* ══════════════════════════════════════════════
     FEATURE ROWS
  ══════════════════════════════════════════════ */
  /* Each row is a full-width band (like joinmastodon.org): tinted, white, tinted…
     The band is a pseudo-element that bleeds past <main>'s 1200px column. */
  .features {
    display: grid;
    isolation: isolate;
  }

  .feature {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
    padding-block: var(--space-24);
  }

  .feature::before,
  .cta-banner::before {
    content: '';
    position: absolute;
    inset: 0 calc(50% - 50vw);
    z-index: -1;
    background: var(--band-bg, transparent);
  }

  .feature:nth-child(odd) {
    --band-bg: #f4f8f7;
  }

  @media (max-width: 640px) {
    .feature {
      padding-block: var(--space-12);
    }
  }

  @media (min-width: 900px) {
    .feature {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: var(--space-16);
    }
    .feature-flip .feature-text {
      order: 2;
    }
    .feature-flip .feature-visual {
      order: 1;
    }
  }

  .feature-text {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: 48ch;
  }

  /* Same gridded pixel font as the hero tagline. No letter-spacing, so the grid
     drawn inside the glyphs stays continuous; a padding space on each side
     extends the grid past the text, like the tagline's &nbsp;s. */
  .feature-eyebrow,
  .feature-text .feature-eyebrow {
    margin: 0;
    font-family: 'Micro 5 Charted', var(--font-mono);
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-primary); /* dark teal #0E7265 */
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .feature-eyebrow::before,
  .feature-eyebrow::after {
    content: '\00a0';
  }

  .feature-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .feature-text p {
    margin: 0;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }

  .feature-link {
    font-weight: 700;
    color: var(--color-primary);
  }

  .feature-link::after {
    content: ' →';
    display: inline-block;
    transition: transform 0.18s ease;
  }

  .feature-link:hover::after {
    transform: translateX(3px);
  }

  .feature-visual {
    position: relative;
  }

  /* ── Shared mock card pieces ─────────────── */
  .mock-card {
    background: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: 0 18px 40px -22px rgba(14, 114, 101, 0.35);
    overflow: hidden;
    font-size: 0.8rem;
  }

  .mock-foot {
    border-top: 1px solid var(--color-border);
  }

  .mock-foot,
  .map-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
  }

  .chip {
    display: inline-block;
    padding: 2px 9px;
    border-radius: 999px;
    background: var(--color-primary-glow);
    color: var(--color-primary);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .mock-more {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-dim);
  }

  /* ── Complete Catalog mock: list of datasets ── */
  .lib-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border-bottom: 1.5px solid var(--color-border);
  }

  .lib-head strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .lib-head span:not(.lib-pin) {
    font-size: 0.72rem;
    color: var(--color-text-dim);
  }

  .lib-pin {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    flex-shrink: 0;
  }

  .lib-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lib-list li {
    display: grid;
    gap: 4px;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .lib-list li:last-child {
    border-bottom: none;
  }

  .lib-title {
    font-weight: 700;
    color: var(--color-text);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .lib-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.72rem;
    color: var(--color-text-dim);
  }

  /* Keep the catalog card compact and centred in its (wider) column. */
  .catalog-card {
    max-width: 440px;
    margin: 0 auto;
  }

  .cat-search {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-3) var(--space-4);
    padding: 7px 12px;
    border: 1.5px solid var(--color-border);
    border-radius: 999px;
    background: #f7faf9;
    color: var(--color-text-dim);
    font-size: 0.74rem;
  }

  .cat-search svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .catalog-card .lib-list {
    border-top: 1px solid var(--color-border);
  }

  /* Topic chips in the site's accent colours */
  .chip-gold {
    background: rgba(212, 160, 23, 0.16);
    color: #8a6a0c;
  }
  .chip-green {
    background: var(--color-accent-glow);
    color: var(--color-accent);
  }
  .chip-blue {
    background: rgba(62, 168, 188, 0.15);
    color: #1f6f80;
  }

  /* ── Community Library mock: map of the selected community ── */
  .map-svg {
    display: block;
    width: 100%;
    height: auto;
    background: #fafcfb;
  }

  .county path {
    fill: #e6efec;
    stroke: #fff;
    stroke-width: 3;
    stroke-linejoin: round;
  }

  .county-active {
    fill: rgba(14, 114, 101, 0.22);
    stroke: var(--color-primary);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }

  .pin {
    fill: var(--color-primary);
  }

  .pin-pulse {
    fill: var(--color-primary);
    opacity: 0.12;
    transform-origin: 172.9px 92.4px;
    animation: pulse 2.6s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      transform: scale(0.8);
      opacity: 0.16;
    }
    50% {
      transform: scale(1.1);
      opacity: 0.06;
    }
  }

  .map-caption {
    border-top: 1.5px solid var(--color-border);
  }

  /* ── Statistical tags card ─────────────── */
  .tag-group {
    display: grid;
    gap: 6px;
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .tag-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .stats-card .lib-head + .tag-group {
    border-top: none;
  }

  .stats-card .tag-group:last-child {
    padding-bottom: var(--space-4);
  }

  .feature-text .feature-note {
    font-size: var(--font-size-base);
    line-height: var(--line-height-normal);
    color: var(--color-text-dim);
  }

  /* ══════════════════════════════════════════════
     CTA BANNER
  ══════════════════════════════════════════════ */
  .cta-banner {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: var(--space-8);
    position: relative;
    isolation: isolate;
    padding: var(--space-16) 0;
    --band-bg: #e3f0ee;
    /* Run the band straight into the footer: cancel <main>'s bottom padding
       and the footer's top margin (both set in Layout.astro). */
    margin-bottom: calc(-1 * (var(--space-8) + var(--space-16)));
  }

  @media (min-width: 900px) {
    .cta-banner {
      grid-template-columns: minmax(0, 1.4fr) auto;
      gap: var(--space-16);
      padding: var(--space-24) 0;
    }
  }

  .cta-text {
    display: grid;
    gap: var(--space-3);
  }

  .cta-title {
    margin: 0;
    max-width: 24ch;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3vw, 2.2rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .cta-body {
    margin: 0;
    max-width: 48ch;
    color: var(--color-text-muted);
