---
import Layout from '@layouts/Layout.astro';
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import { withBasePath } from '@lib/paths';
import heroCityscape from '../assets/home/hero-cityscape.png';

const catalogResources = await getCollection('master-library');
const datasets = catalogResources.filter((entry) => entry.data.category === 'dataset');

// Four real catalog entries for the Complete Catalog mock-up: short names, four different topics.
// [sourceId, topic tag to show, chip color]
const FEATURED: [string, string, string][] = [
  ['census-county-estimates-all-2025', 'Population Data', 'teal'],
  ['chr-analytic-data-2025', 'Health & Social Services', 'gold'],
  ['ebird-observation-dataset', 'Wildlife & Nature', 'green'],
  ['epa-airtoxscreen-county', 'Energy & Environment', 'blue'],
];
const sampleDatasets = FEATURED.flatMap(([id, theme, tone]) => {
  const entry = datasets.find((d) => d.data.sourceId === id);
  return entry ? [{ title: entry.data.title, author: entry.data.author, theme, tone }] : [];
});
---

<Layout
  title="Home"
  description="Discover curated data science resources and contribute to our growing community library of datasets, tools, guides, and research papers."
>
  <!-- ═══════════════════════════════════════════
       HERO — centered copy, full-bleed illustration below
  ═══════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <br />
      <h1 class="hero-title" id="hero-title">Community Data Libraries</h1>
      <p class="hero-kicker">
        &nbsp;&nbsp;&nbsp;Data about your community, for your community&nbsp;&nbsp;&nbsp;
      </p>
      <p class="hero-body">
        A free, open-source tool to explore, locate, and access data about the U.S. community near
        you.
      </p>
      <div class="hero-actions">
        <a href={withBasePath('/complete-catalog')} class="btn btn-primary btn-large">
          Explore the data catalog
        </a>
        <a href={withBasePath('/create-community-library')} class="btn btn-secondary btn-large">
          Build a community library
        </a>
      </div>
    </div>
    <br />
    <br />
    <div class="hero-art">
      <div class="hero-art-frame">
        <Picture
          src={heroCityscape}
          formats={['avif', 'webp']}
          widths={[800, 1400, 2172]}
          sizes="100vw"
          alt="Illustration of a town drawn in dots (houses, a school, trees and people walking) linked overhead by a network of data points."
          loading="eager"
          fetchpriority="high"
        />
        <!-- Animated glow laid over the sun in the illustration -->
        <span class="sun-glow" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       FEATURE ROWS — alternating text / visual
  ═══════════════════════════════════════════ -->
  <section class="features" aria-label="What you can do">
    <!-- 1. Complete Catalog -->
    <article class="feature">
      <div class="feature-text">
        <p class="feature-eyebrow">Complete Catalog</p>
        <h2 class="feature-title">View all available datasets.</h2>
        <p>
          The Complete Catalog is the master list of all datasets we have curated so far (and that
          are used to populate the local community data libraries). Are we missing a great one?
          <a href={withBasePath('/submit')}>Suggest it to us</a>.
        </p>
        <a class="feature-link" href={withBasePath('/complete-catalog')}
          >Browse the complete catalog</a
        >
      </div>
      <div class="feature-visual" aria-hidden="true">
        <div class="mock-card catalog-card">
          <div class="lib-head">
            <span class="lib-pin">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><ellipse cx="12" cy="5" rx="8" ry="3"></ellipse><path
                  d="M4 5v14c0 1.66 3.58 3 8 3s8-1.34 8-3V5"></path><path
                  d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"></path></svg
              >
            </span>
            <div>
              <strong>Complete Catalog</strong>
              <span>Curated open datasets</span>
            </div>
          </div>
          <div class="cat-search">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg
            >
            Search the catalog…
          </div>
          <ul class="lib-list">
            {
              sampleDatasets.map((d) => (
                <li>
                  <span class="lib-title">{d.title}</span>
                  <span class="lib-meta">
                    {d.author}
                    <span class={`chip chip-${d.tone}`}>{d.theme}</span>
                  </span>
                </li>
              ))
            }
          </ul>
          <div class="mock-foot">
            <span class="mock-more">and many more…</span>
          </div>
        </div>
      </div>
    </article>

    <!-- 2. Community Library -->
    <article class="feature feature-flip">
      <div class="feature-text">
        <p class="feature-eyebrow">Community Data Libraries</p>
        <h2 class="feature-title">Create a data library for your community.</h2>
        <p>
          Use our tools to quickly create a community data library (CDL) for your community. Your
          CDL will show only datasets with data about your community. To build your CDL, simply
          <a href={withBasePath('/create-community-library')}>fill out our form</a>.
        </p>
        <a class="feature-link" href={withBasePath('/communities/knox-county/')}
          >See an example library (Knoxville, TN)</a
        >
      </div>
      <div class="feature-visual" aria-hidden="true">
