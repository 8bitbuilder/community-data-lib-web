---
import Layout from '@layouts/Layout.astro';
import { withBasePath } from '@lib/paths';
import { LIMITS, STATE_FIPS } from '@lib/community/librarianRules.mjs';

const states = Object.keys(STATE_FIPS).sort();
const communityBase = withBasePath('/communities/');
---

<Layout
  title="Librarian Portal"
  description="Register a community data library and keep its details up to date."
>
  <section class="portal" data-community-base={communityBase}>
    <header class="page-header">
      <p class="eyebrow">Community Libraries</p>
      <h1>Librarian portal</h1>
      <p class="intro">
        Register a community library for your county, or update one you maintain. Only librarians
        sign in here; visitors never need an account.
      </p>
    </header>

    <div id="portal-status" class="status" role="status" hidden></div>

    <section id="signed-out" class="card">
      <h2>Sign in to manage a library</h2>
      <p>
        Create an account with your email address. We'll send a confirmation link; once your email is
        confirmed you can register a library and you'll be listed as its first librarian.
      </p>
      <div class="actions">
        <button type="button" id="signup-btn">Create an account</button>
        <button type="button" id="login-btn" class="button-secondary">Log in</button>
      </div>
      <p class="note" id="identity-missing" hidden>
        Sign-in isn't available on this copy of the site. It works on the deployed Netlify site.
      </p>
    </section>

    <section id="signed-in" class="signed-in" hidden>
      <div class="card account">
        <p>Signed in as <strong id="user-email"></strong></p>
        <button type="button" id="logout-btn" class="button-secondary">Log out</button>
      </div>

      <div class="card">
        <h2>Your libraries</h2>
        <p id="libraries-loading" class="note">Loading your libraries…</p>
        <ul id="library-list" class="library-list"></ul>
        <p id="library-empty" class="note" hidden>
          You aren't a librarian of any library yet. Register one below, or ask an existing library's
          librarian to add your email.
        </p>
        <div class="actions">
          <button type="button" id="new-library-btn">Register a new library</button>
        </div>
      </div>

      <form id="library-form" class="card library-form" novalidate hidden>
        <h2 id="form-title">Register a new library</h2>
        <p id="form-intro" class="note"></p>

        <div class="field">
          <label for="f-name">Library name <span class="required">*</span></label>
          <input id="f-name" name="name" type="text" maxlength={LIMITS.name} required
            placeholder="e.g. Knox County Data Library" />
          <p class="field-error" data-error-for="name"></p>
        </div>

        <div class="field" id="slug-field">
          <label for="f-slug">Web address</label>
          <input id="f-slug" name="slug" type="text" maxlength={LIMITS.slug}
            pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="knox-county" />
          <p class="field-hint">
            Your library will live at <code>{communityBase}<span id="slug-preview">…</span>/</code>.
            It can't be changed later.
          </p>
          <p class="field-error" data-error-for="slug"></p>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="f-place">Place name</label>
            <input id="f-place" name="place_name" type="text" maxlength={LIMITS.placeName}
              placeholder="e.g. Knoxville" />
            <p class="field-hint">Used in "Welcome to …". Defaults to the library name.</p>
            <p class="field-error" data-error-for="place_name"></p>
          </div>
          <div class="field">
            <label for="f-county">County name</label>
            <input id="f-county" name="county" type="text" maxlength={LIMITS.county}
              placeholder="e.g. Knox County" />
            <p class="field-error" data-error-for="county"></p>
          </div>
        </div>

        <div class="field">
          <label for="f-description">Description</label>
          <textarea id="f-description" name="description" maxlength={LIMITS.description} rows="3"></textarea>
          <p class="field-error" data-error-for="description"></p>
        </div>

        <div class="field-row">
          <div class="field">
            <label for="f-state">State <span class="required">*</span></label>
            <select id="f-state" name="state_code" required>
              <option value="">Choose a state</option>
              {states.map((code) => <option value={code}>{code}</option>)}
            </select>
            <p class="field-error" data-error-for="state_code"></p>
          </div>
          <div class="field">
            <label for="f-fips">County FIPS code <span class="required">*</span></label>
            <input id="f-fips" name="county_fips" type="text" inputmode="numeric" maxlength="5"
              pattern="[0-9]{5}" required placeholder="47093" />
            <p class="field-hint">
              Five digits, state + county (Knox County, TN is 47093). Look it up in the
              <a href="https://www.census.gov/library/reference/code-lists/ansi.html" target="_blank"
                rel="noopener noreferrer">Census ANSI code lists</a>.
            </p>
            <p class="field-error" data-error-for="county_fips"></p>
          </div>
        </div>

        <div class="field">
          <label for="f-zips">ZIP codes</label>
          <textarea id="f-zips" name="zip_codes" rows="2" placeholder="37901, 37902, 37909"></textarea>
          <p class="field-hint">Five-digit ZIP codes, separated by commas or spaces.</p>
          <p class="field-error" data-error-for="zip_codes"></p>
        </div>

        <fieldset id="librarians-field" class="librarians" hidden>
          <legend>Librarians</legend>
          <p class="field-hint">
            Everyone listed can edit this library. Emails are public. A library always keeps at least one
            librarian.
          </p>
          <ul id="librarian-list" class="librarian-list"></ul>
          <div class="add-librarian">
            <input id="f-new-librarian" type="email" placeholder="colleague@example.org"
              aria-label="Email of a librarian to add" />
            <button type="button" id="add-librarian-btn" class="button-secondary">Add librarian</button>
          </div>
          <p class="field-error" data-error-for="librarian_emails"></p>
        </fieldset>

        <p id="form-error" class="form-error" role="alert"></p>

        <div class="actions">
          <button type="submit" id="save-btn">Register library</button>
          <button type="button" id="cancel-btn" class="button-secondary">Cancel</button>
        </div>
      </form>
    </section>
  </section>

  <script>
    import { isValidEmail, normalizeEmail, slugify } from '@lib/community/librarianRules.mjs';

    type Community = {
      name: string;
      slug: string;
      place_name?: string;
      description?: string;
      state_code: string;
      county?: string;
      county_fips?: string;
      zip_codes?: string[];
      librarian_emails: string[];
    };
    type IdentityUser = { email: string; jwt: () => Promise<string> };
    type FieldError = { field: string | null; message: string };

    const API = '/api/librarian/libraries';
    type NetlifyIdentity = {
      open: (tab?: 'login' | 'signup') => void;
      close: () => void;
      logout: () => void;
      currentUser: () => IdentityUser | null;
      on: (event: string, callback: (user: IdentityUser | null) => void) => void;
    };
    const identity = (window as unknown as { netlifyIdentity?: NetlifyIdentity }).netlifyIdentity;
    const portal = document.querySelector<HTMLElement>('.portal')!;
    const communityBase = portal.dataset.communityBase ?? '/communities/';
    const $ = (id: string) => document.getElementById(id) as HTMLElement;

    const form = $('library-form') as HTMLFormElement;
    const slugInput = $('f-slug') as HTMLInputElement;
    const nameInput = $('f-name') as HTMLInputElement;
    let currentUser: IdentityUser | null = null;
    let editing: Community | null = null;
    let librarians: string[] = [];
    let slugTouched = false;

    function showStatus(message: string, html = false) {
      const status = $('portal-status');
      if (html) status.innerHTML = message;
      else status.textContent = message;
      status.hidden = !message;
    }

    class ApiError extends Error {
      constructor(
        public status: number,
        message: string,
        public errors: FieldError[] = [],
      ) {
        super(message);
      }
    }

    async function api(method: string, path = '', body?: unknown) {
      if (!currentUser) throw new ApiError(401, 'Log in first.');
      const token = await currentUser.jwt();
      const response = await fetch(`${API}${path}`, {
        method,
        headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body),
      });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) {
        const fallback =
          response.status === 404 && !payload.error
            ? 'The librarian API is not available on this copy of the site.'
            : `Request failed (${response.status}).`;
        throw new ApiError(response.status, payload.error ?? fallback, payload.errors ?? []);
      }
      return payload;
    }

    function escapeHtml(value: string) {
      return value.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
    }

    // ── Signed-in state ─────────────────────────────

    let renderedEmail: string | null | undefined;

    function render(user: IdentityUser | null) {
      // init and the initial currentUser() check can both report the same user.
      if ((user?.email ?? null) === renderedEmail) return;
      renderedEmail = user?.email ?? null;
      currentUser = user;
      $('signed-out').hidden = Boolean(user);
      $('signed-in').hidden = !user;
      if (!user) {
        form.hidden = true;
        return;
      }
      $('user-email').textContent = user.email;
      loadLibraries();
    }

    async function loadLibraries() {
      const list = $('library-list');
      $('libraries-loading').hidden = false;
      $('library-empty').hidden = true;
      list.innerHTML = '';
      try {
        const { libraries } = (await api('GET')) as { libraries: Community[] };
        list.innerHTML = '';
        for (const library of libraries) {
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = `${communityBase}${library.slug}/`;
          link.textContent = library.name;
          const meta = document.createElement('span');
          meta.className = 'library-meta';
          meta.textContent = [library.state_code, library.county_fips && `FIPS ${library.county_fips}`]
            .filter(Boolean)
            .join(' · ');
          const edit = document.createElement('button');
          edit.type = 'button';
          edit.className = 'button-secondary';
          edit.textContent = 'Edit';
          edit.addEventListener('click', () => openForm(library));
          item.append(link, meta, edit);
          list.append(item);
        }
        $('library-empty').hidden = libraries.length > 0;
      } catch (err) {
        showStatus(err instanceof Error ? err.message : String(err));
      } finally {
        $('libraries-loading').hidden = true;
      }
    }

    // ── Form ────────────────────────────────────────

    function setValue(name: string, value: string) {
      (form.elements.namedItem(name) as HTMLInputElement).value = value;
    }

    function clearErrors() {
      form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => (el.textContent = ''));
      $('form-error').textContent = '';
    }

    function showErrors(err: unknown) {
      const message = err instanceof Error ? err.message : String(err);
      const errors = err instanceof ApiError ? err.errors : [];
      const general: string[] = [];
      for (const { field, message: fieldMessage } of errors) {
        const target = field && form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
        if (target) target.textContent = [target.textContent, fieldMessage].filter(Boolean).join(' ');
        else general.push(fieldMessage);
      }
      $('form-error').textContent = [message, ...general].join(' ');
    }

    function renderLibrarians() {
      const list = $('librarian-list');
      list.innerHTML = '';
      const me = normalizeEmail(currentUser?.email);
      for (const email of librarians) {
        const item = document.createElement('li');
        const label = document.createElement('span');
        label.textContent = email === me ? `${email} (you)` : email;
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'button-secondary';
        remove.textContent = 'Remove';
        remove.disabled = librarians.length === 1;
        remove.title = remove.disabled ? 'A library needs at least one librarian.' : '';
        remove.addEventListener('click', () => {
          librarians = librarians.filter((e) => e !== email);
          renderLibrarians();
        });
        item.append(label, remove);
        list.append(item);
      }
    }

    function updateSlugPreview() {
      $('slug-preview').textContent = (editing?.slug ?? slugInput.value) || '…';
    }

    function openForm(library: Community | null) {
      editing = library;
      clearErrors();
      form.reset();
      slugTouched = false;
      const isEdit = Boolean(library);
      $('form-title').textContent = isEdit ? `Edit ${library!.name}` : 'Register a new library';
      $('form-intro').textContent = isEdit
        ? 'Changes are published when you save; the site takes a few minutes to rebuild.'
        : 'You will be the first librarian. You can add colleagues after it is registered.';
      $('save-btn').textContent = isEdit ? 'Save changes' : 'Register library';
      slugInput.disabled = isEdit;
      $('librarians-field').hidden = !isEdit;

      if (library) {
        setValue('name', library.name);
        setValue('slug', library.slug);
        setValue('place_name', library.place_name ?? '');
        setValue('county', library.county ?? '');
        setValue('description', library.description ?? '');
        setValue('state_code', library.state_code);
        setValue('county_fips', library.county_fips ?? '');
        setValue('zip_codes', (library.zip_codes ?? []).join(', '));
        librarians = [...library.librarian_emails];
        renderLibrarians();
      }
      updateSlugPreview();
      form.hidden = false;
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      nameInput.focus({ preventScroll: true });
    }

    nameInput.addEventListener('input', () => {
      if (!editing && !slugTouched) slugInput.value = slugify(nameInput.value);
      updateSlugPreview();
    });
    slugInput.addEventListener('input', () => {
      slugTouched = true;
      updateSlugPreview();
    });

    $('add-librarian-btn').addEventListener('click', () => {
      const input = $('f-new-librarian') as HTMLInputElement;
      const email = normalizeEmail(input.value);
      const target = form.querySelector<HTMLElement>('[data-error-for="librarian_emails"]')!;
      if (!isValidEmail(email)) {
        target.textContent = 'Enter a valid email address.';
        return;
      }
      target.textContent = '';
      if (!librarians.includes(email)) librarians.push(email);
      input.value = '';
      renderLibrarians();
    });

    $('cancel-btn').addEventListener('click', () => {
      form.hidden = true;
      editing = null;
    });
    $('new-library-btn').addEventListener('click', () => openForm(null));

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();
      const data = new FormData(form);
      const payload: Record<string, unknown> = {
        name: data.get('name'),
        place_name: data.get('place_name'),
        county: data.get('county'),
        description: data.get('description'),
        state_code: data.get('state_code'),
        county_fips: data.get('county_fips'),
        zip_codes: data.get('zip_codes'),
      };
      if (editing) payload.librarian_emails = librarians;
      else payload.slug = data.get('slug');

      const saveBtn = $('save-btn') as HTMLButtonElement;
      saveBtn.disabled = true;
      try {
        const { community } = (await api(editing ? 'PUT' : 'POST', editing ? `/${editing.slug}` : '', payload)) as {
          community: Community;
        };
        const href = `${communityBase}${community.slug}/`;
        const stillLibrarian = community.librarian_emails.includes(normalizeEmail(currentUser?.email));
        showStatus(
          `${editing ? 'Saved' : 'Registered'} <strong>${escapeHtml(community.name)}</strong>. ` +
            `The site rebuilds in a few minutes; it will then be live at <a href="${href}">${escapeHtml(href)}</a>.` +
            (stillLibrarian ? '' : ' You removed yourself as a librarian, so you can no longer edit it.'),
          true,
        );
        form.hidden = true;
        editing = null;
        window.scrollTo({ top: 0, behavior: 'smooth' });
        loadLibraries();
      } catch (err) {
        showErrors(err);
      } finally {
        saveBtn.disabled = false;
      }
    });

    // ── Identity ────────────────────────────────────

    if (!identity) {
      $('identity-missing').hidden = false;
      ($('signup-btn') as HTMLButtonElement).disabled = true;
      ($('login-btn') as HTMLButtonElement).disabled = true;
    } else {
      $('signup-btn').addEventListener('click', () => identity.open('signup'));
      $('login-btn').addEventListener('click', () => identity.open('login'));
      $('logout-btn').addEventListener('click', () => identity.logout());
      identity.on('init', (user) => render(user));
      identity.on('login', (user) => {
        identity.close();
        render(user);
      });
      identity.on('logout', () => {
        showStatus('');
        render(null);
      });
      // The widget may have initialised before this script ran.
      render(identity.currentUser());
    }
  </script>

  <style>
    .portal {
      display: grid;
      gap: var(--space-6);
      max-width: 820px;
    }

    .page-header {
      display: grid;
      gap: var(--space-3);
    }

    .eyebrow {
      margin: 0;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: var(--font-size-xs);
      font-weight: 700;
      color: var(--color-secondary);
    }

    .page-header h1 {
      margin: 0;
      font-size: clamp(2.25rem, 4vw, 3.5rem);
    }

    .intro {
      margin: 0;
      color: var(--color-text-muted);
      font-size: var(--font-size-lg);
    }

    .card {
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      border-radius: var(--radius-xl);
      padding: var(--space-6);
      box-shadow: var(--shadow-sm);
      display: grid;
      gap: var(--space-4);
    }

    .card[hidden],
    .signed-in[hidden],
    .status[hidden] {
      display: none;
    }

    .signed-in {
      display: grid;
      gap: var(--space-6);
    }

    h2 {
      margin: 0;
      font-size: var(--font-size-2xl);
    }

    p {
      margin: 0;
    }

    .note,
    .field-hint {
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
    }

    .field-hint {
      font-size: var(--font-size-xs);
    }

    .status {
      padding: var(--space-4) var(--space-5);
      border: 1px solid var(--color-border);
      border-left: 4px solid var(--color-secondary);
      border-radius: var(--radius-lg);
      background: var(--color-surface);
      font-size: var(--font-size-sm);
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
    }

    /* Rows and buttons below are created by the script, so they need :global()
       to receive this page's scoped styles. */
    .portal :global(.button-secondary) {
      background-color: transparent;
      color: var(--color-secondary);
    }

    .portal :global(.button-secondary:hover) {
      color: #f8fafc;
    }

    .portal :global(button:disabled) {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }

    .account {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
    }

    .library-list,
    .librarian-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .library-list :global(li),
    .librarian-list :global(li) {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2) var(--space-4);
      padding: var(--space-3) 0;
      border-bottom: 1px solid var(--color-border);
    }

    .library-list :global(a) {
      font-weight: 600;
    }

    .library-list :global(.library-meta) {
      flex: 1;
      font-size: var(--font-size-sm);
      color: var(--color-text-dim);
    }

    .librarian-list :global(span) {
      flex: 1;
      overflow-wrap: anywhere;
      font-size: var(--font-size-sm);
    }

    .library-list :global(button),
    .librarian-list :global(button) {
      padding: var(--space-1) var(--space-3);
    }

    .field {
      display: grid;
      gap: var(--space-1);
    }

    .field-row {
      display: grid;
      gap: var(--space-4);
    }

    @media (min-width: 640px) {
      .field-row {
        grid-template-columns: 1fr 1fr;
      }
    }

    label,
    legend {
      font-size: var(--font-size-sm);
      font-weight: 600;
      color: var(--color-text);
    }

    .required {
      color: var(--color-accent);
    }

    input,
    select,
    textarea {
      width: 100%;
      min-width: 0;
      padding: var(--space-3) var(--space-4);
      background: var(--color-surface-raised);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      color: var(--color-text);
      font-family: var(--font-sans);
      font-size: var(--font-size-sm);
    }

    input:disabled {
      color: var(--color-text-dim);
    }

    input:focus,
    select:focus,
    textarea:focus {
      outline: none;
      border-color: var(--color-primary);
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.12);
    }

    .librarians {
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: var(--space-4);
      margin: 0;
      display: grid;
      gap: var(--space-3);
    }

    .librarians[hidden] {
      display: none;
    }

    .add-librarian {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .add-librarian input {
      flex: 1 1 14rem;
      width: auto;
    }

    .field-error,
    .form-error {
      color: #b42318;
      font-size: var(--font-size-xs);
      font-weight: 500;
    }

    .form-error {
      font-size: var(--font-size-sm);
    }

    .field-error:empty,
    .form-error:empty {
      display: none;
    }
  </style>
</Layout>
