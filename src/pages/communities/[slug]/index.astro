---
import CommunityLayout from '@layouts/CommunityLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { libraryHref } from '@lib/paths';
import { AUDIENCE_LABELS, AUDIENCE_ROLES, communityDisplay } from '@lib/data/communityFilter';
import { countyOutline } from '@lib/data/countyOutline';

export async function getStaticPaths() {
  const communities = await getCollection('communities');
  return communities.map((community) => ({
    params: { slug: community.data.slug },
    props: { community },
  }));
}

interface Props {
  community: CollectionEntry<'communities'>;
}

const { community } = Astro.props;
const data = community.data;
const { libraryTitle, welcomeHeading, placeName } = communityDisplay(data);
const catalogHref = libraryHref(data.slug, '/catalog/');
const location = [data.county, data.state_code].filter(Boolean).join(', ');

// e.g. "Knoxville Community Library" / "Knoxville Community Data Library"
const pageHeading = `${placeName} Community Data Library`;
const footerTitle = `${placeName} Community Data Library`;

// County shape for the header graphic. Resolved at build time from the TIGER
// topology in public/geo/boundaries/ by the entry's 5-digit county_fips, so the
// 800 KB file never reaches the browser. Null when the code is missing/unknown,
// in which case the graphic is skipped and the header text fills the row.
const outline = countyOutline(data.county_fips);
const outlineLabel = [data.county, data.state_name ?? data.state_code]
  .filter(Boolean)
  .join(', ');

// Dotted-grid backdrop: a regular grid of dots whose size and colour vary a
// little. Generated at build time from a seed derived from the community slug,
// so the pattern is stable between builds but differs from library to library.
// Colours repeat in the list to weight them (teal/green most common).
const DOT_COLORS = [
  '#0B5075', // deep blue
  '#2BA58F',
  '#2BA58F', // teal
  '#3BAE7C',
  '#3BAE7C', // green
  '#7CC15D', // leaf green
  '#A3CE7A', // pale green
  '#8FD3D6', // light blue
  '#F5B942', // gold
];
const DOT_COLS = 24; // dots per row
const DOT_ROWS = 18; // dots per column
const DOT_STEP = 17.5; // spacing between dot centres, in viewBox units
const DOT_W = DOT_COLS * DOT_STEP; // 420
const DOT_H = DOT_ROWS * DOT_STEP; // 315 (4:3, matches the frame's aspect-ratio)

function seededRandom(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = seededRandom(
  [...String(data.slug)].reduce((hash, ch) => (hash * 31 + ch.charCodeAt(0)) | 0, 7)
);

const dots = Array.from({ length: DOT_COLS * DOT_ROWS }, (_, i) => ({
  cx: Number(((i % DOT_COLS) * DOT_STEP + DOT_STEP / 2).toFixed(2)),
  cy: Number((Math.floor(i / DOT_COLS) * DOT_STEP + DOT_STEP / 2).toFixed(2)),
  r: Number((1 + rand() * 1.3).toFixed(2)), // radius 1.0 – 2.3
  fill: DOT_COLORS[Math.floor(rand() * DOT_COLORS.length)],
}));

const roleDescriptions = {
  teacher: 'Topical and pedagogical tags to help plan lessons with local data.',
  student: 'A student-friendly selection of datasets for projects and exploration.',
  community: 'Topical tags for exploring data about where you live.',
} as const;
---

<CommunityLayout
  title="Home"
  description={data.description ??
    `${libraryTitle}: local data for teachers, students, and community members.`}
  communityName={libraryTitle}
  communityLocation={location || undefined}
  communitySlug={data.slug}
  page="home"
  footerTitle={footerTitle}
>
  <section class="landing">
    <!-- Hero: the county's own outline on a dotted-grid backdrop (left),
         with the left-aligned kicker, title, and intro to its right. Stacks
         on narrow screens. -->
    <div class="hero">
      {
        outline && (
          <div class="county-band">
            <div class="county-art-frame">
              <svg
                class="county-dots"
                viewBox={`0 0 ${DOT_W} ${DOT_H}`}
                aria-hidden="true"
                focusable="false"
              >
                {dots.map((dot) => (
                  <circle cx={dot.cx} cy={dot.cy} r={dot.r} fill={dot.fill} />
                ))}
              </svg>
              <svg
                class="county-art"
                viewBox={`0 0 ${outline.width} ${outline.height}`}
                role="img"
                aria-label={`Outline of ${outlineLabel}`}
              >
                <path d={outline.d} fill="#107366" stroke="#107366" stroke-width="2" stroke-linejoin="round" fill-rule="evenodd" />
              </svg>
            </div>
          </div>
        )
      }

      <header class="landing-header">
        {location && <p class="kicker">{location}</p>}
        <h1>{pageHeading}</h1>
        <p class="intro">
          {
            data.description ??
              `Open data about ${placeName}, selected from the Community Data Libraries catalog.`
          }
        </p>
      </header>
    </div>

    <!-- Three full-bleed, equal-width square bands (one per audience), in the
         style of the main homepage's colour-contrasted sections. -->
    <section class="roles" aria-label="How will you use the library?">
      {
        AUDIENCE_ROLES.map((role) => (
          <a
            href={`${catalogHref}?audience=${role}`}
            class={`role-panel role-${role}`}
            data-audience={role}
          >
            <span class="role-inner">
              <span class="role-name">{AUDIENCE_LABELS[role]} Catalog</span>
              <span class="role-desc">{roleDescriptions[role]}</span>
              <span class="role-arrow" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </span>
            </span>
          </a>
        ))
      }
    </section>
  </section>

  <script>
    import { saveAudience } from '../../../lib/client/audience';
    import { normalizeAudience } from '../../../lib/data/communityFilter';

    // The link already carries ?audience=; saving here also covers the case
    // where the visitor later returns to the catalog through the nav.
    document.querySelectorAll<HTMLAnchorElement>('.role-panel[data-audience]').forEach((panel) => {
      panel.addEventListener('click', () => {
        const role = normalizeAudience(panel.dataset.audience);
        if (role) {
          saveAudience(role);
          document.dispatchEvent(
            new CustomEvent('cdl:audience-change', { detail: { audience: role } })
          );
        }
      });
    });
  </script>

  <style>
    .landing {
      display: grid;
      gap: var(--space-12);
    }

    /* ── Hero: graphic on the left, text on the right ──
       Flex-wrap means it stacks automatically on narrow screens. */
    .hero {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-8);
      padding-top: var(--space-8);
    }

    .county-band {
      position: relative;
      flex: 0 0 auto;
      width: min(100%, 420px);
    }

    .county-art-frame {
      position: relative;
      z-index: 1;
      display: grid;
      place-items: center;
      width: min(100%, 420px);
      aspect-ratio: 4 / 3;
      padding: var(--space-6);
      background-color: transparent;
    }

    /* Varied dots fill the whole frame, sitting behind the county shape. */
    .county-dots {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .county-art {
      /* Positioned so it paints above the (absolutely positioned) dots. */
      position: relative;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .landing-header {
      display: grid;
      justify-items: start;
      gap: var(--space-4);
      flex: 1 1 20rem;
      max-width: 70ch;
      margin: 0;
      text-align: left;
    }

    .kicker {
      margin: 0;
      font-family: var(--font-mono);
      font-size: var(--font-size-xs);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-secondary);
    }

    h1 {
      margin: 0;
      font-size: clamp(2.25rem, 5vw, 3.75rem);
      line-height: 1.05;
      text-wrap: balance;
    }

    .intro {
      margin: 0;
      font-size: var(--font-size-lg);
      color: var(--color-text-muted);
      line-height: var(--line-height-relaxed);
      text-wrap: pretty;
    }

    /* ── Audience bands ───────────────────────────
       Full-bleed: break out of <main>'s 1200px column, three equal columns. */
    .roles {
      width: 100vw;
      margin-left: calc(50% - 50vw);
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .role-panel {
      /* --bg: section tint; --ink: darker shade used for text and the arrow at rest */
      display: block;
      aspect-ratio: 1 / 1;
      background: var(--bg);
      color: var(--ink);
      border-radius: 0;
      text-decoration: none;
      transition:
        background-color 0.2s ease,
        color 0.2s ease;
    }

    .role-teacher {
      --bg: #e1f2f5;
      --ink: #426f78;
    }

    .role-student {
      --bg: #e5f1df;
      --ink: #66865b;
    }

    .role-community {
      --bg: #e4efee;
      --ink: #496f6b;
    }

    .role-inner {
      display: grid;
      align-content: center;
      justify-items: center;
      gap: var(--space-4);
      width: 100%;
      height: 100%;
      padding: var(--space-8);
      text-align: center;
    }

    .role-name {
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 2.4vw, 2.25rem);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: inherit;
    }

    .role-desc {
      max-width: 28ch;
      font-size: var(--font-size-base);
      line-height: var(--line-height-relaxed);
      color: inherit;
    }

    /* Circular arrow button: filled with the current text colour, the arrow itself
       drawn in whatever the section background currently is. */
    .role-arrow {
      display: grid;
      place-items: center;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: currentColor;
      color: inherit;
      transition:
        background-color 0.2s ease,
        color 0.2s ease;
    }

    .role-arrow svg {
      color: var(--bg);
      transition: color 0.2s ease;
    }

    /* Hover: the whole band flips to the darker shade, text and arrow disc go white,
       and the arrow glyph takes the (now dark) background colour. */
    .role-panel:hover,
    .role-panel:focus-visible {
      background: var(--ink);
      color: #ffffff;
      text-decoration: none;
    }

    .role-panel:hover .role-arrow svg,
    .role-panel:focus-visible .role-arrow svg {
      color: var(--ink);
    }

    @media (max-width: 900px) {
      .roles {
        grid-template-columns: 1fr;
      }
      .role-panel {
        aspect-ratio: auto;
        min-height: 18rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .role-panel,
      .role-arrow,
      .role-arrow svg {
        transition: none;
      }
    }
  </style>
</CommunityLayout>