---
import Layout from '@layouts/Layout.astro';
import { withBasePath } from '@lib/paths';

const audience = (Astro.url.searchParams.get('audience') ?? '').trim();
const tutorialHref = withBasePath('/data-resources');
const catalogHref = withBasePath('/complete-catalog');
---

<Layout title="Data Preview" description="Interactive preview of dataset sources with metrics and geographic filters">
  <Fragment slot="head">
    <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.54.1/dist/apexcharts.min.js" is:inline></script>
  </Fragment>

  <section class="preview-page" id="preview-page">
    <div id="loading-state" class="status-panel">
      <div class="loading-spinner" aria-hidden="true"></div>
      <p>Loading dataset preview…</p>
    </div>

    <div id="error-state" class="status-panel error-panel" hidden>
      <h2>Unable to load preview</h2>
      <p id="error-message"></p>
      <p class="error-hint">Start the preview API in a separate terminal: <code>npm run backend:dev</code> (runs on port 4323).</p>
      <p class="error-hint">The Astro dev server may use port 4322 when 4321 is busy — that is not the preview API.</p>
    </div>

    <div id="source-picker" class="source-picker" hidden>
      <nav class="preview-breadcrumb" aria-label="Breadcrumb">
        <a href={catalogHref} class="back-link">← Complete Catalog</a>
      </nav>
      <h1 class="page-title">Data Preview</h1>
      <p class="page-intro">Select a dataset source to preview. Live previews require the backend API.</p>
      <ul id="source-list" class="source-grid"></ul>
    </div>

    <div id="preview-content" hidden>
      <nav class="preview-breadcrumb" aria-label="Breadcrumb">
        <a href={catalogHref} class="back-link">← Complete Catalog</a>
      </nav>

      <header class="preview-header">
        <div class="header-main">
          <h1 class="page-title" id="source-title"></h1>
          <p class="source-provider" id="source-provider" hidden></p>
          <div class="description-card" id="source-description"></div>
          {audience && <p class="audience-note">Opened from the {audience} catalog view.</p>}
          <p class="account-warning" id="account-warning" hidden>
            <span class="warning-icon" aria-hidden="true">!</span>
            Requires a free account for downloads.
          </p>
        </div>
      </header>

      <div class="meta-actions-row panel-card">
        <div class="tags-panel">
          <div class="tag-group">
            <span class="tag-label">Topical</span>
            <div class="tag-chips" id="topical-tags"></div>
          </div>
          <div class="tag-group">
            <span class="tag-label">Pedagogical</span>
            <div class="tag-chips" id="pedagogical-tags"></div>
          </div>
          <div class="tag-group">
            <span class="tag-label">Geographic</span>
            <div class="tag-chips" id="geographic-tags"></div>
          </div>
        </div>

        <div class="actions-panel">
          <span class="actions-label">Get the data</span>
          <div class="action-buttons">
            <a id="download-btn" class="btn-download" href="#" target="_blank" rel="noopener noreferrer">
              <span class="btn-icon" aria-hidden="true">↓</span>
              Download
            </a>
            <a class="btn-tutorial" href={tutorialHref}>See tutorial</a>
          </div>
        </div>
      </div>

      <div class="middle-row">
        <aside class="datasheet-panel panel-card">
          <h2 class="section-title">Datasheet</h2>
          <dl class="datasheet-list">
            <div class="datasheet-item"><dt>Who</dt><dd id="ds-who"></dd></div>
            <div class="datasheet-item"><dt>How</dt><dd id="ds-how"></dd></div>
            <div class="datasheet-item"><dt>Where</dt><dd id="ds-where"></dd></div>
            <div class="datasheet-item"><dt>Why</dt><dd id="ds-why"></dd></div>
            <div class="datasheet-item"><dt>When</dt><dd id="ds-when"></dd></div>
          </dl>
        </aside>

        <div class="chart-panel panel-card">
          <div class="chart-header">
            <h2 class="section-title">Focal variable plot</h2>
            <div class="chart-controls" id="chart-controls">
              <label class="filter-control" id="state-filter-wrap" hidden>
                <span>State</span>
                <select id="state-filter"></select>
              </label>
              <label class="filter-control" id="county-filter-wrap" hidden>
                <span>County</span>
                <select id="county-filter">
                  <option value="">All counties</option>
                </select>
              </label>
              <label class="filter-control" id="x-variable-filter-wrap">
                <span>X Variable</span>
                <select id="x-variable-filter"></select>
              </label>
              <label class="filter-control">
                <span>Y Variable</span>
                <select id="variable-filter"></select>
              </label>
              <label class="filter-control">
                <span>Plot Type</span>
                <select id="plot-type-filter">
                  <option value="bar">Bar</option>
                  <option value="line">Line</option>
                  <option value="scatter">Scatter</option>
                </select>
              </label>
            </div>
          </div>
          <details class="reference-card" id="reference-card" hidden>
            <summary class="reference-summary">Reference &amp; Guidance</summary>
            <div class="reference-body" id="reference-body">
              <!-- filled by JS -->
            </div>
          </details>
          <div class="chart-canvas-wrap">
            <div id="chart-loading" class="section-loading" hidden>Loading chart…</div>
            <div id="focal-chart" aria-label="Focal variable chart"></div>
          </div>
        </div>
      </div>

      <div class="table-panel panel-card">
        <div class="table-header">
          <h2 class="section-title">Geographically filtered data preview</h2>
          <p class="table-meta" id="table-meta"></p>
        </div>
        <div class="table-scroll">
          <div id="table-loading" class="section-loading table-section-loading" hidden>Loading table…</div>
          <div class="data-grid" id="preview-grid" role="grid" aria-label="Dataset preview">
            <div class="data-grid-header" id="preview-grid-header"></div>
            <div class="data-grid-body" id="preview-grid-body"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    import {
      fetchSource,
      fetchDatasheet,
      fetchPreview,
      fetchChart,
      fetchFilterOptions,
      fetchSources,
      buildCatalogDescription,
      normalizeDescriptionTags,
      getPedagogicalTags,
      getGeographicTags,
    } from '@lib/api/backend';
    import { withBasePath } from '@lib/paths';

    function getSourceIdFromUrl() {
      return new URLSearchParams(window.location.search).get('source')?.trim() ?? '';
    }

    let sourceId = getSourceIdFromUrl();
    let focalVariable = '';
    let initialStateFilter = '';

    const loadingState = document.getElementById('loading-state');
    const errorState = document.getElementById('error-state');
    const errorMessage = document.getElementById('error-message');
    const sourcePicker = document.getElementById('source-picker');
    const sourceList = document.getElementById('source-list');
    const previewContent = document.getElementById('preview-content');

    const stateFilter = document.getElementById('state-filter') as HTMLSelectElement;
    const countyFilter = document.getElementById('county-filter') as HTMLSelectElement;
    const variableFilter = document.getElementById('variable-filter') as HTMLSelectElement;
    const xVariableFilter = document.getElementById('x-variable-filter') as HTMLSelectElement;
    const plotTypeFilter = document.getElementById('plot-type-filter') as HTMLSelectElement;
    const stateFilterWrap = document.getElementById('state-filter-wrap');
    const countyFilterWrap = document.getElementById('county-filter-wrap');

    let chartInstance = null;
    // Full X-variable option list (value + numeric flag), captured once per source
    // so the dropdown can be narrowed to numeric-only columns when Plot Type is Scatter.
    let xVariableOptions: { value: string; numeric: boolean }[] = [];

    // In raw-YAML mode (no SQLite DB), the pipeline writes column names as
    // `variable_names`; only the SQLite import path renames it to `variables`.
    // The chart backends already fall back to `variable_names` — mirror that here.
    function getSourceVariables(source): string[] {
      return source.variables ?? source.variable_names ?? [];
    }

    function pickFocalVariable(source) {
      const numeric = source.variable_report?.find(
        (v) => v.type === 'integer' || v.type === 'float',
      );
      if (numeric?.name) return numeric.name;

      const vars = getSourceVariables(source);
      const preferred = vars.find((v) => /estimate|total|value|amount|production|population/i.test(v));
      return preferred ?? vars[vars.length - 1] ?? '';
    }

    function pickInitialState(source) {
      if (source.id === 'census-county-estimates-all-2025') return '47';
      return '';
    }

    function showPreviewContent() {
      loadingState?.setAttribute('hidden', '');
      previewContent?.removeAttribute('hidden');
    }

    function setSectionLoading(chartLoading, tableLoading) {
      document.getElementById('chart-loading')?.toggleAttribute('hidden', !chartLoading);
      document.getElementById('table-loading')?.toggleAttribute('hidden', !tableLoading);
      document.getElementById('preview-grid')?.toggleAttribute('hidden', tableLoading);
    }

    function showError(message) {
      loadingState?.setAttribute('hidden', '');
      previewContent?.setAttribute('hidden', '');
      sourcePicker?.setAttribute('hidden', '');
      errorState?.removeAttribute('hidden');
      if (errorMessage) errorMessage.textContent = message;
    }

    function renderTags(containerId, tags, filledFirst = false) {
      const container = document.getElementById(containerId);
      if (!container) return;
      container.innerHTML = '';
      if (!tags.length) {
        container.innerHTML = '<span class="tag-chip tag-outline">Not specified</span>';
        return;
      }
      tags.forEach((tag, i) => {
        const chip = document.createElement('span');
        chip.className = `tag-chip ${filledFirst && i === 0 ? 'tag-filled' : 'tag-outline'}`;
        chip.textContent = tag;
        container.appendChild(chip);
        if (i < tags.length - 1) {
          container.appendChild(document.createTextNode(', '));
        }
      });
    }

    function isNumericCell(value) {
      if (value === '' || value == null) return false;
      const n = Number(String(value).replace(/,/g, ''));
      return !Number.isNaN(n) && String(value).trim() !== '';
    }

    function formatCell(value) {
      if (!isNumericCell(value)) return String(value ?? '');
      const n = Number(String(value).replace(/,/g, ''));
      if (Number.isInteger(n) && Math.abs(n) >= 1000) return n.toLocaleString();
      if (!Number.isInteger(n)) return n.toLocaleString(undefined, { maximumFractionDigits: 2 });
      return String(n);
    }

    function renderChart(chartData, plotType: string = 'bar') {
      const container = document.getElementById('focal-chart');
      const Apex = window.ApexCharts;
      if (!container || typeof Apex === 'undefined') return;

      if (chartInstance) {
        chartInstance.destroy();
        chartInstance = null;
      }

      if (plotType === 'scatter') {
        const points = (chartData.points ?? []).map((p: { x: number; y: number }) => [p.x, p.y]);
        chartInstance = new Apex(container, {
          chart: {
            type: 'scatter',
            height: 300,
            toolbar: { show: false },
            fontFamily: 'Outfit, sans-serif',
            zoom: { enabled: true, type: 'xy' },
          },
          series: [{ name: chartData.label, data: points }],
          xaxis: {
            title: {
              text: chartData.xLabel ?? chartData.xVariable ?? 'X',
              style: { fontSize: '11px', color: '#52606D' },
            },
            labels: { style: { fontSize: '11px', colors: '#52606D' } },
            tickAmount: 6,
          },
          yaxis: {
            title: { text: chartData.label, style: { fontSize: '11px', color: '#52606D' } },
            labels: { style: { colors: '#52606D', fontSize: '11px' } },
          },
          colors: ['#155E75'],
          dataLabels: { enabled: false },
          grid: {
            strokeDashArray: 4,
            borderColor: '#D2DEE6',
          },
          tooltip: {
            theme: 'light',
            x: { formatter: (v: number) => Number(v).toLocaleString() },
            y: { formatter: (v: number) => Number(v).toLocaleString() },
          },
        });
        chartInstance.render();
        return;
      }

      const labels = (chartData.series ?? []).map((p) => p.label);
      const values = (chartData.series ?? []).map((p) => p.value);
      const chartType = plotType === 'line' ? 'line' : 'bar';

      chartInstance = new Apex(container, {
        chart: {
          type: chartType,
          height: 300,
          toolbar: { show: false },
          fontFamily: 'Outfit, sans-serif',
        },
        series: [{ name: chartData.label, data: values }],
        xaxis: {
          categories: labels,
          labels: {
            rotate: labels.length > 8 ? -45 : 0,
            trim: true,
            hideOverlappingLabels: true,
            style: { fontSize: '11px', colors: '#52606D' },
          },
          axisBorder: { show: false },
          axisTicks: { show: false },
        },
        yaxis: {
          labels: {
            style: { colors: '#52606D', fontSize: '11px' },
            formatter: (v) => {
              const n = Number(v);
              if (Math.abs(n) >= 1e9) return `${(n / 1e9).toFixed(1)}B`;
              if (Math.abs(n) >= 1e6) return `${(n / 1e6).toFixed(1)}M`;
              if (Math.abs(n) >= 1e3) return `${(n / 1e3).toFixed(0)}k`;
              return String(n);
            },
          },
        },
        colors: ['#155E75'],
        plotOptions: {
          bar: {
            borderRadius: 3,
            columnWidth: '60%',
          },
        },
        dataLabels: { enabled: false },
        grid: {
          strokeDashArray: 4,
          borderColor: '#D2DEE6',
          xaxis: { lines: { show: false } },
        },
        tooltip: {
          theme: 'light',
          y: {
            formatter: (v) => Number(v).toLocaleString(),
          },
        },
      });

      chartInstance.render();
    }

    function escapeHtml(value) {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function buildGridTemplate(columns, numericCols) {
      return columns
        .map((col, i) => {
          if (numericCols[i]) return 'minmax(5.5rem, 1fr)';
          const name = col.toUpperCase();
          if (/NAME|COUNTY|LABEL|TITLE|DESCRIPTION/.test(name)) return 'minmax(9rem, 1.6fr)';
          if (/STUSPS|STATE|FIPS|GEOID|ID|CODE/.test(name)) return 'minmax(4.5rem, 0.75fr)';
          return 'minmax(7rem, 1fr)';
        })
        .join(' ');
    }

    function renderTable(preview) {
      const grid = document.getElementById('preview-grid');
      const header = document.getElementById('preview-grid-header');
      const body = document.getElementById('preview-grid-body');
      const meta = document.getElementById('table-meta');
      if (!grid || !header || !body) return;

      const numericCols = preview.columns.map((_, colIdx) =>
        preview.rows.some((row) => isNumericCell(row[colIdx])),
      );
      const gridTemplate = buildGridTemplate(preview.columns, numericCols);

      grid.style.setProperty('--grid-template', gridTemplate);
      grid.style.gridTemplateColumns = gridTemplate;
      grid.setAttribute('aria-colcount', String(preview.columns.length));
      grid.setAttribute('aria-rowcount', String(preview.rows.length + 1));

      header.innerHTML = `<div class="grid-row" role="row">${preview.columns
        .map(
          (c, i) =>
            `<div class="grid-cell grid-header ${numericCols[i] ? 'col-numeric' : ''}" role="columnheader" title="${escapeHtml(c)}">${escapeHtml(c.replace(/_/g, ' '))}</div>`,
        )
        .join('')}</div>`;

      body.innerHTML = preview.rows
        .map(
          (row, i) =>
            `<div class="grid-row ${i % 2 === 0 ? 'row-even' : 'row-odd'}" role="row">${row
              .map(
                (cell, colIdx) =>
                  `<div class="grid-cell ${numericCols[colIdx] ? 'col-numeric' : ''}" role="gridcell" title="${escapeHtml(cell)}">${escapeHtml(formatCell(cell))}</div>`,
              )
              .join('')}</div>`,
        )
        .join('');

      if (meta) {
        meta.textContent = `Showing ${preview.rows.length.toLocaleString()} of ${preview.total.toLocaleString()} rows`;
      }
    }

    async function loadCountyOptions(currentState) {
      if (!countyFilter) return;
      countyFilter.innerHTML = '<option value="">All counties</option>';
      if (!currentState) return;
      const options = await fetchFilterOptions(sourceId, 'county', currentState);
      for (const opt of options) {
        const el = document.createElement('option');
        el.value = opt.value;
        el.textContent = opt.label;
        countyFilter.appendChild(el);
      }
    }

    async function refreshPreviewAndChart() {
      const state = stateFilter?.value || undefined;
      const county = countyFilter?.value || undefined;
      const variable = variableFilter?.value || focalVariable;
      const xVariable = xVariableFilter?.value || undefined;
      const plotType = (plotTypeFilter?.value || 'bar') as 'bar' | 'line' | 'scatter';

      setSectionLoading(true, true);
      try {
        const [preview, chart] = await Promise.all([
          fetchPreview(sourceId, {
            state,
            county,
            limit: 25,
          }),
          fetchChart(sourceId, {
            state,
            county,
            variable,
            xVariable,
            plotType,
            limit: plotType === 'scatter' ? 300 : 15,
          }),
        ]);

        renderTable(preview);
        renderChart(chart, plotType);
      } finally {
        setSectionLoading(false, false);
      }
    }

    function populateReferenceCard(source) {
      const card = document.getElementById('reference-card');
      const body = document.getElementById('reference-body');
      if (!card || !body) return;
      const geoTags = getGeographicTags(source);
      const hasFips = geoTags.includes('state') || geoTags.includes('county');
      if (!hasFips) return;
      card.removeAttribute('hidden');
      body.innerHTML = `
        <ul class="reference-links">
          <li><a href="https://www.census.gov/library/reference/code-lists/ansi/ansi-codes-for-states.html" target="_blank" rel="noopener noreferrer">State FIPS Codes (Census.gov)</a> — two-digit numeric codes used for each U.S. state/territory</li>
          <li><a href="https://www.census.gov/library/reference/code-lists/ansi.html" target="_blank" rel="noopener noreferrer">County FIPS Codes (Census.gov)</a> — five-digit codes (state + county)</li>
          <li><a href="https://www.nrcs.usda.gov/wps/portal/nrcs/detail/?cid=nrcs143_013696" target="_blank" rel="noopener noreferrer">USDA State/County Codes</a></li>
          <li><a href="https://en.wikipedia.org/wiki/Federal_Information_Processing_Standard_state_code" target="_blank" rel="noopener noreferrer">FIPS overview (Wikipedia)</a></li>
        </ul>
        <p class="reference-hint">Tip: use the two-digit state FIPS code (e.g., <code>47</code> for Tennessee, <code>06</code> for California) in the State filter above.</p>
      `;
    }

    async function initSourcePicker() {
      const sources = await fetchSources();
      loadingState?.setAttribute('hidden', '');
      sourcePicker?.removeAttribute('hidden');

      if (!sourceList) return;
      sourceList.innerHTML = sources
        .map(
          (s) =>
            `<li class="source-card">
              <a href="${withBasePath(`/data-preview?source=${encodeURIComponent(s.id)}`)}">
                <span class="source-card-title">${s.title}</span>
                ${s.id === 'census-county-estimates-all-2025' ? '<span class="demo-badge">Demo</span>' : ''}
              </a>
            </li>`,
        )
        .join('');
    }

    async function initPreview() {
      sourceId = getSourceIdFromUrl();
      if (!sourceId) {
        return initSourcePicker();
      }

      const [source, datasheet] = await Promise.all([
        fetchSource(sourceId),
        fetchDatasheet(sourceId),
      ]);

      focalVariable = pickFocalVariable(source);
      initialStateFilter = pickInitialState(source);

      showPreviewContent();
      document.title = `${source.title} | Community Data Libraries`;

      const titleEl = document.getElementById('source-title');
      const descEl = document.getElementById('source-description');
      const providerEl = document.getElementById('source-provider');
      const downloadBtn = document.getElementById('download-btn') as HTMLAnchorElement;
      const accountWarning = document.getElementById('account-warning');

      if (titleEl) titleEl.textContent = source.title;
      if (descEl) descEl.textContent = buildCatalogDescription(source);
      if (providerEl && source.provider?.name) {
        const agency = source.provider.agency ? ` · ${source.provider.agency}` : '';
        providerEl.textContent = `${source.provider.name}${agency}`;
        providerEl.removeAttribute('hidden');
      }
      if (downloadBtn && source.download?.url) downloadBtn.href = source.download.url;
      if (accountWarning && source.requires_account) accountWarning.removeAttribute('hidden');

      renderTags('topical-tags', normalizeDescriptionTags(source.description_tags), true);
      renderTags('pedagogical-tags', getPedagogicalTags(source));
      renderTags('geographic-tags', getGeographicTags(source));

      const dsWho = document.getElementById('ds-who');
      const dsHow = document.getElementById('ds-how');
      const dsWhere = document.getElementById('ds-where');
      const dsWhy = document.getElementById('ds-why');
      const dsWhen = document.getElementById('ds-when');
      if (dsWho) dsWho.textContent = datasheet.who;
      if (dsHow) dsHow.textContent = datasheet.how;
      if (dsWhere) dsWhere.textContent = datasheet.where;
      if (dsWhy) dsWhy.textContent = datasheet.why;
      if (dsWhen) dsWhen.textContent = datasheet.when;

      const geoTags = getGeographicTags(source);
      try {
        if (geoTags.includes('state') && stateFilter && stateFilterWrap) {
          stateFilterWrap.removeAttribute('hidden');
          const stateOptions = await fetchFilterOptions(sourceId, 'state');
          stateFilter.innerHTML =
            '<option value="">All states</option>' +
            stateOptions
              .map(
                (o) =>
                  `<option value="${o.value}" ${o.value === initialStateFilter ? 'selected' : ''}>${o.label}</option>`,
              )
              .join('');
        } else if (stateFilterWrap) {
          stateFilterWrap.setAttribute('hidden', '');
        }

        if (geoTags.includes('county') && countyFilterWrap) {
          countyFilterWrap.removeAttribute('hidden');
          await loadCountyOptions(stateFilter?.value || initialStateFilter || undefined);
        } else if (countyFilterWrap) {
          countyFilterWrap.setAttribute('hidden', '');
        }
      } catch (filterError) {
        console.warn('Filter options unavailable:', filterError);
      }

      if (variableFilter) {
        const numericVars =
          source.variable_report
            ?.filter((v) => v.type === 'integer' || v.type === 'float')
            .map((v) => v.name) ?? getSourceVariables(source);

        const uniqueVars = [...new Set(numericVars.filter(Boolean))];
        const options = uniqueVars.length > 0 ? uniqueVars : [focalVariable].filter(Boolean);
        variableFilter.innerHTML = options
          .map(
            (v) =>
              `<option value="${v}" ${v === focalVariable ? 'selected' : ''}>${v.replace(/_/g, ' ')}</option>`,
          )
          .join('');
      }

      let defaultX = '';
      if (xVariableFilter) {
        const report = source.variable_report ?? [];
        const allCols = getSourceVariables(source);
        const numericNames = new Set(
          report.filter((v) => v.type === 'integer' || v.type === 'float').map((v) => v.name),
        );
        // Non-numeric (label/time) columns first, then numeric
        const nonNumeric = report
          .filter((v) => !numericNames.has(v.name))
          .map((v) => v.name)
          .filter((n) => allCols.includes(n));
        const numeric = [...numericNames].filter((n) => allCols.includes(n));
        const ordered = [...new Set([...nonNumeric, ...numeric, ...allCols])];
        const xOptions = ordered.length > 0 ? ordered : allCols;
        xVariableOptions = xOptions.map((v) => ({ value: v, numeric: numericNames.has(v) }));
        // Auto-detect default X: first temporal column or first column
        const temporalNames = ['YEAR', 'DATE', 'PERIOD', 'TIMEPERIOD_NAME'];
        defaultX =
          xOptions.find((v) => temporalNames.includes(v.toUpperCase())) ?? xOptions[0] ?? '';
        renderXVariableOptions('bar', defaultX);
      }

      populateReferenceCard(source);

      await refreshPreviewAndChart();

      stateFilter?.addEventListener('change', async () => {
        await loadCountyOptions(stateFilter.value);
        if (countyFilter) countyFilter.value = '';
        await refreshPreviewAndChart();
      });
      countyFilter?.addEventListener('change', refreshPreviewAndChart);
      variableFilter?.addEventListener('change', refreshPreviewAndChart);
      xVariableFilter?.addEventListener('change', refreshPreviewAndChart);
      plotTypeFilter?.addEventListener('change', async () => {
        renderXVariableOptions(plotTypeFilter.value, xVariableFilter?.value);
        await refreshPreviewAndChart();
      });
    }

    // Scatter needs two numeric axes, so its X list is narrowed to numeric columns.
    // Bar/Line can group by any column. Keeps the current selection when it's still
    // valid for the new plot type, otherwise falls back to the first option.
    function renderXVariableOptions(plotType: string, preferredValue: string | undefined) {
      if (!xVariableFilter) return;
      const pool =
        plotType === 'scatter' ? xVariableOptions.filter((o) => o.numeric) : xVariableOptions;
      const selected = pool.some((o) => o.value === preferredValue)
        ? preferredValue
        : (pool[0]?.value ?? '');
      xVariableFilter.innerHTML = pool
        .map(
          (o) =>
            `<option value="${o.value}" ${o.value === selected ? 'selected' : ''}>${o.value.replace(/_/g, ' ')}</option>`,
        )
        .join('');
    }

    const urlParams = new URLSearchParams(window.location.search);

    if (urlParams.has('source')) {
      initPreview().catch((err) => showError(err instanceof Error ? err.message : String(err)));
    } else {
      initSourcePicker().catch((err) => showError(err instanceof Error ? err.message : String(err)));
    }
  </script>

