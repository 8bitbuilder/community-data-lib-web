---
import { existsSync, readFileSync } from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import { withBasePath } from '@lib/paths';
import MetadataEditor from '@components/MetadataEditor.astro';
import {
  buildCatalogDescription,
  getGeographicDisplayTags,
  getGeographicTags,
  getPedagogicalTags,
  normalizeDescriptionTags,
  type BackendSource,
} from '@lib/api/backend';
import { previewUnavailableReason } from '@lib/data/previewSupport';
import type { PreviewIndexEntry } from '@lib/data/staticPreview';
import { buildDatasheet } from '../../backend/lib/datasheet.mjs';

// Everything on this page is built ahead of time. Dataset details come from the
// backend's SQLite export (mirrored to backend/data/exports/catalog.json by
// prebuild); rows come from the static Tier 1 preview files that
// `npm run sync:previews` copies into public/previews/. No preview server is involved.
const tutorialHref = withBasePath('/data-resources');
const catalogHref = withBasePath('/complete-catalog');

function readJson<T>(relative: string): T | null {
  const file = path.join(process.cwd(), relative);
  return existsSync(file) ? (JSON.parse(readFileSync(file, 'utf8')) as T) : null;
}

/** Flatten nested analysis tag sets into the source shape the tag helpers expect. */
function toSource({ analysis_tags: analysisTags = {}, ...rest }: Record<string, unknown>): BackendSource {
  return { ...(analysisTags as object), ...rest } as BackendSource;
}

const catalog = readJson<{ sources: Record<string, unknown>[] }>('backend/data/exports/catalog.json');
const previewIndex = readJson<{ sources: Record<string, PreviewIndexEntry> }>('public/previews/index.json')?.sources;

const sources = Object.fromEntries(
  (catalog?.sources ?? [])
    .map(toSource)
    .sort((a, b) => a.title.localeCompare(b.title))
    .map((source) => {
      const preview = previewIndex?.[source.id];
      const agency = source.provider?.agency ? ` · ${source.provider.agency}` : '';
      return [
        source.id,
        {
          id: source.id,
          title: source.title,
          provider: source.provider?.name ? `${source.provider.name}${agency}` : '',
          providerUrl: source.provider?.url ?? '',
          downloadUrl: source.download?.url ?? '',
          requiresAccount: Boolean(source.requires_account),
          description: buildCatalogDescription(source),
          topical: normalizeDescriptionTags(source.description_tags),
          pedagogical: getPedagogicalTags(source),
          geographic: getGeographicDisplayTags(source),
          fipsReference: getGeographicTags(source).some((tag) => tag === 'state' || tag === 'county'),
          datasheet: buildDatasheet(source),
          unavailable: previewUnavailableReason(source, preview),
          counties: preview?.counties ?? 0,
        },
      ];
    })
);

// ?community=<slug> preselects that library's county slice.
const communities = Object.fromEntries(
  (await getCollection('communities'))
    .filter((c) => c.data.county_fips)
    .map((c) => [
      c.data.slug,
      {
        name: c.data.name,
        county_fips: c.data.county_fips,
        label: [c.data.county, c.data.state_code].filter(Boolean).join(', '),
      },
    ])
);

const pageData = {
  sources,
  communities,
  previewBase: withBasePath('/previews'),
  countyNamesUrl: withBasePath('/geo/county-names.json'),
};
---

<Layout title="Data Preview" description="Preview of each dataset in the catalog: details, sample rows, county slices and summary statistics">
  <Fragment slot="head">
    <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.54.1/dist/apexcharts.min.js" is:inline></script>
  </Fragment>

  <section class="preview-page" id="preview-page">
    <MetadataEditor />
    <div id="loading-state" class="status-panel">
      <div class="loading-spinner" aria-hidden="true"></div>
      <p>Loading dataset preview…</p>
    </div>

    <div id="error-state" class="status-panel error-panel" hidden>
      <h2>Unable to load preview</h2>
      <p id="error-message"></p>
    </div>

    <div id="source-picker" class="source-picker" hidden>
      <nav class="preview-breadcrumb" aria-label="Breadcrumb">
        <a href={catalogHref} class="back-link">← Complete Catalog</a>
      </nav>
      <h1 class="page-title">Data Preview</h1>
      <p class="page-intro">Select a dataset to see its details, a sample of its rows and summary statistics.</p>
      <ul id="source-list" class="source-grid"></ul>
    </div>

    <div id="preview-content" hidden>
      <nav class="preview-breadcrumb" aria-label="Breadcrumb">
        <a href={catalogHref} class="back-link">← Complete Catalog</a>
      </nav>

      <header class="preview-header">
        <div class="header-main">
          <h1 class="page-title" id="source-title"></h1>
          <p class="source-provider" id="source-provider" hidden></p>
          <div class="description-card" id="source-description"></div>
          <p class="audience-note" id="audience-note" hidden></p>
          <p class="account-warning" id="account-warning" hidden>
            <span class="warning-icon" aria-hidden="true">!</span>
            Requires a free account for downloads.
          </p>
        </div>
      </header>

      <div class="meta-actions-row panel-card">
        <div class="tags-panel">
          <div class="tag-group">
            <span class="tag-label">Topical</span>
            <div class="tag-chips" id="topical-tags"></div>
          </div>
          <div class="tag-group">
            <span class="tag-label">Pedagogical</span>
            <div class="tag-chips" id="pedagogical-tags"></div>
          </div>
          <div class="tag-group">
            <span class="tag-label">Geographic</span>
            <div class="tag-chips" id="geographic-tags"></div>
          </div>
        </div>

        <div class="actions-panel">
          <span class="actions-label">Get the data</span>
          <div class="action-buttons">
            <a id="download-btn" class="btn-download" href="#" target="_blank" rel="noopener noreferrer">
              <span class="btn-icon" aria-hidden="true">↓</span>
              Download
            </a>
            <a class="btn-tutorial" href={tutorialHref}>See tutorial</a>
          </div>
        </div>
      </div>

      <div class="middle-row">
        <aside class="datasheet-panel panel-card">
          <h2 class="section-title">Datasheet</h2>
          <dl class="datasheet-list">
            <div class="datasheet-item"><dt>Who</dt><dd id="ds-who"></dd></div>
            <div class="datasheet-item"><dt>How</dt><dd id="ds-how"></dd></div>
            <div class="datasheet-item"><dt>Where</dt><dd id="ds-where"></dd></div>
            <div class="datasheet-item"><dt>Why</dt><dd id="ds-why"></dd></div>
            <div class="datasheet-item"><dt>When</dt><dd id="ds-when"></dd></div>
          </dl>
        </aside>

        <div class="chart-panel panel-card">
          <div class="chart-header">
            <h2 class="section-title" id="chart-title">Focal variable plot</h2>
            <div class="chart-controls" id="chart-controls">
              <label class="filter-control" id="state-filter-wrap" hidden>
                <span>State</span>
                <select id="state-filter">
                  <option value="">First rows (all places)</option>
                </select>
              </label>
              <label class="filter-control" id="county-filter-wrap" hidden>
                <span>County</span>
                <select id="county-filter" disabled>
                  <option value="">Choose a state first</option>
                </select>
              </label>
              <label class="filter-control" id="x-variable-filter-wrap">
                <span>X Variable</span>
                <select id="x-variable-filter"></select>
              </label>
              <label class="filter-control">
                <span>Y Variable</span>
                <select id="variable-filter"></select>
              </label>
              <label class="filter-control">
                <span>Plot Type</span>
                <select id="plot-type-filter">
                  <option value="bar">Bar</option>
                  <option value="line">Line</option>
                  <option value="scatter">Scatter</option>
                </select>
              </label>
            </div>
          </div>
          <p class="slice-note" id="slice-note" aria-live="polite" hidden></p>
          <details class="reference-card" id="reference-card" hidden>
            <summary class="reference-summary">Reference &amp; Guidance</summary>
            <div class="reference-body">
              <ul class="reference-links">
                <li>
                  <a href="https://www.census.gov/library/reference/code-lists/ansi/ansi-codes-for-states.html" target="_blank" rel="noopener noreferrer">State FIPS Codes (Census.gov)</a>
                  — two-digit numeric codes used for each U.S. state/territory
                </li>
                <li>
                  <a href="https://www.census.gov/library/reference/code-lists/ansi.html" target="_blank" rel="noopener noreferrer">County FIPS Codes (Census.gov)</a>
                  — five-digit codes (state + county)
                </li>
                <li>
                  <a href="https://en.wikipedia.org/wiki/Federal_Information_Processing_Standard_state_code" target="_blank" rel="noopener noreferrer">FIPS overview (Wikipedia)</a>
                </li>
              </ul>
              <p class="reference-hint">Tip: pick a state and county above to see only that county's rows.</p>
            </div>
          </details>
          <div id="preview-unavailable" class="preview-unavailable" hidden>
            <p id="preview-unavailable-message"></p>
            <a id="preview-unavailable-link" class="btn-download" href="#" target="_blank" rel="noopener noreferrer" hidden>
              Visit the provider ↗
            </a>
          </div>
          <div class="chart-canvas-wrap">
            <p id="chart-note" class="chart-note" hidden></p>
            <div id="chart-loading" class="section-loading" hidden>Loading chart…</div>
            <div id="focal-chart" aria-label="Focal variable chart"></div>
          </div>
        </div>
      </div>

      <div class="table-panel panel-card">
        <div class="table-header">
          <h2 class="section-title">Data preview</h2>
          <p class="table-meta" id="table-meta"></p>
          <p class="table-meta" id="table-columns-note" hidden></p>
        </div>
        <div class="table-scroll">
          <div id="table-loading" class="section-loading table-section-loading" hidden>Loading table…</div>
          <div class="data-grid" id="preview-grid" role="grid" aria-label="Dataset preview">
            <div class="data-grid-header" id="preview-grid-header"></div>
            <div class="data-grid-body" id="preview-grid-body"></div>
          </div>
        </div>
      </div>

      <details class="summary-panel panel-card" id="summary-panel" hidden>
        <summary class="summary-toggle">Summary statistics for every row</summary>
        <div class="summary-body" id="summary-body">
          <p class="table-meta">Loading…</p>
        </div>
      </details>
    </div>
  </section>

  <script type="application/json" id="preview-data" set:html={JSON.stringify(pageData)} />

  <script>
    import { withBasePath } from '@lib/paths';
    import {
      audienceNote,
      chooseSlice,
      communityCounty,
      countyFileUrl,
      defaultXVariable,
      meanByGroup,
      numericVariables,
      pickFocalVariable,
      previewFileUrl,
      rowsMeta,
      scatterPoints,
      tableColumns,
      xVariableOptions,
      type CommunityCounty,
      type PreviewManifest,
      type PreviewVariable,
      type RowFile,
    } from '@lib/data/staticPreview';

    interface SourceModel {
      id: string;
      title: string;
      provider: string;
      providerUrl: string;
      downloadUrl: string;
      requiresAccount: boolean;
      description: string;
      topical: string[];
      pedagogical: string[];
      geographic: string[];
      fipsReference: boolean;
      datasheet: { who: string; how: string; where: string; why: string; when: string };
      unavailable: string | null;
      counties: number;
    }
    interface SummaryColumn {
      name: string;
      type: string;
      count: number;
      missing: number;
      unique: number;
      unique_at_least?: boolean;
      min?: number;
      max?: number;
      mean?: number;
      median?: number;
      top?: [string, number][];
    }
    interface VariablesFile {
      columns: PreviewVariable[];
    }
    interface SummaryFile {
      rows: number;
      columns: SummaryColumn[];
    }
    interface CountyNames {
      states: Record<string, string>;
      counties: Record<string, [string, string]>;
    }

    // Rows drawn in the table; the chart uses every row of the current slice.
    const TABLE_ROWS = 100;

    const page = JSON.parse(document.getElementById('preview-data')?.textContent ?? '{}') as {
      sources: Record<string, SourceModel>;
      communities: Record<string, CommunityCounty>;
      previewBase: string;
      countyNamesUrl: string;
    };

    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const stateFilter = $('state-filter') as HTMLSelectElement;
    const countyFilter = $('county-filter') as HTMLSelectElement;
    const variableFilter = $('variable-filter') as HTMLSelectElement;
    const xVariableFilter = $('x-variable-filter') as HTMLSelectElement;
    const plotTypeFilter = $('plot-type-filter') as HTMLSelectElement;

    let chartInstance: { destroy(): void; render(): void } | null = null;
    let variables: PreviewVariable[] = [];
    let manifest: PreviewManifest;
    let sample: RowFile;
    let current: { file: RowFile; scope: string } = { file: { rows: [], rows_included: 0, rows_total: 0 }, scope: 'the dataset' };
    let countyNames: CountyNames | null = null;

    async function getJson(url: string): Promise<unknown> {
      const response = await fetch(url);
      if (!response.ok) throw new Error(`Could not load ${url} (HTTP ${response.status}).`);
      return response.json();
    }

    function showError(message: string) {
      $('loading-state').hidden = true;
      $('preview-content').hidden = true;
      $('source-picker').hidden = true;
      $('error-state').hidden = false;
      $('error-message').textContent = message;
    }

    function escapeHtml(value: unknown) {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function isNumericCell(value: unknown) {
      const text = String(value ?? '').trim();
      return text !== '' && !Number.isNaN(Number(text.replace(/,/g, '')));
    }

    function formatNumber(n: number) {
      if (Number.isInteger(n)) return Math.abs(n) >= 1000 ? n.toLocaleString() : String(n);
      return n.toLocaleString(undefined, { maximumFractionDigits: 2 });
    }

    // Years, IDs and codes are labels, not quantities: no thousands separators.
    const IDENTIFIER_COLUMN = /year|\bid\b|code|fips|zip|trifd|geoid/i;

    function formatCell(value: unknown, column: string) {
      if (!isNumericCell(value) || IDENTIFIER_COLUMN.test(column)) return String(value ?? '');
      return formatNumber(Number(String(value).replace(/,/g, '')));
    }

    function renderTags(containerId: string, tags: string[], filledFirst = false) {
      const container = $(containerId);
      container.replaceChildren();
      if (!tags.length) {
        container.innerHTML = '<span class="tag-chip tag-outline">Not specified</span>';
        return;
      }
      tags.forEach((tag, i) => {
        const chip = document.createElement('span');
        chip.className = `tag-chip ${filledFirst && i === 0 ? 'tag-filled' : 'tag-outline'}`;
        // Keep the comma inside the chip so the flex gap only falls after it.
        chip.textContent = i < tags.length - 1 ? `${tag},` : tag;
        container.appendChild(chip);
      });
    }

    function initSourcePicker() {
      $('loading-state').hidden = true;
      $('source-picker').hidden = false;
      $('source-list').innerHTML = Object.values(page.sources)
        .map(
          (s) => `<li class="source-card">
              <a href="${withBasePath(`/data-preview?source=${encodeURIComponent(s.id)}`)}">
                <span class="source-card-title">${escapeHtml(s.title)}</span>
                ${s.unavailable ? '<span class="info-badge">Info only</span>' : ''}
                ${s.counties > 0 ? '<span class="demo-badge">By county</span>' : ''}
              </a>
            </li>`
        )
        .join('');
    }

    function renderDetails(source: SourceModel) {
      document.title = `${source.title} | Community Data Libraries`;
      $('source-title').textContent = source.title;
      $('source-description').textContent = source.description;
      if (source.provider) {
        $('source-provider').textContent = source.provider;
        $('source-provider').hidden = false;
      }
      const note = audienceNote(window.location.search);
      if (note) {
        $('audience-note').textContent = note;
        $('audience-note').hidden = false;
      }
      const download = $('download-btn') as HTMLAnchorElement;
      if (source.downloadUrl) download.href = source.downloadUrl;
      else if (source.providerUrl) {
        download.href = source.providerUrl;
        download.textContent = 'Visit provider ↗';
      } else download.hidden = true;
      $('account-warning').hidden = !source.requiresAccount;

      renderTags('topical-tags', source.topical, true);
      renderTags('pedagogical-tags', source.pedagogical);
      renderTags('geographic-tags', source.geographic);
      for (const key of ['who', 'how', 'where', 'why', 'when'] as const) {
        $(`ds-${key}`).textContent = source.datasheet[key];
      }
    }

    // Info-only sources: keep the description and datasheet, replace chart and table.
    function showPreviewUnavailable(message: string, providerUrl: string) {
      $('chart-title').textContent = 'Data preview';
      $('chart-controls').hidden = true;
      (document.querySelector('.chart-canvas-wrap') as HTMLElement).hidden = true;
      (document.querySelector('.table-panel') as HTMLElement).hidden = true;
      $('preview-unavailable').hidden = false;
      $('preview-unavailable-message').textContent = message;
      const link = $('preview-unavailable-link') as HTMLAnchorElement;
      if (providerUrl) {
        link.href = providerUrl;
        link.hidden = false;
      }
    }

    function fillVariableSelects() {
      const focal = pickFocalVariable(variables);
      const numeric = numericVariables(variables);
      variableFilter.innerHTML = numeric
        .map((v) => `<option value="${escapeHtml(v)}" ${v === focal ? 'selected' : ''}>${escapeHtml(v.replace(/_/g, ' '))}</option>`)
        .join('');
      renderXVariableOptions('bar', defaultXVariable(variables, 'bar'));
    }

    // Scatter needs two numeric axes, so its X list is narrowed to numeric columns.
    // Keeps the current selection when it's still valid for the new plot type.
    function renderXVariableOptions(plotType: string, preferred: string | undefined) {
      const pool = xVariableOptions(variables, plotType);
      const selected = preferred && pool.includes(preferred) ? preferred : (pool[0] ?? '');
      xVariableFilter.innerHTML = pool
        .map((v) => `<option value="${escapeHtml(v)}" ${v === selected ? 'selected' : ''}>${escapeHtml(v.replace(/_/g, ' '))}</option>`)
        .join('');
    }

    const plural = (n: number, word: string) => `${n.toLocaleString()} ${n === 1 ? word : `${word}s`}`;

    const columnIndex = (name: string) => variables.findIndex((v) => v.name === name);

    function renderChart() {
      const container = $('focal-chart');
      const Apex = (window as unknown as { ApexCharts?: new (el: HTMLElement, options: object) => { destroy(): void; render(): void } }).ApexCharts;
      chartInstance?.destroy();
      chartInstance = null;
      const note = $('chart-note');
      const yName = variableFilter.value;
      const xName = xVariableFilter.value;
      const plotType = plotTypeFilter.value;
      const rows = current.file.rows;
      if (!Apex || !yName || !xName) {
        note.textContent = 'This dataset has no numeric column to chart.';
        note.hidden = false;
        return;
      }
      const yIndex = columnIndex(yName);
      const xIndex = columnIndex(xName);
      const axisStyle = { fontSize: '11px', colors: '#52606D' };

      if (plotType === 'scatter') {
        const points = scatterPoints(rows, xIndex, yIndex);
        note.textContent = `Each point is one row of the ${plural(rows.length, 'row')} loaded.`;
        note.hidden = false;
        chartInstance = new Apex(container, {
          chart: { type: 'scatter', height: 300, toolbar: { show: false }, fontFamily: 'Outfit, sans-serif', zoom: { enabled: true, type: 'xy' } },
          series: [{ name: yName, data: points }],
          xaxis: { title: { text: xName, style: { fontSize: '11px', color: '#52606D' } }, labels: { style: axisStyle }, tickAmount: 6 },
          yaxis: { title: { text: yName, style: { fontSize: '11px', color: '#52606D' } }, labels: { style: axisStyle } },
          colors: ['#155E75'],
          dataLabels: { enabled: false },
          grid: { strokeDashArray: 4, borderColor: '#D2DEE6' },
          tooltip: { theme: 'light', x: { formatter: (v: number) => Number(v).toLocaleString() }, y: { formatter: (v: number) => Number(v).toLocaleString() } },
        });
        chartInstance.render();
        return;
      }

      const series = meanByGroup(rows, xIndex, yIndex);
      // Bar and Line plots average the Y values within each X value; say so.
      const mark = plotType === 'line' ? 'Each point' : 'Each bar';
      note.textContent = `${mark} shows the average (mean) ${yName} for that ${xName}, over the ${plural(rows.length, 'row')} loaded.`;
      note.hidden = false;
      const labels = series.map((p) => p.label);
      chartInstance = new Apex(container, {
        chart: { type: plotType === 'line' ? 'line' : 'bar', height: 300, toolbar: { show: false }, fontFamily: 'Outfit, sans-serif' },
        series: [{ name: yName, data: series.map((p) => p.value) }],
        xaxis: {
          categories: labels,
          labels: { rotate: labels.length > 8 ? -45 : 0, trim: true, hideOverlappingLabels: true, style: axisStyle },
          axisBorder: { show: false },
          axisTicks: { show: false },
        },
        yaxis: {
          labels: {
            style: axisStyle,
            formatter: (v: number) => {
              const n = Number(v);
              if (Math.abs(n) >= 1e9) return `${(n / 1e9).toFixed(1)}B`;
              if (Math.abs(n) >= 1e6) return `${(n / 1e6).toFixed(1)}M`;
              if (Math.abs(n) >= 1e3) return `${(n / 1e3).toFixed(0)}k`;
              return String(Math.round(n * 100) / 100);
            },
          },
        },
        colors: ['#155E75'],
        plotOptions: { bar: { borderRadius: 3, columnWidth: '60%' } },
        dataLabels: { enabled: false },
        grid: { strokeDashArray: 4, borderColor: '#D2DEE6', xaxis: { lines: { show: false } } },
        tooltip: { theme: 'light', y: { formatter: (v: number) => Number(v).toLocaleString() } },
      });
      chartInstance.render();
    }

    // Narrow tables share the width (fr); wide ones cap each column, since in a
    // max-content grid every fr track grows to the longest header in the table.
    function gridWidth(name: string, numeric: boolean, wide: boolean) {
      const upper = name.toUpperCase();
      const [min, fr, cap] = numeric
        ? ['5.5rem', '1fr', '9rem']
        : /NAME|COUNTY|LABEL|TITLE|DESCRIPTION/.test(upper)
          ? ['9rem', '1.6fr', '16rem']
          : /STUSPS|STATE|FIPS|GEOID|ID|CODE/.test(upper)
            ? ['4.5rem', '0.75fr', '8rem']
            : ['7rem', '1fr', '12rem'];
      return `minmax(${min}, ${wide ? cap : fr})`;
    }

    function renderTable() {
      const grid = $('preview-grid');
      const rows = current.file.rows.slice(0, TABLE_ROWS);
      const shown = tableColumns(variables.length, [columnIndex(xVariableFilter.value), columnIndex(variableFilter.value)]);
      const numeric = shown.map((i) => variables[i].type === 'number');
      const template = shown.map((i, k) => gridWidth(variables[i].name, numeric[k], shown.length > 12)).join(' ');
      grid.style.setProperty('--grid-template', template);
      grid.style.gridTemplateColumns = template;
      grid.setAttribute('aria-colcount', String(shown.length));
      grid.setAttribute('aria-rowcount', String(rows.length + 1));
      $('preview-grid-header').innerHTML = `<div class="grid-row" role="row">${shown
        .map((i, k) => {
          const v = variables[i];
          return `<div class="grid-cell grid-header ${numeric[k] ? 'col-numeric' : ''}" role="columnheader" title="${escapeHtml(v.code ? `${v.name} (${v.code})` : v.name)}">${escapeHtml(v.name.replace(/_/g, ' '))}</div>`;
        })
        .join('')}</div>`;
      $('preview-grid-body').innerHTML = rows
        .map(
          (row, r) =>
            `<div class="grid-row ${r % 2 === 0 ? 'row-even' : 'row-odd'}" role="row">${shown
              .map((i, k) => `<div class="grid-cell ${numeric[k] ? 'col-numeric' : ''}" role="gridcell" title="${escapeHtml(row[i])}">${escapeHtml(formatCell(row[i], variables[i].name))}</div>`)
              .join('')}</div>`
        )
        .join('');
      $('table-meta').textContent = rowsMeta(current.file, rows.length, current.scope);
      const columnsNote = $('table-columns-note');
      columnsNote.hidden = shown.length === variables.length;
      columnsNote.textContent = `Showing ${shown.length} of ${variables.length} columns (the first ones plus the charted variables). Download the file for every column.`;
    }

    function refresh() {
      renderTable();
      renderChart();
    }

    async function loadCountyNames() {
      countyNames ??= (await getJson(page.countyNamesUrl)) as CountyNames;
      return countyNames;
    }

    const countyLabel = (names: CountyNames, fips: string) => {
      const county = names.counties[fips];
      return county ? `${county[0]}, ${county[1]}` : fips;
    };

    async function setupCountyPicker() {
      const counties = manifest.county?.counties ?? [];
      if (counties.length === 0) return;
      const names = await loadCountyNames();
      const states = [...new Set(counties.map((fips) => fips.slice(0, 2)))].sort((a, b) =>
        (names.states[a] ?? a).localeCompare(names.states[b] ?? b)
      );
      stateFilter.append(...states.map((s) => new Option(names.states[s] ?? s, s)));
      $('state-filter-wrap').hidden = false;
      $('county-filter-wrap').hidden = false;
      stateFilter.addEventListener('change', () => {
        fillCountyOptions(stateFilter.value);
        if (!stateFilter.value) showSample(null);
      });
      countyFilter.addEventListener('change', () => {
        if (countyFilter.value) showCounty(countyFilter.value, countyLabel(names, countyFilter.value), null).catch(onError);
      });
    }

    function fillCountyOptions(stateFips: string) {
      const names = countyNames;
      const options = (manifest.county?.counties ?? [])
        .filter((fips) => fips.startsWith(stateFips))
        .map((fips) => new Option(names?.counties[fips]?.[0] ?? fips, fips))
        .sort((a, b) => a.text.localeCompare(b.text));
      countyFilter.replaceChildren(new Option(stateFips ? 'Choose a county' : 'Choose a state first', ''), ...options);
      countyFilter.disabled = !stateFips;
    }

    function setSliceNote(text: string | null) {
      const note = $('slice-note');
      note.textContent = text ?? '';
      note.hidden = !text;
    }

    function showSample(note: string | null) {
      current = { file: sample, scope: 'the dataset' };
      setSliceNote(note);
      refresh();
    }

    async function showCounty(fips: string, label: string, note: string | null) {
      $('table-loading').hidden = false;
      try {
        const file = (await getJson(countyFileUrl(page.previewBase, manifest.id, fips))) as RowFile;
        current = { file, scope: label };
        stateFilter.value = fips.slice(0, 2);
        fillCountyOptions(fips.slice(0, 2));
        countyFilter.value = fips;
        setSliceNote(note ?? `Showing the rows for ${label}.`);
        refresh();
      } finally {
        $('table-loading').hidden = true;
      }
    }

    function renderSummary(columns: SummaryColumn[], rows: number) {
      const cell = (value: number | undefined) => (value === undefined ? '' : formatNumber(value));
      $('summary-body').innerHTML = `
        <p class="table-meta">Computed over all ${rows.toLocaleString()} rows of the downloaded file.</p>
        <div class="summary-scroll"><table class="summary-table">
          <thead><tr><th scope="col">Variable</th><th scope="col">Type</th><th scope="col">Filled</th><th scope="col">Missing</th>
            <th scope="col">Distinct</th><th scope="col">Min</th><th scope="col">Mean</th><th scope="col">Median</th><th scope="col">Max</th><th scope="col">Most common</th></tr></thead>
          <tbody>${columns
            .map(
              (c) => `<tr><th scope="row">${escapeHtml(c.name)}</th><td>${escapeHtml(c.type)}</td><td>${c.count.toLocaleString()}</td>
                <td>${c.missing.toLocaleString()}</td><td>${c.unique.toLocaleString()}${c.unique_at_least ? '+' : ''}</td>
                <td>${cell(c.min)}</td><td>${cell(c.mean)}</td><td>${cell(c.median)}</td><td>${cell(c.max)}</td>
                <td>${escapeHtml((c.top ?? []).slice(0, 3).map(([v, n]) => `${v} (${n.toLocaleString()})`).join('; '))}</td></tr>`
            )
            .join('')}</tbody>
        </table></div>`;
    }

    function onError(err: unknown) {
      setSliceNote(err instanceof Error ? err.message : String(err));
    }

    async function initPreview(sourceId: string) {
      const source = page.sources[sourceId];
      if (!source) throw new Error(`No dataset with the id "${sourceId}" is in the catalog.`);
      $('loading-state').hidden = true;
      $('preview-content').hidden = false;
      renderDetails(source);
      if (source.unavailable) {
        showPreviewUnavailable(source.unavailable, source.providerUrl);
        return;
      }

      const file = (name: string) => previewFileUrl(page.previewBase, source.id, name);
      $('chart-loading').hidden = false;
      $('table-loading').hidden = false;
      let loaded: [PreviewManifest, VariablesFile, RowFile];
      try {
        loaded = (await Promise.all([
          getJson(file('manifest.json')),
          getJson(file('variables.json')),
          getJson(file('sample.json')),
        ])) as [PreviewManifest, VariablesFile, RowFile];
      } finally {
        $('chart-loading').hidden = true;
        $('table-loading').hidden = true;
      }
      [manifest, { columns: variables }, sample] = loaded;
      fillVariableSelects();
      $('reference-card').hidden = !(source.fipsReference || manifest.county);

      const summaryPanel = $('summary-panel') as HTMLDetailsElement;
      summaryPanel.hidden = false;
      summaryPanel.addEventListener(
        'toggle',
        () => {
          getJson(file('summary.json'))
            .then((summary) => renderSummary((summary as SummaryFile).columns, (summary as SummaryFile).rows))
            .catch((err) => ($('summary-body').textContent = err instanceof Error ? err.message : String(err)));
        },
        { once: true }
      );

      await setupCountyPicker().catch((err) => console.warn('County names unavailable:', err));

      const params = new URLSearchParams(window.location.search);
      const community = communityCounty(params.get('community'), page.communities);
      const choice = chooseSlice(manifest, community ? { fips: community.county_fips, label: community.label } : null);
      if (choice.kind === 'county' && community) {
        await showCounty(choice.fips, community.label, `${choice.note} (${community.name})`);
      } else {
        showSample(choice.note);
      }

      variableFilter.addEventListener('change', refresh);
      xVariableFilter.addEventListener('change', refresh);
      plotTypeFilter.addEventListener('change', () => {
        renderXVariableOptions(plotTypeFilter.value, xVariableFilter.value);
        refresh();
      });
    }

    const sourceId = new URLSearchParams(window.location.search).get('source')?.trim() ?? '';
    if (sourceId) {
      initPreview(sourceId).catch((err) => showError(err instanceof Error ? err.message : String(err)));
    } else {
      initSourcePicker();
    }
  </script>

