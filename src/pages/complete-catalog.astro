---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { canAudienceAccess, extractPedagogicalTags, type AudienceRole } from '@lib/data/libraryAccess';
import { catalogEntryHref, withBasePath } from '@lib/paths';
import { entryCounties, type CoverageEntry } from '@lib/data/communityFilter';
import { buildBoundaryIndex } from '@lib/data/coverageMap';
import vocabulary from '@data/geo-vocabulary.json';

const resources = await getCollection('master-library');

// Non-audience filters (theme, search, sort) are now all applied client-side, which works in
// dev mode SSR and in static builds, so the server just renders every resource, newest first.
const sortedResources = [...resources].sort((l, r) => {
  const lt = l.data.publishedDate ? new Date(l.data.publishedDate).getTime() : 0;
  const rt = r.data.publishedDate ? new Date(r.data.publishedDate).getTime() : 0;
  return rt - lt;
});

// All unique themes (audience-independent for static compatibility)
const allThemes = [...new Set(
  resources.flatMap(r => r.data.dataThemes.length > 0 ? r.data.dataThemes : r.data.tags)
)].sort((a, b) => a.localeCompare(b));

// ── Pedagogical ──────────────────────────────────────────────────
const allPedagogicalTags = extractPedagogicalTags(resources);

// Proposed grouping of the tags already in the catalog. Matching ignores case.
const PEDAGOGICAL_CATEGORIES: { name: string; tags: string[] }[] = [
  {
    name: 'Civic and teaching',
    tags: ['civic-education', 'data-literacy', 'policy-analysis', 'quantitative-methods', 'social-justice'],
  },
  {
    name: 'Data type and scale',
    tags: [
      'all discrete', 'has categorical variable', 'has multiple numeric columns', 'mixed types',
      'multivariate', 'large dataset', 'medium dataset', 'large scale values', 'single digit values',
    ],
  },
  {
    name: 'Spread and distribution',
    tags: [
      'high variability', 'moderate variability', 'low variability', 'restricted range', 'wide range',
      'approximately normal', 'bimodal distribution', 'left skewed distribution',
      'right skewed distribution', 'symmetric distribution', 'contains outliers', 'extreme outliers',
      'passes normality test', 'fails normality test',
    ],
  },
  {
    name: 'Groups and summary statistics',
    tags: [
      'has group comparison candidates', 'has paired test candidates', 'two groups present',
      'multiple groups present', 'groups have different centers', 'groups have different spreads',
      'groups overlap substantially', 'has mode', 'mean median similar', 'mean median different',
      'meets minimum sample size', 'large enough for clt', 'meets equal variance assumption',
      'violates equal variance assumption',
    ],
  },
  {
    name: 'Relationships',
    tags: [
      'positive correlation', 'negative correlation', 'strong correlation', 'moderate correlation',
      'weak correlation', 'linear relationship', 'nonlinear relationship', 'curved relationship',
      'exponential pattern', 'good linear fit', 'moderate linear fit', 'poor linear fit',
      'has influential points', 'regression appropriate',
    ],
  },
  {
    name: 'Analysis methods',
    tags: [
      'good for one way anova', 'good for chi square gof', 'good for chi square independence',
      'good for one proportion z test', 'good for one sample t test', 'good for one sample z test',
      'good for paired t test', 'good for two sample t test', 'good for two sample z test',
      'good for two proportion z test', 'good for transformation',
    ],
  },
];
const normTag = (t: string) => t.trim().toLowerCase();
const mappedPedagogicalTags = new Set(PEDAGOGICAL_CATEGORIES.flatMap((c) => c.tags.map(normTag)));
const pedagogicalGroups = PEDAGOGICAL_CATEGORIES
  .map((c) => ({ name: c.name, tags: allPedagogicalTags.filter((t) => c.tags.map(normTag).includes(normTag(t))) }));
const unmappedPedagogicalTags = allPedagogicalTags.filter((t) => !mappedPedagogicalTags.has(normTag(t)));
if (unmappedPedagogicalTags.length > 0) {
  pedagogicalGroups.push({ name: 'Other', tags: unmappedPedagogicalTags });
}
const visiblePedagogicalGroups = pedagogicalGroups.filter((g) => g.tags.length > 0);

// ── Geographic ───────────────────────────────────────────────────
// Geography comes from each resource's `coverage` entries ({ level, geoid, counties? }), with the
// same meaning as the /maps page:
//   nation -> matches every state and county
//   state  -> matches that state and every county in it
//   county, tract, zip -> match their county (a ZIP can span several) and that county's state
// geo-vocabulary.json lists states with `usps`; BoundaryArea wants the USPS code in `state`.
const boundaryIndex = buildBoundaryIndex(
  vocabulary.states.map((s) => ({ geoid: s.geoid, name: s.name, state: s.usps })),
  vocabulary.counties
);
const stateLabel = (fips: string) => boundaryIndex.states.get(fips)?.name;
const countyLabel = (geoid: string) => boundaryIndex.counties.get(geoid)?.name ?? `County ${geoid}`;
const countyTitle = (geoid: string) => {
  const county = boundaryIndex.counties.get(geoid);
  return county ? `${county.name}, ${county.state}` : `County ${geoid}`;
};

function getGeoTags(resource: (typeof resources)[number]) {
  const coverage = ((resource.data as { coverage?: CoverageEntry[] }).coverage ?? []) as CoverageEntry[];
  const national = coverage.some((entry) => entry.level === 'nation');
  const states = new Set<string>();
  const statewide = new Set<string>();
  const counties = new Map<string, { state: string; county: string; title: string }>();

  for (const entry of coverage) {
    if (entry.level === 'state') {
      const state = stateLabel(entry.geoid);
      if (state) {
        states.add(state);
        statewide.add(state);
      }
    } else if (entry.level === 'county' || entry.level === 'tract' || entry.level === 'zip') {
      for (const geoid of entryCounties(entry)) {
        const state = stateLabel(geoid.slice(0, 2));
        if (!state) continue;
        states.add(state);
        const county = countyLabel(geoid);
        counties.set(`${state}::${county}`, { state, county, title: countyTitle(geoid) });
      }
    }
  }

  return {
    national,
    states: [...states].sort((a, b) => a.localeCompare(b)),
    statewide: [...statewide],
    counties: [...counties.values()],
  };
}

const geoById = new Map(resources.map((r) => [r.id, getGeoTags(r)]));

// Sidebar options: every state and county that appears in the data
const geoIndex = new Map<string, Set<string>>();
for (const geo of geoById.values()) {
  for (const state of geo.states) {
    if (!geoIndex.has(state)) geoIndex.set(state, new Set());
  }
  for (const { state, county } of geo.counties) geoIndex.get(state)!.add(county);
}
const geoStates = [...geoIndex.entries()]
  .map(([state, counties]) => ({ state, counties: [...counties].sort((a, b) => a.localeCompare(b)) }))
  .sort((a, b) => a.state.localeCompare(b.state));

function getGeoChips(resource: (typeof resources)[number]) {
  const geo = geoById.get(resource.id)!;
  return [
    ...geo.states.map((s) => ({ type: 'state', value: s, label: s, title: s })),
    ...geo.counties.map((c) => ({ type: 'county', value: `${c.state}::${c.county}`, label: c.county, title: c.title })),
  ];
}

function getGeoAttrs(resource: (typeof resources)[number]) {
  const geo = geoById.get(resource.id)!;
  return {
    national: geo.national ? 'true' : '',
    states: geo.states.join('|'),
    statewide: geo.statewide.join('|'),
    counties: geo.counties.map((c) => `${c.state}::${c.county}`).join('|'),
  };
}

// Number of options shown before "See more"
const FILTER_LIMIT = 5;

// Compute which audiences can access each resource (for data attributes)
function getResourceAudiences(resource: (typeof resources)[number]): string {
  const audiences: string[] = [];
  if (canAudienceAccess(resource, 'teacher')) audiences.push('teacher');
  if (canAudienceAccess(resource, 'student')) audiences.push('student');
  if (canAudienceAccess(resource, 'community')) audiences.push('community');
  return audiences.join(' ');
}

const suggestionHref = withBasePath('/submit');

function formatDate(date: Date | undefined): string {
  if (!date) return 'Not specified';
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

function getPreviewHref(resource: (typeof resources)[number]): string {
  return catalogEntryHref(resource.data, 'AUDIENCE_PLACEHOLDER');
}
---

<Layout title="Complete Catalog" description="All curated resources in the CDL complete catalog">
  <div class="catalog-page">

    <!-- ── Hero: title + search ─────────────────────────── -->
    <section class="catalog-hero">
      <div class="catalog-inner">
        <header class="content-header">
          <h1>Complete Catalog</h1>
          <p id="audience-label-text">
            Showing <strong>Complete Catalog</strong> view.
            All datasets are located here. Adjust filters on the left to locate a specific resource.
          </p>
        </header>

        <form class="search-form" id="catalog-search-form" role="search">
          <input type="search" name="q" placeholder="Search title, description, or themes" aria-label="Search the catalog" />
          <button type="submit" class="search-btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <span class="search-btn-label">Search</span>
          </button>
        </form>
      </div>
    </section>

    <div class="catalog-inner">
      <section class="library-page">
        <div class="sidebar-column">

          <section class="suggestion-block" aria-labelledby="suggestion-heading">
            <h2 id="suggestion-heading">Have a dataset suggestion?</h2>
            <p>Click here to submit a request to add a new dataset to our catalog.</p>
            <a class="button suggestion-cta" href={suggestionHref}>
              Suggest A Data Resource
            </a>
          </section>

          <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
              <h2>Filters</h2>
              <button class="sidebar-close" id="sidebar-close" aria-label="Close filters">✕</button>
            </div>
            <form class="filters-form" id="catalog-filter-form">

              <!-- Geographic -->
              <div class="filter-group" role="group" aria-labelledby="fg-geographic">
                <h3 class="filter-group-title" id="fg-geographic">Geographic</h3>
                {geoStates.length === 0 ? (
                  <p class="filter-empty">No geographic tags yet.</p>
                ) : (
                  <>
                    <ul class:list={['filter-list', { 'is-collapsed': geoStates.length > FILTER_LIMIT }]}>
                      {geoStates.map(({ state, counties }) => (
                        <li class="filter-item">
                          <div class="filter-row">
                            <label class="filter-check">
                              <input type="checkbox" name="state" value={state} />
                              <span>{state}</span>
                            </label>
                            {counties.length > 0 && (
                              <button type="button" class="sub-toggle" aria-expanded="false" aria-label={`Show counties in ${state}`}>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                              </button>
                            )}
                          </div>
                          {counties.length > 0 && (
                            <ul class="sub-list" hidden>
                              {counties.map((county) => (
                                <li>
                                  <label class="filter-check">
                                    <input type="checkbox" name="county" value={`${state}::${county}`} data-state={state} />
                                    <span>{county}</span>
                                  </label>
                                </li>
                              ))}
                            </ul>
                          )}
                        </li>
                      ))}
                    </ul>
                    {geoStates.length > FILTER_LIMIT && (
                      <button type="button" class="see-more" aria-expanded="false">See more</button>
                    )}
                  </>
                )}
              </div>

              <!-- Content -->
              <div class="filter-group" role="group" aria-labelledby="fg-content">
                <h3 class="filter-group-title" id="fg-content">Content</h3>
                <ul class:list={['filter-list', { 'is-collapsed': allThemes.length > FILTER_LIMIT }]}>
                  {allThemes.map((theme) => (
                    <li class="filter-item">
                      <label class="filter-check">
                        <input type="checkbox" name="theme" value={theme} />
                        <span>{theme}</span>
                      </label>
                    </li>
                  ))}
                </ul>
                {allThemes.length > FILTER_LIMIT && (
                  <button type="button" class="see-more" aria-expanded="false">See more</button>
                )}
              </div>

              <!-- Pedagogical -->
              <div class="filter-group" role="group" aria-labelledby="fg-pedagogical">
                <h3 class="filter-group-title" id="fg-pedagogical">Pedagogical</h3>
                {visiblePedagogicalGroups.length === 0 ? (
                  <p class="filter-empty">No pedagogical tags yet.</p>
                ) : (
                  visiblePedagogicalGroups.map((group) => (
                    <details class="ped-category">
                      <summary>{group.name}</summary>
                      <ul class="filter-list ped-list">
                        {group.tags.map((tag) => (
                          <li class="filter-item">
                            <label class="filter-check">
                              <input type="checkbox" name="pedagogicalTag" value={tag} />
                              <span>{tag}</span>
                            </label>
                          </li>
                        ))}
                      </ul>
                    </details>
                  ))
                )}
              </div>

              <div class="filter-actions">
                <button type="button" class="reset-link" id="catalog-reset-btn">Reset</button>
              </div>
            </form>
          </aside>
        </div>

        <div class="content">
          <button class="mobile-filter-btn" id="mobile-filter-btn" aria-expanded="false" aria-controls="sidebar">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
            Filters
          </button>

          <div class="results-head">
            <p id="resource-count"><strong>{sortedResources.length}</strong> resources</p>
            <div class="results-head-right">
              <label class="sort-control">
                <span>Sort by</span>
                <select id="catalog-sort" name="sort">
                  <option value="relevance" selected>Relevance</option>
                  <option value="updated">Recently Updated</option>
                  <option value="title">Name A-Z</option>
                </select>
              </label>
              <div class="view-toggle" role="group" aria-label="View mode">
                <button class="view-btn active" data-view="list" title="List view" aria-pressed="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                </button>
                <button class="view-btn" data-view="grid" title="Grid view" aria-pressed="false">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                </button>
                <button class="view-btn" data-view="table" title="Table view" aria-pressed="false">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="9" x2="9" y2="21"/></svg>
                </button>
              </div>
            </div>
          </div>

          <!-- data-audience="community" is the default; JS updates it on load -->
          <section class="results" id="results-section" data-view="list" data-audience="community">
            <div class="active-filters" id="active-filters" aria-live="polite" hidden>
            <div class="active-filter-list" id="active-filter-list"></div>
            <button type="button" class="clear-all-btn" id="catalog-clear-all">Clear All</button>
          </div>

            {sortedResources.length === 0 ? (
              <article class="result-card empty"><p>No resources match your current filter combination.</p></article>
            ) : (
              <>
                {/* Card / Grid view */}
                <div class="cards-view">
                  {sortedResources.map((resource) => {
                    const themes = resource.data.dataThemes.length > 0 ? resource.data.dataThemes : resource.data.tags;
                    const previewHref = getPreviewHref(resource);
                    const resourceAudiences = getResourceAudiences(resource);
                    const geoChips = getGeoChips(resource);
                    const geoAttrs = getGeoAttrs(resource);
                    return (
                      <article
                        class="result-card"
                        data-audiences={resourceAudiences}
                        data-title={resource.data.title}
                        data-search={[resource.data.title, resource.data.description, ...themes].join(' ').toLowerCase()}
                        data-themes={themes.join('|')}
                        data-pedagogical={resource.data.pedagogicalTags.join('|')}
                        data-national={geoAttrs.national}
                        data-states={geoAttrs.states}
                        data-statewide={geoAttrs.statewide}
                        data-counties={geoAttrs.counties}
                        data-date={resource.data.publishedDate ? new Date(resource.data.publishedDate).getTime() : 0}
                      >
                        <div class="result-main">
                          <h3>
                            <a href={previewHref} class="preview-link">{resource.data.title}</a>
                          </h3>
                          <p>{resource.data.description}</p>
                          <div class="tag-rows">
                            {(geoChips.length > 0 || geoAttrs.national) && (
                              <div class="chips">
                                {geoAttrs.national && <span class="chip chip-geo chip-static">National</span>}
                                {geoChips.slice(0, 3).map((chip) => (
                                  <button type="button" class="chip chip-geo" data-filter={chip.type} data-value={chip.value} title={chip.title}>{chip.label}</button>
                                ))}
                              </div>
                            )}
                            {themes.length > 0 && (
                              <div class="chips">
                                {themes.slice(0, 3).map((theme) => (
                                  <button type="button" class="chip chip-theme" data-filter="theme" data-value={theme}>{theme}</button>
                                ))}
                              </div>
                            )}
                            {resource.data.pedagogicalTags.length > 0 && (
                              <div class="chips">
                                {resource.data.pedagogicalTags.slice(0, 2).map((tag) => (
                                  <button type="button" class="chip chip-pedagogical" data-filter="pedagogicalTag" data-value={tag}>{tag}</button>
                                ))}
                              </div>
                            )}
                          </div>
                          <p class="meta-line">Updated {formatDate(resource.data.publishedDate)}</p>
                        </div>
                      </article>
                    );
                  })}
                </div>

                {/* Table view */}
                <div class="table-view">
                  <table>
                    <thead>
                      <tr>
                        <th>Title</th>
                        <th>Geographic</th>
                        <th>Content</th>
                        <th class="th-pedagogical">Pedagogical</th>
                        <th>Updated</th>
                      </tr>
                    </thead>
                    <tbody>
                      {sortedResources.map((resource) => {
                        const themes = resource.data.dataThemes.length > 0 ? resource.data.dataThemes : resource.data.tags;
                        const previewHref = getPreviewHref(resource);
                        const resourceAudiences = getResourceAudiences(resource);
                        const geoChips = getGeoChips(resource);
                        const geoAttrs = getGeoAttrs(resource);
                        return (
                          <tr
                            data-audiences={resourceAudiences}
                            data-title={resource.data.title}
                            data-search={[resource.data.title, resource.data.description, ...themes].join(' ').toLowerCase()}
                            data-themes={themes.join('|')}
                            data-pedagogical={resource.data.pedagogicalTags.join('|')}
                            data-national={geoAttrs.national}
                            data-states={geoAttrs.states}
                            data-statewide={geoAttrs.statewide}
                            data-counties={geoAttrs.counties}
                            data-date={resource.data.publishedDate ? new Date(resource.data.publishedDate).getTime() : 0}
                          >
                            <td class="td-title">
                              <a href={previewHref} class="preview-link">{resource.data.title}</a>
                            </td>
                            <td>
                              <div class="chips">
                                {geoAttrs.national && <span class="chip chip-geo chip-static">National</span>}
                                {geoChips.slice(0, 2).map((chip) => (
                                  <button type="button" class="chip chip-geo" data-filter={chip.type} data-value={chip.value} title={chip.title}>{chip.label}</button>
                                ))}
                              </div>
                            </td>
                            <td>
                              <div class="chips">
                                {themes.slice(0, 2).map((theme) => (
                                  <button type="button" class="chip chip-theme" data-filter="theme" data-value={theme}>{theme}</button>
                                ))}
                              </div>
                            </td>
                            <td class="td-pedagogical">
                              <div class="chips">
                                {resource.data.pedagogicalTags.slice(0, 2).map((tag) => (
                                  <button type="button" class="chip chip-pedagogical" data-filter="pedagogicalTag" data-value={tag}>{tag}</button>
                                ))}
                              </div>
                            </td>
                            <td class="td-meta">{formatDate(resource.data.publishedDate)}</td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              </>
            )}
          </section>
        </div>
      </section>
    </div>
  </div>

  <script>
    // ── Mobile sidebar toggle ──────────────────────────────────────────
    const mobileFilterBtn = document.getElementById('mobile-filter-btn');
    const sidebarEl = document.getElementById('sidebar');
    const sidebarClose = document.getElementById('sidebar-close');

    function openSidebar() {
      sidebarEl?.classList.add('open');
      mobileFilterBtn?.setAttribute('aria-expanded', 'true');
    }
    function closeSidebar() {
      sidebarEl?.classList.remove('open');
      mobileFilterBtn?.setAttribute('aria-expanded', 'false');
    }

    mobileFilterBtn?.addEventListener('click', openSidebar);
    sidebarClose?.addEventListener('click', closeSidebar);

    // ── View toggle (list / grid / table) ─────────────────────────────
    const section = document.getElementById('results-section');
    const viewButtons = document.querySelectorAll('.view-btn');

    const savedView = localStorage.getItem('ml-view') ?? 'list';
    applyView(savedView);

    viewButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const view = (btn as HTMLElement).dataset.view ?? 'list';
        applyView(view);
        localStorage.setItem('ml-view', view);
      });
    });

    function applyView(view: string) {
      if (!section) return;
      section.dataset.view = view;
      viewButtons.forEach((btn) => {
        const isActive = (btn as HTMLElement).dataset.view === view;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      });
    }

    // ── Audience switching (client-side, static-build compatible) ─────
    const audienceLabelEl = document.getElementById('audience-label-text');
    const resourceCountEl = document.getElementById('resource-count');
    const hiddenAudienceInput = document.getElementById('hidden-audience') as HTMLInputElement | null;

    const audienceDescriptions: Record<string, string> = {
      teacher: 'Teacher view — pedagogical tags are available in this view.',
      student: 'Student view — sensitive datasets are excluded.',
      community: 'Complete catalog showing all datasets. Adjust filters on the left to locate a specific resource.',
    };
    const audienceDisplayNames: Record<string, string> = {
      teacher: 'Teacher',
      student: 'Student',
      community: 'Community Member',
    };

    function applyAudience(audience: string) {
      if (!section) return;

      // Update data-attribute (CSS handles card show/hide)
      section.dataset.audience = audience;

      // Update active state on view-guide cards
      document.querySelectorAll<HTMLElement>('.view-card[data-audience]').forEach((card) => {
        card.classList.toggle('active', card.dataset.audience === audience);
      });

      // Update active state on audience-switch pills
      document.querySelectorAll<HTMLElement>('.audience-switch [data-audience]').forEach((link) => {
        link.classList.toggle('active', link.dataset.audience === audience);
      });

      // Update audience label paragraph
      // if (audienceLabelEl) {
      //   const name = audienceDisplayNames[audience] ?? 'Community Member';
      //   const desc = audienceDescriptions[audience] ?? '';
      //   audienceLabelEl.innerHTML = `Showing <strong>${name}</strong> view. ${desc}`;
      // }

      // Update hidden form input so form submissions preserve the audience
      if (hiddenAudienceInput) hiddenAudienceInput.value = audience;

      // Update preview link hrefs so the data-preview page knows the audience
      document.querySelectorAll<HTMLAnchorElement>('.preview-link').forEach((link) => {
        link.href = link.href.replace(/audience=[^&]+/, `audience=${audience}`);
      });

      // Update resource count
      updateCatalogCount();
    }

    // Intercept audience link/card clicks — update URL via pushState, no reload
    document.querySelectorAll<HTMLElement>('[data-audience].view-card, .audience-switch [data-audience]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const audience = el.dataset.audience ?? 'community';
        const url = new URL(window.location.href);
        url.searchParams.set('audience', audience);
        history.pushState({ audience }, '', url.toString());
        applyAudience(audience);
        applyFilters();
      });
    });

    // Handle browser back/forward
    window.addEventListener('popstate', () => {
      const audience = new URLSearchParams(window.location.search).get('audience') ?? 'community';
      applyAudience(audience);
      applyFilters();
    });

    // Apply audience on page load from URL
    const initialAudience = new URLSearchParams(window.location.search).get('audience') ?? 'community';
    applyAudience(initialAudience);

    // ── Client-side filters (theme, search, sort) ──────────────
    const searchForm    = document.getElementById('catalog-search-form') as HTMLFormElement | null;
    const searchInput   = searchForm?.querySelector<HTMLInputElement>('[name="q"]') ?? null;
    const sortSelect    = document.getElementById('catalog-sort') as HTMLSelectElement | null;
    const filterForm    = document.getElementById('catalog-filter-form') as HTMLFormElement | null;
    const resetBtn      = document.getElementById('catalog-reset-btn');
    const activeFiltersEl = document.getElementById('active-filters');
    const activeFilterList = document.getElementById('active-filter-list');
    const clearAllBtn = document.getElementById('catalog-clear-all');
    const cardsView     = document.querySelector<HTMLElement>('.cards-view');
    const tableBody     = document.querySelector<HTMLElement>('.table-view tbody');

    type FilterName = 'state' | 'county' | 'theme' | 'pedagogicalTag';

    function isFilterName(value: string): value is FilterName {
      return value === 'state'
        || value === 'county'
        || value === 'theme'
        || value === 'pedagogicalTag';
    }

    const splitAttr = (value: string | undefined) => (value ?? '').split('|').filter(Boolean);

    function checkboxes(name: FilterName): HTMLInputElement[] {
      return Array.from(filterForm?.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`) ?? []);
    }
    function checkedValues(name: FilterName): string[] {
      return checkboxes(name).filter((cb) => cb.checked).map((cb) => cb.value);
    }

    function renderActiveFilters() {
      if (!activeFiltersEl || !activeFilterList) return;

      activeFilterList.replaceChildren();

      function addChip(name: FilterName | 'q', value: string, label: string) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'active-filter-chip';
        button.dataset.removeFilter = name;
        button.dataset.value = value;
        button.textContent = `${label} ×`;
        button.setAttribute('aria-label', `Remove ${label}`);
        activeFilterList.append(button);
      }

      const query = searchInput?.value.trim() ?? '';
      if (query) addChip('q', query, `Search: ${query}`);

      const labels: Record<FilterName, string> = {
        state: 'State',
        county: 'County',
        theme: 'Theme',
        pedagogicalTag: 'Pedagogical',
      };

      (['state', 'county', 'theme', 'pedagogicalTag'] as FilterName[]).forEach((name) => {
        checkboxes(name).filter((cb) => cb.checked).forEach((cb) => {
          const optionLabel =
            cb.closest('label')?.querySelector('span')?.textContent?.trim() ?? cb.value;
          const label = name === 'county'
            ? `County: ${cb.dataset.state} / ${optionLabel}`
            : `${labels[name]}: ${optionLabel}`;

          addChip(name, cb.value, label);
        });
      });

      activeFiltersEl.hidden = activeFilterList.childElementCount === 0;
    }

    interface Filters {
      q: string;
      themes: string[];
      ptags: string[];
      states: string[];
      counties: string[];
    }

    function matchesFilters(el: HTMLElement, f: Filters) {
      const elThemes = splitAttr(el.dataset.themes);
      const elPed = splitAttr(el.dataset.pedagogical);
      const elStates = splitAttr(el.dataset.states);
      const elStatewide = splitAttr(el.dataset.statewide);
      const elCounties = splitAttr(el.dataset.counties);
      const elNational = el.dataset.national === 'true';

      const okSearch = !f.q || (el.dataset.search ?? '').includes(f.q);
      const okTheme = f.themes.length === 0 || f.themes.some((t) => elThemes.includes(t));
      const okPed = f.ptags.length === 0 || f.ptags.some((t) => elPed.includes(t));
      // Same meaning as the maps page: national data covers every state and county, and
      // statewide data covers every county in its state. If counties of a checked state are
      // also checked, only those counties count (plus national and statewide data).
      const okGeo =
        f.states.length === 0 ||
        elNational ||
        f.states.some((state) => {
          const chosen = f.counties.filter((c) => c.startsWith(`${state}::`));
          if (chosen.length === 0) return elStates.includes(state);
          return elStatewide.includes(state) || chosen.some((c) => elCounties.includes(c));
        });

      return okSearch && okTheme && okPed && okGeo;
    }

    function relevance(el: HTMLElement, q: string) {
      if (!q) return 0;
      const inTitle = (el.dataset.title ?? '').toLowerCase().includes(q) ? 2 : 0;
      const inText = (el.dataset.search ?? '').includes(q) ? 1 : 0;
      return inTitle + inText;
    }

    function applyFilters() {
      const filters: Filters = {
        q: searchInput?.value.trim().toLowerCase() ?? '',
        themes: checkedValues('theme'),
        ptags: checkedValues('pedagogicalTag'),
        states: checkedValues('state'),
        counties: checkedValues('county'),
      };
      const sort = sortSelect?.value ?? 'relevance';

      const compare = (a: HTMLElement, b: HTMLElement) => {
        if (sort === 'title') return (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '');
        if (sort === 'relevance') {
          const diff = relevance(b, filters.q) - relevance(a, filters.q);
          if (diff !== 0) return diff;
        }
        return Number(b.dataset.date ?? '0') - Number(a.dataset.date ?? '0');
      };

      // Filter cards
      const cards = Array.from(document.querySelectorAll<HTMLElement>('.result-card:not(.empty)'));
      cards.forEach((card) => {
        card.classList.toggle('filtered-out', !matchesFilters(card, filters));
      });

      // Filter table rows
      const rows = Array.from(document.querySelectorAll<HTMLElement>('tr[data-audiences]'));
      rows.forEach((row) => {
        row.classList.toggle('filtered-out', !matchesFilters(row, filters));
      });

      // Sort cards view
      if (cardsView) cards.slice().sort(compare).forEach((c) => cardsView.appendChild(c));

      // Sort table rows
      if (tableBody) rows.slice().sort(compare).forEach((r) => tableBody.appendChild(r));

      updateCatalogCount();
      renderActiveFilters();
    }

    function updateCatalogCount() {
      if (!section || !resourceCountEl) return;
      const audience = section.dataset.audience ?? 'community';
      const cards = section.querySelectorAll<HTMLElement>('.result-card:not(.empty)');
      let count = 0;
      cards.forEach(card => {
        const audiences = (card.dataset.audiences ?? '').split(' ');
        if (audiences.includes(audience) && !card.classList.contains('filtered-out')) count++;
      });
      resourceCountEl.innerHTML = `<strong>${count}</strong> resources`;
    }

    // ── Filter sidebar: expand / collapse ─────────────────────────────
    function setSeeMore(list: HTMLElement, expanded: boolean) {
      list.classList.toggle('is-collapsed', !expanded);
      const btn = list.nextElementSibling;
      if (btn instanceof HTMLButtonElement && btn.classList.contains('see-more')) {
        btn.textContent = expanded ? 'See less' : 'See more';
        btn.setAttribute('aria-expanded', String(expanded));
      }
    }

    function setSubList(sub: HTMLElement, expanded: boolean) {
      sub.hidden = !expanded;
      sub.closest('.filter-item')?.querySelector('.sub-toggle')?.setAttribute('aria-expanded', String(expanded));
    }

    document.querySelectorAll<HTMLButtonElement>('.see-more').forEach((btn) => {
      btn.addEventListener('click', () => {
        const list = btn.previousElementSibling as HTMLElement | null;
        if (list) setSeeMore(list, list.classList.contains('is-collapsed'));
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.sub-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const sub = btn.closest('.filter-item')?.querySelector<HTMLElement>('.sub-list');
        if (sub) setSubList(sub, sub.hidden);
      });
    });

    // Make sure a checked option is visible (open its dropdowns / expanded lists)
    function revealCheckbox(cb: HTMLInputElement) {
      const details = cb.closest('details');
      if (details) details.open = true;
      const sub = cb.closest<HTMLElement>('.sub-list');
      if (sub) setSubList(sub, true);
      const list = cb.closest<HTMLElement>('.filter-list');
      if (list?.classList.contains('is-collapsed')) setSeeMore(list, true);
    }

    // Check one filter option (used by URL params and by tag chips)
    function selectFilter(name: FilterName, value: string) {
      const cb = checkboxes(name).find((c) => c.value === value);
      if (!cb) return;
      cb.checked = true;
      if (name === 'county') {
        // A county needs its state checked too
        const parent = checkboxes('state').find((c) => c.value === cb.dataset.state);
        if (parent) {
          parent.checked = true;
          revealCheckbox(parent);
        }
      }
      revealCheckbox(cb);
    }

    // ── Events ────────────────────────────────────────────────────────
    filterForm?.addEventListener('submit', (e) => e.preventDefault());
    filterForm?.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.name === 'county' && target.checked) {
        selectFilter('county', target.value);
      }
      if (target.name === 'state' && !target.checked) {
        // Unchecking a state clears its counties
        checkboxes('county').filter((c) => c.dataset.state === target.value).forEach((c) => (c.checked = false));
      }
      applyFilters();
    });

    searchForm?.addEventListener('submit', (e) => { e.preventDefault(); applyFilters(); });
    searchInput?.addEventListener('input', applyFilters);
    sortSelect?.addEventListener('change', applyFilters);

    // Clicking a tag chip on a result applies the matching filter
    document.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLElement>('.chip[data-filter]');
      if (!chip) return;
      selectFilter(chip.dataset.filter as FilterName, chip.dataset.value ?? '');
      applyFilters();
    });

    activeFilterList?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
        '.active-filter-chip[data-remove-filter]'
      );
      if (!button) return;

      const name = button.dataset.removeFilter;
      const value = button.dataset.value ?? '';

      if (name === 'q') {
        if (searchInput) searchInput.value = '';
      } else if (name && isFilterName(name)) {
        const checkbox = checkboxes(name).find((cb) => cb.value === value);
        if (checkbox) {
          checkbox.checked = false;

          if (name === 'state') {
            checkboxes('county')
              .filter((cb) => cb.dataset.state === value)
              .forEach((cb) => {
                cb.checked = false;
              });
          }
        }
      }

      applyFilters();
    });

    function clearAllFilters() {
      if (searchInput) searchInput.value = '';
      filterForm
        ?.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')
        .forEach((cb) => {
          cb.checked = false;
        });
      applyFilters();
    }

    resetBtn?.addEventListener('click', () => {
      if (sortSelect) sortSelect.value = 'relevance';
      clearAllFilters();
    });

    clearAllBtn?.addEventListener('click', clearAllFilters);

    // Initial state from URL params (?q=, ?sort=, ?theme=, ?pedagogicalTag=, ?state=, ?county=State::County)
    const initParams = new URLSearchParams(window.location.search);
    if (searchInput) searchInput.value = initParams.get('q') ?? '';
    const initSort = initParams.get('sort') ?? '';
    if (sortSelect && ['relevance', 'updated', 'title'].includes(initSort)) sortSelect.value = initSort;
    (['state', 'county', 'theme', 'pedagogicalTag'] as FilterName[]).forEach((name) => {
      initParams.getAll(name).forEach((value) => selectFilter(name, value.trim()));
    });
    applyFilters();
  </script>

  <style>
