---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { withBasePath } from '@lib/paths';

// The full list, with search, lives on /libraries; this page only counts them.
const libraryCount = (await getCollection('communities')).length;

const registerHref = withBasePath('/librarian/register/');
const loginHref = withBasePath('/librarian/login/');
const librariesHref = withBasePath('/libraries');
---

<Layout
  title="Create a Community Library"
  description="What a community data library is, how to start one, and which communities already have one."
>
  <section class="create-shell">
    <header class="page-header">
      <p class="eyebrow">Community Libraries</p>
      <h1>Create a community library.</h1>
      <p class="intro">
        A community library is a local view of the main Community Data Libraries catalog. It gives
        your community its own landing page and a catalog filtered to your place, while every
        dataset continues to come from, and be maintained in, the main library.
      </p>
    </header>

    <div class="info-grid">
      <article class="info-card">
        <h2>What you get</h2>
        <ul>
          <li>A welcome page with your community's name.</li>
          <li>Teacher, Student, and Community Member entry points.</li>
          <li>A community catalog filtered from the main catalog by your geography.</li>
        </ul>
      </article>
      <article class="info-card">
        <h2>What you maintain</h2>
        <ul>
          <li>Your community's name and web address (slug).</li>
          <li>The county it serves, picked from the Census list of U.S. counties.</li>
          <li>Who else can edit it: add colleagues as editors by email.</li>
        </ul>
        <p class="note">
          Dataset details are maintained in the main library. To add a dataset, use
          <a href={withBasePath('/submit')}>Suggest a Data Resource</a>.
        </p>
      </article>
    </div>

    <section class="steps" aria-labelledby="steps-heading">
      <h2 id="steps-heading">How to create one</h2>
      <ol>
        <li>
          <strong>Check the <a href={librariesHref}>list of community libraries</a>.</strong> Each county
          can have one library. If yours already has one, use the contact form on its page to reach its
          editors instead of creating a duplicate.
        </li>
        <li>
          <strong>Create a librarian account.</strong> <a href={loginHref}>Sign up</a> with your email
          address and confirm it from the email we send you.
        </li>
        <li>
          <strong>Register your library.</strong> Enter its name and pick your county by typing its name
          (for example, <em>Knox Tennessee</em>). You become its first editor and can add colleagues
          afterwards.
        </li>
        <li>
          <strong>Approval.</strong> The Community Data Libraries team reviews new libraries. Once approved,
          the site rebuilds within a few minutes and your library appears on the
          <a href={librariesHref}>library list</a>. After that,
          your edits in the portal are published on the next rebuild, a few minutes later.
        </li>
      </ol>
      <a href={registerHref} class="button">Register a library</a>
      <p class="note">Only librarians sign in. Visitors never need an account.</p>
    </section>

    <section class="existing" id="existing" aria-labelledby="existing-heading">
      <h2 id="existing-heading">Existing community libraries</h2>
      <p class="note">
        {libraryCount === 0
          ? 'No community libraries have been created yet.'
          : `There ${libraryCount === 1 ? 'is' : 'are'} ${libraryCount} community ${libraryCount === 1 ? 'library' : 'libraries'} so far. Search by name, county, city, or state to see whether yours already has one.`}
      </p>
      <form class="existing-search" action={librariesHref} method="get" role="search">
        <label for="existing-q" class="visually-hidden">Search community libraries</label>
        <input type="search" id="existing-q" name="q" placeholder="Try Knoxville, Knox County, or TN" />
        <button type="submit" class="button">Search libraries</button>
      </form>
      <a href={librariesHref} class="see-all">See all community libraries</a>
    </section>
  </section>

  <style>
    .create-shell {
      display: grid;
      gap: var(--space-8);
    }

    .page-header {
      display: grid;
      gap: var(--space-3);
      max-width: 70ch;
    }

    .eyebrow {
      margin: 0;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: var(--font-size-xs);
      font-weight: 700;
      color: var(--color-secondary);
    }

    .page-header h1 {
      margin: 0;
      font-size: clamp(2.25rem, 4vw, 3.5rem);
    }

    .intro {
      margin: 0;
      color: var(--color-text-muted);
      font-size: var(--font-size-lg);
    }

    .info-grid {
      display: grid;
      gap: var(--space-5);
    }

    @media (min-width: 900px) {
      .info-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    .info-card,
    .steps,
    .existing {
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      border-radius: var(--radius-xl);
      padding: var(--space-6);
      box-shadow: var(--shadow-sm);
      display: grid;
      gap: var(--space-4);
      align-content: start;
    }

    h2 {
      margin: 0;
      font-size: var(--font-size-2xl);
    }

    ul,
    ol {
      margin: 0;
      padding-left: 1.5rem;
      color: var(--color-text-muted);
    }

    ul {
      list-style: disc;
    }

    ol {
      list-style: decimal;
    }

    li + li {
      margin-top: var(--space-2);
    }

    .steps .button {
      justify-self: start;
    }

    .note {
      margin: 0;
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
    }

    .existing-search {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      align-items: center;
    }

    .existing-search input {
      flex: 1 1 16rem;
      max-width: 32rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: var(--space-2) var(--space-3);
      background: var(--color-surface-raised);
      color: var(--color-text);
      font-family: var(--font-sans);
      font-size: var(--font-size-base);
    }

    .existing-search input:focus {
      outline: none;
      border-color: var(--color-primary);
    }

    .see-all {
      justify-self: start;
      font-weight: 600;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>
</Layout>
