---
import Navigation from '@components/Navigation.astro';
import { Image } from 'astro:assets';
import { libraryHref, withBasePath } from '@lib/paths';
import cdlEmblem from '../assets/brand/cdl-emblem-transparent.png';
// Lower-48 county (fainter) + state outlines from Census cb_2024 1:20m, Albers projection.
// Strokes are baked into the SVG; loaded as a cached file rather than inlined on every page.
import usCountiesUrl from '../assets/footer/us-counties.svg?url';
import '../styles/tailwind.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Community Data Libraries',
  description = 'A curated collection of data science resources and community-submitted materials for researchers, students, and practitioners.',
} = Astro.props;

const siteTitle =
  title === 'Community Data Libraries' ? title : `${title} | Community Data Libraries`;
const librarianLoginHref = withBasePath('/librarian/login/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="icon" type="image/svg+xml" href={withBasePath('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Outfit: used only by the Data Preview chart labels -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Philosopher font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Philosopher:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
    
    <!-- Barlow: body text (400) with 500/600/700 for nav, buttons and links -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <!-- Zen Maru Gothic: softly rounded sans for the nav bar -->
    <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700&display=swap" rel="stylesheet">

    <!-- Micro 5 Charted: gridded pixel font for the homepage tagline -->
    <link href="https://fonts.googleapis.com/css2?family=Micro+5+Charted&display=swap" rel="stylesheet">

    <!-- Doto: dot-matrix font (round-dot ROND axis) for the nav "Community Data Libraries" name -->
    <link href="https://fonts.googleapis.com/css2?family=Doto:ROND,wght@0..100,100..900&display=swap" rel="stylesheet">
    <!-- Barlow Semi Condensed: clean, narrow sans for tags/chips site-wide -->
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@400;500&display=swap" rel="stylesheet">

    <title>{siteTitle}</title>
    <script is:inline define:vars={{ librarianLoginHref }}>
      // Links in Netlify Identity emails (confirm, invite, password reset) land on the
      // home page with a token in the hash; the librarian login page handles them.
      // No Identity code loads on public pages.
      if (
        /(?:^#|&)(?:confirmation|invite|recovery|email_change)_token=|(?:^#|&)access_token=/.test(location.hash) &&
        !location.pathname.startsWith(librarianLoginHref.replace(/\/$/, ''))
      ) {
        location.replace(librarianLoginHref + location.hash);
      }
    </script>
    <slot name="head" />
  </head>
  <body>
    <!-- Paper texture overlay -->
    <div class="paper-grain" aria-hidden="true"></div>
    <Navigation />
    <main>
      <slot />
    </main>
    <footer>
      <img src={usCountiesUrl} alt="" class="footer-map" aria-hidden="true" loading="lazy" decoding="async" />
      <div class="footer-inner">
        <div class="footer-top">
          <div class="footer-brand">
            <Image src={cdlEmblem} alt="" class="footer-mark" widths={[72, 144, 216]} sizes="72px" />
            <div>
              <span class="footer-title">Community Data Libraries</span>
              <p class="footer-tagline">Data about your community, for your community</p>
            </div>
          </div>
          <nav class="footer-links" aria-label="Footer navigation">
            <a href={withBasePath('/complete-catalog')}>Complete Catalog</a>
            <a href={libraryHref('knox-county')}>Example Community Library</a>
            <a href={withBasePath('/create-community-library')}>Create a Community Library</a>
            <a href={withBasePath('/submit')}>Suggest a Dataset</a>
          </nav>
        </div>
        <div class="footer-bottom">
          <p class="footer-copy">&copy; {new Date().getFullYear()} Community Data Libraries. Open source under GPL-3.0-only.</p>
          <p class="footer-tagline-bottom">
            Created by <a href="https://opalslab.org" target="_blank" rel="noopener noreferrer">OPALS Lab</a>
            <span aria-hidden="true">·</span>
            <!-- Email link: the address is never in the HTML (reversed in data attributes and
                 assembled by script only when used), which keeps simple scrapers from harvesting it. -->
            <a href="#" class="footer-email js-email" data-u="ofni" data-d="gro.seirarbilatadytinummoc" aria-label="Email us" title="Email us">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </a>
          </p>
        </div>
      </div>
    </footer>
    <script>
      // Build the mailto only on interaction so the address never sits in the page source.
      const rev = (v: string | undefined) => (v ?? '').split('').reverse().join('');
      document.querySelectorAll<HTMLAnchorElement>('a.js-email').forEach((link) => {
        const arm = () => {
          link.href = `mailto:${rev(link.dataset.u)}@${rev(link.dataset.d)}`;
        };
        ['pointerenter', 'focus', 'touchstart'].forEach((evt) =>
          link.addEventListener(evt, arm, { once: true, passive: true })
        );
        link.addEventListener('click', arm);
      });
    </script>
  </body>
</html>

<style is:global>
  /* =============================================
     CSS Reset
  ============================================= */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* =============================================
     Design System — Warm Archival
  ============================================= */
  :root {
    /* Cool editorial palette */
    --color-background: #FFFFFF;
    --color-surface: #FFFFFF;
    --color-surface-raised: #FFFFFF;
    --color-border: #D2DEE6;
    --color-border-highlight: #AFC4D2;

    /* Brand — deep teal / forest green (from CDL logo) */
    --color-primary: #0E7265;
    --color-primary-dark: #0A5A50;
    --color-primary-light: #10A898;
    --color-primary-glow: rgba(14, 114, 101, 0.10);

    /* Secondary — dark teal-navy (leftmost logo color) */
    --color-secondary: #D4A017;
    --color-secondary-light: #1A7A96;
    --color-secondary-glow: rgba(21, 94, 117, 0.10);

    /* Accent — forest green (from logo trees/nodes) */
    --color-accent: #1A6B45;
    --color-accent-light: #228A58;
    --color-accent-glow: rgba(26, 107, 69, 0.10);

    /* Text */
    --color-text: #4A3526;
    --color-text-muted: #4A3526;
    --color-text-dim: #556470;

    /* Typography */
    --font-display: 'Philosopher', Georgia, 'Times New Roman', serif;
    --font-sans: 'Barlow', -apple-system, BlinkMacSystemFont, sans-serif;
    /* Nav bar: softly rounded */
    --font-nav: 'Zen Maru Gothic', 'Barlow', -apple-system, BlinkMacSystemFont, sans-serif;
    /* only for code snippets: system monospace (no web font download) */
    --font-mono: ui-monospace, 'SF Mono', Menlo, Monaco, Consolas, monospace;
    /* Tags/chips site-wide: borderless tinted pills */
    --font-tag: 'Barlow Semi Condensed', -apple-system, BlinkMacSystemFont, sans-serif;

    --font-size-xs: 0.75rem;
    --font-size-sm: 0.875rem;
    --font-size-base: 1rem;
    --font-size-lg: 1.125rem;
    --font-size-xl: 1.25rem;
    --font-size-2xl: 1.5rem;
    --font-size-3xl: 1.875rem;
    --font-size-4xl: 2.25rem;

    --line-height-tight: 1.2;
    --line-height-normal: 1.6;
    --line-height-relaxed: 1.8;

    /* Spacing */
    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.25rem;
    --space-6: 1.5rem;
    --space-8: 2rem;
    --space-12: 3rem;
    --space-16: 4rem;
    --space-24: 6rem;

    /* Shadows */
    --shadow-sm: 0 1px 3px 0 rgba(15, 23, 42, 0.10);
    --shadow-md: 0 4px 16px -2px rgba(15, 23, 42, 0.14);
    --shadow-lg: 0 12px 40px -8px rgba(15, 23, 42, 0.18);
    --shadow-glow-primary: 0 4px 20px -4px rgba(14, 114, 101, 0.28);
    --shadow-glow-secondary: 0 4px 20px -4px rgba(21, 94, 117, 0.28);
    --shadow-glow-accent: 0 4px 20px -4px rgba(26, 107, 69, 0.28);

    /* Radii */
    --radius-sm: 0.2rem;
    --radius-md: 0.45rem;
    --radius-lg: 0.875rem;
    --radius-xl: 1.5rem;
  }

  /* =============================================
     Paper grain texture
  ============================================= */
  .paper-grain {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9999;
    opacity: 0.028;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 128px 128px;
  }

  /* =============================================
     Base
  ============================================= */
  html {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: var(--line-height-normal);
    color: var(--color-text);
    background-color: var(--color-background);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    /* Plain white so it matches the white background of the homepage illustration. */
    background-color: var(--color-background);
  }

  main {
    flex: 1;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-8) var(--space-6);
  }

  /* =============================================
     Typography
  ============================================= */
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: var(--line-height-tight);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  h1 { font-size: var(--font-size-4xl); font-weight: 900; }
  h2 { font-size: var(--font-size-3xl); }
  h3 { font-size: var(--font-size-2xl); }
  h4 { font-size: var(--font-size-xl); }

  p { margin-bottom: var(--space-4); }

  a {
    color: var(--color-primary);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  a:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  ul, ol {
    margin-left: var(--space-6);
    margin-bottom: var(--space-4);
  }

  code {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    background-color: var(--color-surface-raised);
    color: var(--color-primary);
    padding: 0.12em var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  @media (max-width: 768px) {
    h1 { font-size: var(--font-size-3xl); }
    h2 { font-size: var(--font-size-2xl); }
    h3 { font-size: var(--font-size-xl); }
  }

  /* =============================================
     Buttons
  ============================================= */
  button, .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background-color: var(--color-secondary);
    color: #F8FAFC;
    border: 1.5px solid var(--color-secondary);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: all 0.18s ease;
    text-decoration: none;
    white-space: nowrap;
  }

  button:hover, .button:hover {
    background-color: #0F4A5E;
    border-color: #0F4A5E;
    box-shadow: var(--shadow-glow-secondary);
    transform: translateY(-1px);
    text-decoration: none;
    color: #F8FAFC;
  }

  /* =============================================
     Footer
  ============================================= */
  footer {
    background-color: #1F3349;
    color: #D6C9B8;
    padding: var(--space-12) var(--space-6) var(--space-8);
    margin-top: var(--space-16);
    position: relative;
    overflow: hidden;
  }

  /* Decorative top border stripe */
  footer::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-accent-light) 50%, var(--color-secondary-light) 100%);
  }

  /* Decorative large CDL watermark */
  /* Very faint U.S. county and state outlines as a background texture.
     Zoomed in so only inland counties show (no coastline); centered near East Tennessee.
     The footer's overflow:hidden crops the rest. */
  .footer-map {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -64% -58%;
    width: max(250%, 2600px);
    max-width: none;
    height: auto;
    pointer-events: none;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-8);
    flex-wrap: wrap;
    padding-bottom: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .footer-brand {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  /* Same emblem art as the nav ribbon (transparent background), sitting on the footer navy */
  .footer-mark {
    display: block;
    width: 72px;
    height: 72px;
    padding: 9px 7px 11px;
    object-fit: contain;
    border: 1px solid rgba(175, 229, 243, 0.35); /* nav-icon light blue (#AFE5F3), washed out */
    border-radius: 50%;
    /* Navy grosgrain ribs (same pattern as the nav ribbon's navy option) */
    background: repeating-linear-gradient(
      to bottom,
      #3D5A80 0 1px,
      #31496A 1px 2.5px,
      #22374F 2.5px 3.5px
    );
    flex-shrink: 0;
    margin-top: -4px;
  }

  /* Doto (round dots), matching the nav logo name */
  .footer-title {
    display: block;
    font-family: 'Doto', var(--font-mono);
    font-variation-settings: 'ROND' 100;
    font-weight: 800;
    font-size: 1.125rem;
    color: #E2E8F0;
    margin-bottom: var(--space-1);
  }

  .footer-tagline {
    margin: 0;
    font-size: var(--font-size-sm);
    color: #A0B4C4;
    line-height: 1.35;
    max-width: 30ch;
    text-wrap: balance;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    align-items: center;
  }

  .footer-links a {
    font-size: var(--font-size-sm);
    color: #A0B4C4;
    text-decoration: none;
    transition: color 0.15s ease;
    font-weight: 500;
  }

  .footer-links a:hover {
    color: var(--color-primary-light);
    text-decoration: none;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .footer-copy {
    font-size: var(--font-size-xs);
    color: #8BA4B8;
    margin: 0;
    font-family: var(--font-sans);
  }

  .footer-tagline-bottom {
    font-size: var(--font-size-xs);
    color: #8BA4B8;
    margin: 0;
    font-family: var(--font-sans);
  }

  .footer-tagline-bottom a {
    color: var(--color-primary-light);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-tagline-bottom a:hover {
    color: #FFFFFF;
    text-decoration: underline;
  }
  .footer-tagline-bottom {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .footer-tagline-bottom .footer-email {
    display: inline-flex;
    color: #7CD3C4; /* nav-icon light teal */
    text-decoration: none;
  }
  .footer-tagline-bottom .footer-email:hover {
    color: #FFFFFF;
  }

  /* =============================================
     Accessibility
  ============================================= */
  :focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .skip-to-main {
    position: absolute;
    left: -9999px;
    z-index: 999;
  }

  .skip-to-main:focus {
    left: 50%;
    transform: translateX(-50%);
    top: var(--space-4);
  }

  /* =============================================
     Global scroll animation utility
  ============================================= */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
</style>
