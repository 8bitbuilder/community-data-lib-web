---
import { withBasePath } from '@lib/paths';
import '../styles/tailwind.css';

interface Props {
  title?: string;
  description?: string;
  communityName: string;
  communityLocation?: string;
  communityBase: string; // e.g. '/communities/knox-county'
}

const {
  title,
  communityName,
  communityLocation,
  communityBase,
  description = `A community data library for ${communityName}.`,
} = Astro.props;

const pageTitle = title ? `${title} | ${communityName}` : communityName;

const base = communityBase.replace(/\/$/, '');
const homeHref   = withBasePath(`${base}/`);
const catalogHref = withBasePath(`${base}/catalog/`);
// Data Resources and Suggest a Data Resource are main-site pages; community
// libraries never get their own copies (or their own map).
const dataHref    = withBasePath('/data-resources');
const submitHref  = withBasePath('/submit');
const cdlHref     = withBasePath('/');

const navItems = [
  { href: catalogHref, label: 'Community Catalog', carryAudience: true },
  { href: dataHref, label: 'Data Resources', carryAudience: false },
  { href: submitHref, label: 'Suggest a Data Resource', carryAudience: false },
];

const currentPath = Astro.url.pathname;
function isActive(href: string): boolean {
  const normalized = href.replace(/\/$/, '');
  const currentNorm = currentPath.replace(/\/$/, '');
  if (normalized === currentNorm) return true;
  // Home only matches exactly; other pages match prefix
  if (href === homeHref) return false;
  return currentPath.startsWith(normalized);
}

const initials = communityName.split(' ').slice(0, 2).map(w => w[0]).join('');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={withBasePath('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Outfit: used only by the Data Preview chart labels -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Philosopher: display / headings -->
    <link href="https://fonts.googleapis.com/css2?family=Philosopher:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet" />
    <!-- Barlow: body text (400) with 500/600/700 for nav, buttons and links -->
    <link href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <!-- Zen Maru Gothic: softly rounded sans for the nav bar -->
    <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700&display=swap" rel="stylesheet" />
    <!-- Micro 5 + Micro 5 Charted: pixel font for taglines (plain letters layered over the gridded version) -->
    <link href="https://fonts.googleapis.com/css2?family=Micro+5&family=Micro+5+Charted&display=swap" rel="stylesheet" />
    <!-- Doto: dot-matrix font (round-dot ROND axis) for the wordmark -->
    <link href="https://fonts.googleapis.com/css2?family=Doto:ROND,wght@0..100,100..900&display=swap" rel="stylesheet" />
    <!-- Barlow Semi Condensed: clean, narrow sans for tags/chips site-wide -->
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@400;500&display=swap" rel="stylesheet" />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <div class="paper-grain" aria-hidden="true"></div>

    <nav class="navbar" role="navigation" aria-label="Community navigation">
      <div class="nav-container">

        <!-- Brand -->
        <div class="nav-brand">
          <a href={homeHref} class="brand-link">
            <span class="brand-mark">{initials}</span>
            <span class="brand-name">{communityName}{communityLocation && <><br/><span class="brand-location">{communityLocation}</span></>}</span>
          </a>
        </div>

        <!-- Desktop links -->
        <ul class="nav-links" id="nav-links">
          {navItems.map(item => (
            <li class="nav-item">
              <a
                href={item.href}
                class={`nav-link ${isActive(item.href) ? 'active' : ''}`}
                aria-current={isActive(item.href) ? 'page' : undefined}
                data-carry-audience={item.carryAudience ? '' : undefined}
              >{item.label}</a>
            </li>
          ))}
        </ul>

        <!-- Actions -->
        <div class="nav-actions">
          <a href={cdlHref} class="nav-cdl" title="Community Data Libraries network">
            <span class="cdl-badge">CDL</span>
          </a>
          <button
            class="mobile-menu-button"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
            id="mobile-menu-button"
          >
            <span class="hb"></span>
            <span class="hb"></span>
            <span class="hb"></span>
          </button>
        </div>
      </div>

      <!-- Mobile drawer -->
      <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
        <ul class="mobile-links">
          {navItems.map(item => (
            <li>
              <a
                href={item.href}
                class={`mobile-link ${isActive(item.href) ? 'active' : ''}`}
                data-carry-audience={item.carryAudience ? '' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
          <li><a href={cdlHref} class="mobile-link mobile-link-cdl">← Back to Community Data Libraries</a></li>
        </ul>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-top">
          <div class="footer-brand">
            <div class="footer-mark">{initials}</div>
            <div>
              <span class="footer-title">{communityName}</span>
              {communityLocation && <p class="footer-tagline">{communityLocation}</p>}
            </div>
          </div>
          <nav class="footer-links" aria-label="Footer navigation">
            <a href={homeHref}>Home</a>
            <a href={catalogHref} data-carry-audience>Community Catalog</a>
            <a href={dataHref}>Data Resources</a>
            <a href={submitHref}>Suggest a Data Resource</a>
            <a href={cdlHref}>Community Data Libraries ↗</a>
          </nav>
        </div>
        <div class="footer-bottom">
          <p class="footer-copy">&copy; {new Date().getFullYear()} {communityName}. Part of the <a href={cdlHref}>Community Data Libraries</a> network.</p>
          <p class="footer-tagline-bottom">Open source under MIT · Built with Astro</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
  import { applyAudienceToLinks, currentAudience } from '../lib/client/audience';

  // Keep the visitor's chosen role on links within this community library.
  const audience = currentAudience();
  if (audience) applyAudienceToLinks(audience);

  const btn = document.getElementById('mobile-menu-button');
  const drawer = document.getElementById('mobile-drawer');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.classList.toggle('open', !open);
    drawer?.classList.toggle('open', !open);
    drawer?.setAttribute('aria-hidden', String(open));
  });
  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Element)) return;
    if (!e.target.closest('.navbar')) {
      btn?.setAttribute('aria-expanded', 'false');
      btn?.classList.remove('open');
      drawer?.classList.remove('open');
      drawer?.setAttribute('aria-hidden', 'true');
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      btn?.setAttribute('aria-expanded', 'false');
      btn?.classList.remove('open');
      drawer?.classList.remove('open');
      drawer?.setAttribute('aria-hidden', 'true');
    }
  });
</script>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    /* Cool editorial palette (matches the main Layout) */
    --color-background: #FFFFFF;
    --color-surface: #FFFFFF;
    --color-surface-raised: #FFFFFF;
    --color-border: #D2DEE6;
    --color-border-highlight: #AFC4D2;

    /* Brand — deep teal / forest green (from CDL logo) */
    --color-primary: #0E7265;
    --color-primary-dark: #0A5A50;
    --color-primary-light: #10A898;
    --color-primary-glow: rgba(14, 114, 101, 0.10);

    /* Secondary — brand mustard */
    --color-secondary: #D4A017;
    --color-secondary-light: #1A7A96;
    --color-secondary-glow: rgba(21, 94, 117, 0.10);

    --color-accent: #1A6B45;
    --color-accent-light: #228A58;
    --color-accent-glow: rgba(26, 107, 69, 0.10);

    /* Main-site nav palette */
    --color-nav: #23354B;
    --color-nav-light: #34495F;
    --color-footer: #1F3349;          /* main Layout footer navy */
    --color-teal-light: #7CD3C4;
    --color-teal-light-glow: rgba(124, 211, 196, 0.14);
    --color-node-blue: #AFE5F3;       /* emblem network nodes */

    /* Homepage palette (hero cityscape / pointillist art) */
    --color-sky: #3EA8BC;            /* illustration blue-teal */
    --color-sky-ink: #25808F;        /* AA-contrast text version */
    --color-sky-deep: #1F6F80;
    --color-sky-glow: rgba(62, 168, 188, 0.15);
    --color-gold: #D4A017;           /* brand mustard (pixel gridlines) */
    --color-gold-dark: #B8860B;      /* gold on tinted bands */
    --color-gold-ink: #8A6A0C;       /* gold text on tint */
    --color-gold-glow: rgba(212, 160, 23, 0.16);
    --color-sun: #FFC43C;
    --color-band-tint: #F4F8F7;      /* alternating feature band */
    --color-band-deep: #E3F0EE;      /* closing CTA band */
    --color-surface-teal: #EEF8F8;   /* light-teal button fill */
    --btn-shadow: rgba(35, 53, 75, 0.32);

    /* Text */
    --color-text: #4A3526;
    --color-text-muted: #4A3526;
    --color-text-dim: #556470;

    /* Typography (same roles as the main Layout) */
    --font-display: 'Philosopher', Georgia, 'Times New Roman', serif;
    --font-sans: 'Barlow', -apple-system, BlinkMacSystemFont, sans-serif;
    /* Nav bar: softly rounded */
    --font-nav: 'Zen Maru Gothic', 'Barlow', -apple-system, BlinkMacSystemFont, sans-serif;
    /* only for code snippets: system monospace (no web font download) */
    --font-mono: ui-monospace, 'SF Mono', Menlo, Monaco, Consolas, monospace;
    /* Tags/chips site-wide: borderless tinted pills */
    --font-tag: 'Barlow Semi Condensed', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-brand: 'Doto', var(--font-mono);                  /* wordmark */
    --font-pixel: 'Micro 5', var(--font-mono);               /* eyebrow / kicker letters */
    --font-pixel-grid: 'Micro 5 Charted', var(--font-mono);  /* gridded layer underneath */

    --font-size-xs: 0.75rem;
    --font-size-sm: 0.875rem;
    --font-size-base: 1rem;
    --font-size-lg: 1.125rem;
    --font-size-xl: 1.25rem;
    --font-size-2xl: 1.5rem;
    --font-size-3xl: 1.875rem;
    --font-size-4xl: 2.25rem;

    --line-height-tight: 1.2;
    --line-height-normal: 1.6;
    --line-height-relaxed: 1.8;

    --space-1: 0.25rem; --space-2: 0.5rem; --space-3: 0.75rem; --space-4: 1rem;
    --space-5: 1.25rem; --space-6: 1.5rem; --space-8: 2rem; --space-12: 3rem;
    --space-16: 4rem; --space-24: 6rem;

    --shadow-sm: 0 1px 3px 0 rgba(15,23,42,0.10);
    --shadow-md: 0 4px 16px -2px rgba(15,23,42,0.14);
    --shadow-lg: 0 12px 40px -8px rgba(15,23,42,0.18);
    --shadow-glow-primary: 0 4px 20px -4px rgba(14,114,101,0.28);
    --shadow-glow-secondary: 0 4px 20px -4px rgba(21,94,117,0.28);
    --shadow-glow-accent: 0 4px 20px -4px rgba(26,107,69,0.28);

    --radius-sm: 0.2rem; --radius-md: 0.45rem; --radius-lg: 0.875rem; --radius-xl: 1.5rem;
  }

  .paper-grain {
    position: fixed; inset: 0; pointer-events: none; z-index: 9999; opacity: 0.028;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-repeat: repeat; background-size: 128px 128px;
  }

  html {
    font-family: var(--font-sans); font-size: 16px; line-height: var(--line-height-normal);
    color: var(--color-text); background-color: var(--color-background);
    -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; scroll-behavior: smooth;
  }

  body {
    min-height: 100vh; display: flex; flex-direction: column;
    /* Plain white so it matches the white background of the homepage illustration. */
    background-color: var(--color-background);
  }

  main {
    flex: 1; width: 100%; max-width: 1200px; margin: 0 auto;
    padding: var(--space-8) var(--space-6);
  }

  h1,h2,h3,h4,h5,h6 {
    font-family: var(--font-display); font-weight: 700; line-height: var(--line-height-tight);
    margin-bottom: var(--space-4); letter-spacing: -0.02em; color: var(--color-text);
  }
  h1 { font-size: var(--font-size-4xl); font-weight: 900; }
  h2 { font-size: var(--font-size-3xl); }
  h3 { font-size: var(--font-size-2xl); }
  h4 { font-size: var(--font-size-xl); }

  p { margin-bottom: var(--space-4); }

  a { color: var(--color-primary); text-decoration: none; transition: color 0.18s ease; }
  a:hover { color: var(--color-primary-dark); text-decoration: underline; text-underline-offset: 3px; }

  ul, ol { margin-left: var(--space-6); margin-bottom: var(--space-4); }

  code {
    font-family: var(--font-mono); font-size: var(--font-size-sm);
    background-color: var(--color-surface-raised); color: var(--color-primary);
    padding: 0.12em var(--space-2); border-radius: var(--radius-sm); border: 1px solid var(--color-border);
  }

  @media (max-width: 768px) {
    h1 { font-size: var(--font-size-3xl); }
    h2 { font-size: var(--font-size-2xl); }
    h3 { font-size: var(--font-size-xl); }
  }

  /* Homepage button language: near-square corners, soft navy offset shadow,
     press-down hover. */
  button, .button, .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2);
    padding: var(--space-3) var(--space-6); background: var(--color-primary); color: #fff;
    border: 2px solid transparent; border-radius: 3px;
    box-shadow: 3px 4px 8px var(--btn-shadow);
    font-family: var(--font-nav); font-size: var(--font-size-sm); font-weight: 700;
    letter-spacing: 0.01em; cursor: pointer; text-decoration: none; white-space: nowrap;
    transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.18s ease, color 0.18s ease;
  }
  button:hover, .button:hover, .btn:hover {
    background: #0B6358; color: #fff; text-decoration: none;
    transform: translate(1px, 2px); box-shadow: 2px 2px 4px var(--btn-shadow);
  }
  button:active, .button:active, .btn:active {
    transform: translate(2px, 3px); box-shadow: 0 0 1px var(--btn-shadow);
  }

  /* Light-teal "grid paper" secondary button, as on the homepage */
  .btn-secondary {
    background:
      linear-gradient(rgba(62, 168, 188, 0.09) 1px, transparent 1px) border-box,
      linear-gradient(90deg, rgba(62, 168, 188, 0.09) 1px, transparent 1px) border-box,
      var(--color-surface-teal) border-box;
    background-size: 6px 6px, 6px 6px;
    color: var(--color-nav);
  }
  .btn-secondary:hover { background-color: var(--color-surface-teal); color: var(--color-primary); }
  .btn-large { padding: var(--space-4) var(--space-8); font-size: var(--font-size-base); }

  /* Two-layer pixel type: mustard grid underneath, teal letters on top */
  .eyebrow, .kicker {
    display: grid; margin: 0; font-weight: 400; line-height: 1.2; letter-spacing: 0;
  }
  .eyebrow > span, .kicker > span { grid-area: 1 / 1; }
  .eyebrow .grid-layer, .kicker .grid-layer {
    font-family: var(--font-pixel-grid); color: var(--color-gold-dark);
  }
  .eyebrow .text-layer, .kicker .text-layer {
    font-family: var(--font-pixel); color: var(--color-primary);
  }

  /* Data/topic chips */
  .chip {
    display: inline-block; padding: 3px 9px; border-radius: 4px;
    background: var(--color-primary-glow); color: var(--color-primary);
    font-family: var(--font-tag); font-size: 0.82rem; font-weight: 600; line-height: 1.35; white-space: nowrap;
  }
  .chip-gold { background: var(--color-gold-glow); color: var(--color-gold-ink); }
  .chip-green { background: var(--color-accent-glow); color: var(--color-accent); }
  .chip-blue { background: var(--color-sky-glow); color: var(--color-sky-deep); }

  footer {
    background-color: var(--color-footer); color: #D6C9B8;
    padding: var(--space-12) var(--space-6) var(--space-8);
    margin-top: var(--space-16); position: relative; overflow: hidden;
  }
  footer::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-accent-light) 50%, var(--color-secondary-light) 100%);
  }

  .footer-inner { max-width: 1200px; margin: 0 auto; position: relative; z-index: 1; }
  .footer-top {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: var(--space-8); flex-wrap: wrap; padding-bottom: var(--space-6);
    margin-bottom: var(--space-6);
  }
  .footer-brand { display: flex; align-items: flex-start; gap: var(--space-4); }
  /* Round navy-grosgrain badge, like the main footer emblem */
  .footer-mark {
    display: grid; place-items: center; width: 72px; height: 72px; flex-shrink: 0; margin-top: -4px;
    font-family: var(--font-brand); font-variation-settings: 'ROND' 100;
    font-size: var(--font-size-xl); font-weight: 800; letter-spacing: 0; line-height: 1;
    color: var(--color-node-blue);
    border: 1px solid rgba(175, 229, 243, 0.35); border-radius: 50%;
    background: repeating-linear-gradient(
      to bottom,
      #3D5A80 0 1px,
      #31496A 1px 2.5px,
      #22374F 2.5px 3.5px
    );
  }
  /* Doto (round dots), matching the nav wordmark */
  .footer-title {
    display: block; font-family: var(--font-brand); font-variation-settings: 'ROND' 100;
    font-weight: 800; font-size: 1.125rem; color: #E2E8F0; letter-spacing: 0; margin-bottom: var(--space-1);
  }
  .footer-tagline { margin: 0; font-size: var(--font-size-sm); color: #A0B4C4; line-height: 1.35; max-width: 30ch; text-wrap: balance; }
  .footer-links { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); align-items: center; }
  .footer-links a { font-family: var(--font-nav); font-size: var(--font-size-sm); color: #A0B4C4; text-decoration: none; transition: color 0.15s ease; font-weight: 500; }
  .footer-links a:hover { color: var(--color-primary-light); text-decoration: none; }
  .footer-bottom { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); flex-wrap: wrap; }
  .footer-copy { font-size: var(--font-size-xs); color: #8BA4B8; margin: 0; font-family: var(--font-sans); }
  .footer-copy a { color: var(--color-primary-light); text-decoration: underline; text-underline-offset: 3px; }
  .footer-copy a:hover { color: #FFFFFF; text-decoration: underline; }
  .footer-tagline-bottom { font-size: var(--font-size-xs); color: #8BA4B8; margin: 0; font-family: var(--font-sans); }

  :focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; border-radius: var(--radius-sm); }
  @keyframes fadeUp { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:translateY(0); } }
  @keyframes fadeIn { from { opacity:0; } to { opacity:1; } }
</style>

<style>
  /* ── Navbar ──────────────────────────────────── */
  .navbar {
    font-family: var(--font-nav); /* links, drawer and CTA; the wordmark stays Doto */
    background: var(--color-nav); border-bottom: 2px solid rgba(31, 51, 73, 0.4);
    box-shadow: var(--shadow-md);
    position: sticky; top: 0; z-index: 1000;
    backdrop-filter: blur(16px) saturate(160%); -webkit-backdrop-filter: blur(16px) saturate(160%);
  }
  .nav-container {
    max-width: 1200px; margin: 0 auto; padding: 0 var(--space-6);
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); height: 64px;
  }

  /* Brand */
  .nav-brand { flex-shrink: 0; }
  .brand-link { display: flex; align-items: center; gap: var(--space-3); text-decoration: none; transition: opacity 0.15s ease; }
  .brand-link:hover { opacity: 0.8; text-decoration: none; }
  .brand-mark {
    font-family: var(--font-brand); font-variation-settings: 'ROND' 100;
    font-weight: 800; font-size: 1.1rem; letter-spacing: -0.02em;
    color: #FFFFFF; background: var(--color-primary); border: 1.5px solid var(--color-gold);
    padding: 0.2em 0.45em 0.18em;
    border-radius: 3px; line-height: 1; flex-shrink: 0;
  }
  /* Community name in Doto (round dots), white on the navy bar — same as the main wordmark. */
  .brand-name {
    font-family: var(--font-brand); font-variation-settings: 'ROND' 100;
    font-size: 0.8rem; font-weight: 800; color: #FFFFFF;
    letter-spacing: 0; line-height: 1.15;
  }
  .brand-location {
    font-family: var(--font-nav); font-size: 0.68rem; font-weight: 500; color: var(--color-teal-light);
    letter-spacing: 0.04em; text-transform: uppercase;
  }

  /* Desktop links */
  .nav-links { display: none; list-style: none; gap: var(--space-1); margin: 0; padding: 0; }
  @media (min-width: 768px) { .nav-links { display: flex; } }
  .nav-item { margin: 0; }
  .nav-link {
    display: inline-flex; align-items: center; padding: var(--space-2) var(--space-3);
    font-family: var(--font-nav);
    font-size: 0.95rem; font-weight: 500; color: #FFFFFF;
    border-radius: var(--radius-md); text-decoration: none; transition: background 0.15s ease, color 0.15s ease;
    white-space: nowrap; position: relative;
