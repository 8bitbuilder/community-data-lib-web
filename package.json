{
  "name": "@community-data-libraries/web",
  "version": "1.0.0",
  "description": "Community Data Libraries - A curated collection of data science resources and community-submitted materials",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "backend:dev": "node --experimental-sqlite backend/server.mjs",
    "sync:backend-yaml": "node scripts/sync-backend-yaml.mjs",
    "check:backend-yaml": "node scripts/check-backend-yaml-sync.mjs",
    "sync:catalog": "node scripts/sync-catalog-from-backend.mjs",
    "sync:map": "node scripts/build-map-markers.mjs",
    "backend:import": "node scripts/import-backend-sqlite.mjs",
    "backend:pipeline": "node scripts/run-backend-pipeline.mjs",
    "prebuild": "npm run sync:backend-yaml && npm run check:backend-yaml && npm run sync:catalog && npm run sync:map",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "validate:geo": "node scripts/validate-geojson.mjs",
    "validate:schema": "node scripts/validate-geojson.mjs",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.astro",
    "format": "prettier --write .",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:functions": "node --test \"netlify/**/*.test.mjs\" \"src/lib/editor/*.test.mjs\"",
    "check": "npm run lint && npm run validate:geo && npm test && npm run build",
    "geo:boundaries": "node scripts/build-geo-boundaries.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/community-data-libraries/web.git"
  },
  "keywords": [
    "data-science",
    "community",
    "library",
    "resources",
    "astro",
    "react"
  ],
  "author": "Community Data Libraries",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/community-data-libraries/web/issues"
  },
  "homepage": "https://github.com/community-data-libraries/web#readme",
  "dependencies": {
    "@astrojs/react": "^5.0.4",
    "@netlify/blobs": "^10.7.13",
    "adm-zip": "^0.5.16",
    "astro": "^6.1.9",
    "csv-parse": "^5.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@mapbox/geojsonhint": "^3.3.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "astro-eslint-parser": "^0.16.3",
    "autoprefixer": "^10.4.24",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-astro": "^0.34.0",
    "eslint-plugin-prettier": "^5.1.3",
    "mapshaper": "^0.6.121",
    "postcss": "^8.5.6",
    "prettier": "^3.2.5",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.1.18"
  }
}
